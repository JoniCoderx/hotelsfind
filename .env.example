# Affiliate IDs. Every one is optional: a partner with no ID still gets a
# working link, you just earn no commission on it.

# Booking.com Affiliate Partner Program: your "aid" number
PUBLIC_BOOKING_AID=
# Agoda Partners: your "cid" (site ID)
PUBLIC_AGODA_CID=
# Expedia Group Affiliate Program (Expedia + Hotels.com): your affiliate camref / affcid
PUBLIC_EXPEDIA_AFFCID=
PUBLIC_HOTELSCOM_AFFCID=
# Trip.com Affiliate: Allianceid and SID
PUBLIC_TRIP_ALLIANCE_ID=
PUBLIC_TRIP_SID=

# Canonical URL of the deployed site (used for sitemap, canonical tags, OG)
SITE_URL=https://hotelsfind.co.il
