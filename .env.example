# ── Agoda live prices (Agoda Partners → Tools → API) ─────────────────────
# Server-side secrets: never prefix these with PUBLIC_.
AGODA_SITE_ID=
AGODA_API_KEY=
# Optional: the endpoint your Agoda account manager gives you (https if enabled)
# AGODA_ENDPOINT=http://affiliateapi7643.agoda.com/affiliateservice/lt_v1
# Optional: city IDs without re-importing, e.g. {"eilat":12345,"tel-aviv":67890}
# AGODA_CITY_IDS=
# Local preview of the results UI with clearly-labelled sample data (dev only)
# AGODA_DEMO=1

# ── Travelpayouts (one account for Booking.com, Agoda and more) ──────────
# Generate one link in the Travelpayouts dashboard and copy its numbers:
# https://tp.media/r?marker=AAA&trs=BBB&p=CCC&u=...  →  MARKER=AAA, TRS=BBB, <BRAND>_P=CCC
# A brand with its _P set sends its links through Travelpayouts.
PUBLIC_TP_MARKER=
PUBLIC_TP_TRS=
PUBLIC_TP_BOOKING_P=
PUBLIC_TP_AGODA_P=
PUBLIC_TP_EXPEDIA_P=
PUBLIC_TP_HOTELSCOM_P=
PUBLIC_TP_TRIP_P=

# ── Direct affiliate IDs for the comparison links (all optional) ─────────
# Booking.com (via CJ): your affiliate "aid"
PUBLIC_BOOKING_AID=
# Agoda Partners: your "cid" (site ID) for links
PUBLIC_AGODA_CID=
# Expedia Group Affiliate Program
PUBLIC_EXPEDIA_AFFCID=
PUBLIC_HOTELSCOM_AFFCID=
# Trip.com Affiliate: Allianceid and SID
PUBLIC_TRIP_ALLIANCE_ID=
PUBLIC_TRIP_SID=

# Canonical URL of the deployed site (sitemap, canonical tags, OG)
SITE_URL=https://malonzol.com
