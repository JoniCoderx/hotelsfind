# links (default): no prices anywhere. live: call the configured providers (only with their approval).
PUBLIC_PRICE_MODE=links

# ── Agoda live prices (Agoda Partners → Tools → API) ─────────────────────
# Server-side secrets: never prefix these with PUBLIC_.
AGODA_SITE_ID=
AGODA_API_KEY=
# Optional: the endpoint your Agoda account manager gives you (https if enabled)
# AGODA_ENDPOINT=http://affiliateapi7643.agoda.com/affiliateservice/lt_v1
# Optional: city IDs without re-importing, e.g. {"eilat":12345,"tel-aviv":67890}
# AGODA_CITY_IDS=
# Local preview of the results UI with clearly-labelled sample data (dev only)
# AGODA_DEMO=1

# ── Comparison connectors (only with each provider's approval; see docs/data-sources.md) ──
# Agoda Search API 2.0 (MSE): endpoint from your account manager, plus AGODA_SITE_ID / AGODA_API_KEY above
# AGODA_SEARCH_ENDPOINT=
# Booking.com Demand API 3.2 (Managed Affiliate Partners)
# BOOKING_API_BASE=https://demandapi.booking.com/3.2
# BOOKING_API_TOKEN=
# BOOKING_AFFILIATE_ID=
# Vio.com Partners API (revenue-share agreement)
# VIO_PARTNER_KEY=
# Connectors whose price meaning (unit, whole stay, what's included) was confirmed with the provider AND checked
# against real answers and landing pages. Others are shown but never ranked or tagged "cheapest".
# PRICE_VERIFIED=agoda-search,booking-demand
# Booker location when Vercel's geo header is missing, and guest nationality (Agoda's userCountry).
# Both are assumptions for an Israeli audience; agree them with each provider.
# DEFAULT_BOOKER_COUNTRY=IL
# GUEST_NATIONALITY=IL
# Hotels compared are only those in src/data/hotel-map.json (see docs/hotel-mapping.md).

# ── Travelpayouts (one account for Booking.com, Agoda and more) ──────────
# Generate one link in the Travelpayouts dashboard and copy its numbers:
# https://tp.media/r?marker=AAA&trs=BBB&p=CCC&u=...  →  MARKER=AAA, TRS=BBB, <BRAND>_P=CCC
# A brand with its _P set sends its links through Travelpayouts.
PUBLIC_TP_MARKER=
PUBLIC_TP_TRS=
PUBLIC_TP_BOOKING_P=
PUBLIC_TP_AGODA_P=
PUBLIC_TP_EXPEDIA_P=
PUBLIC_TP_HOTELSCOM_P=
PUBLIC_TP_TRIP_P=
# The Drive script loads once PUBLIC_TP_MARKER is set. To verify the site in Travelpayouts before that, set on.
# PUBLIC_TP_DRIVE=on

# ── Direct affiliate IDs for the comparison links (all optional) ─────────
# Booking.com (via CJ): your affiliate "aid"
PUBLIC_BOOKING_AID=
# Agoda Partners: your "cid" (site ID) for links
PUBLIC_AGODA_CID=
# Expedia Group Affiliate Program
PUBLIC_EXPEDIA_AFFCID=
PUBLIC_HOTELSCOM_AFFCID=
# Trip.com Affiliate: Allianceid and SID
PUBLIC_TRIP_ALLIANCE_ID=
PUBLIC_TRIP_SID=

# Per-hotel pages (/hotel/...) are noindex and left out of the sitemap until Agoda
# approves using its catalog content on them in writing. Then set:
# INDEX_HOTEL_PAGES=1

# Canonical URL of the deployed site (sitemap, canonical tags, OG)
SITE_URL=https://malonzol.com
