---
interface Props { light?: boolean; size?: number }
const { light = false, size = 34 } = Astro.props;
const id = `rd${Math.random().toString(36).slice(2, 7)}`;
---
<span class:list={['logo', { light }]}>
  <svg class="mark" width={size} height={size} viewBox="0 0 34 34" aria-hidden="true">
    <defs>
      <linearGradient id={`${id}b`} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#1d6bff" />
        <stop offset="1" stop-color="#12b5a0" />
      </linearGradient>
      <linearGradient id={`${id}s`} x1="0.5" y1="0" x2="1" y2="0.6">
        <stop offset="0" stop-color="#fff" stop-opacity="0.9" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
    </defs>
    <circle cx="17" cy="17" r="17" fill={`url(#${id}b)`} />
    <circle cx="17" cy="17" r="11.5" fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="1.2" />
    <circle cx="17" cy="17" r="6" fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="1.2" />
    <path class="sweep" d="M17 17V3.5A13.5 13.5 0 0 1 28.7 10.25Z" fill={`url(#${id}s)`} />
    <circle class="blip" cx="23.5" cy="10.5" r="2" fill="#fff" />
    <circle cx="17" cy="17" r="1.8" fill="#fff" />
  </svg>
  <span class="word ltr">Stay<b>Radar</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
  }
  .light {
    color: #fff;
  }
  .word {
    font-size: 23px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .word b {
    font-weight: 700;
  }
  .sweep {
    transform-origin: 17px 17px;
    animation: sweep 4s linear infinite;
  }
  .blip {
    transform-origin: 23.5px 10.5px;
    animation: blip 4s ease-out infinite;
  }
  :global(a:hover) > .logo .sweep,
  .logo:hover .sweep {
    animation-duration: 1.1s;
  }
  :global(a:hover) > .logo .blip,
  .logo:hover .blip {
    animation-duration: 1.1s;
  }
  @keyframes sweep {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes blip {
    0%,
    10% {
      opacity: 0.1;
      transform: scale(0.6);
    }
    16% {
      opacity: 1;
      transform: scale(1.25);
    }
    40% {
      transform: scale(1);
    }
    100% {
      opacity: 0.1;
    }
  }
</style>
