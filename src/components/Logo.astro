---
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { light }]}>
  <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <mask id="moon-cut">
        <rect width="32" height="32" fill="#fff" />
        <circle cx="21" cy="11" r="11" fill="#000" />
      </mask>
    </defs>
    <circle cx="16" cy="16" r="15" fill="#ff5b2e" mask="url(#moon-cut)" />
    <circle cx="25.5" cy="6.5" r="2" fill="#ff5b2e" />
  </svg>
  <span class="word">לילה זול</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }
  .light {
    color: var(--paper);
  }
  .word {
    font-family: var(--display);
    font-weight: 700;
    font-size: 38px;
    line-height: 1;
    padding-top: 4px;
  }
</style>
