---
interface Props { light?: boolean; size?: number }
const { light = false, size = 34 } = Astro.props;
const id = `mz${Math.random().toString(36).slice(2, 7)}`;
---
<span class:list={['logo', { light }]}>
  <svg class="mark" width={size} height={size} viewBox="0 0 34 34" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#1d6bff" />
        <stop offset="1" stop-color="#12b5a0" />
      </linearGradient>
    </defs>
    <rect width="34" height="34" rx="11" fill={`url(#${id})`} />
    <!-- price tag -->
    <path
      d="M8 9.5A1.5 1.5 0 0 1 9.5 8h7.4c.4 0 .8.16 1.06.44l7.6 7.6a1.5 1.5 0 0 1 0 2.12l-7.4 7.4a1.5 1.5 0 0 1-2.12 0l-7.6-7.6A1.5 1.5 0 0 1 8 16.9Z"
      fill="#fff"
    />
    <circle cx="12.4" cy="12.4" r="1.7" fill={`url(#${id})`} />
    <g class="drop">
      <path d="M18.2 13.6v6.2m-2.6-2.6 2.6 2.6 2.6-2.6" fill="none" stroke={`url(#${id})`} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  </svg>
  <span class="word">מלונ<b>זול</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .light {
    color: #fff;
  }
  .word {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .word b {
    font-weight: 800;
    background: var(--fire-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  :global(a:hover) > .logo .drop,
  .logo:hover .drop {
    animation: drop 0.8s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  @keyframes drop {
    40% {
      transform: translateY(2.5px);
    }
    70% {
      transform: translateY(-0.5px);
    }
  }
</style>
