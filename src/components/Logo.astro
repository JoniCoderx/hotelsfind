---
interface Props { light?: boolean; size?: number }
const { light = false, size = 34 } = Astro.props;
const id = `hf${Math.random().toString(36).slice(2, 7)}`;
---
<span class:list={['logo', { light }]}>
  <svg class="mark" width={size} height={size} viewBox="0 0 34 34" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#1d6bff" />
        <stop offset="1" stop-color="#12b5a0" />
      </linearGradient>
    </defs>
    <rect width="34" height="34" rx="11" fill={`url(#${id})`} />
    <g class="glass">
      <circle cx="15" cy="15" r="7.6" fill="none" stroke="#fff" stroke-width="2.6" />
      <path d="M20.6 20.6 26 26" stroke="#fff" stroke-width="3.2" stroke-linecap="round" />
      <path d="M11.4 16.2 15 12.9l3.6 3.3v2.9h-7.2z" fill="#fff" />
    </g>
  </svg>
  <span class="word ltr">Hotel<b>Find</b><i>z</i></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
  }
  .light {
    color: #fff;
  }
  .word {
    font-size: 23px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .word b {
    font-weight: 700;
  }
  .word i {
    display: inline-block;
    font-style: normal;
    font-weight: 800;
    background: var(--fire-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform: rotate(-8deg) translateY(-1px);
    transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .glass {
    transform-origin: 15px 15px;
  }
  :global(a:hover) > .logo .glass,
  .logo:hover .glass {
    animation: seek 0.9s ease-in-out;
  }
  :global(a:hover) > .logo .word i,
  .logo:hover .word i {
    transform: rotate(8deg) translateY(-2px) scale(1.15);
  }
  @keyframes seek {
    25% {
      transform: translate(-1.5px, 1px) rotate(-8deg);
    }
    50% {
      transform: translate(1.5px, -1px) rotate(6deg);
    }
    75% {
      transform: translate(-1px, -0.5px) rotate(-3deg);
    }
  }
</style>
