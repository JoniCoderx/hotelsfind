---
interface Props { light?: boolean; size?: number }
const { light = false, size = 32 } = Astro.props;
const id = `rd${Math.random().toString(36).slice(2, 7)}`;
---
<span class:list={['logo', { light }]}>
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id={`${id}b`} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#0040ff" />
        <stop offset="0.55" stop-color="#0a7cff" />
        <stop offset="1" stop-color="#00c9a7" />
      </linearGradient>
      <linearGradient id={`${id}s`} x1="0.5" y1="0" x2="0.9" y2="0.5">
        <stop offset="0" stop-color="#fff" stop-opacity="0.85" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill={`url(#${id}b)`} />
    <g fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="1.2">
      <circle cx="16" cy="16" r="12" />
      <circle cx="16" cy="16" r="7.5" />
      <path d="M16 4v24M4 16h24" stroke-opacity="0.18" />
    </g>
    <path class="sweep" d="M16 16 16 4a12 12 0 0 1 10.4 6Z" fill={`url(#${id}s)`} />
    <circle class="blip" cx="21.5" cy="10.5" r="1.8" fill="#fff" />
    <circle cx="16" cy="16" r="1.6" fill="#fff" />
  </svg>
  <span class="word ltr">Stay<b>Radar</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .light {
    color: #fff;
  }
  .word {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .word b {
    font-weight: 900;
  }
  .sweep {
    transform-origin: 16px 16px;
    animation: sweep 3.2s linear infinite;
  }
  .blip {
    animation: blip 3.2s ease-out infinite;
  }
  @keyframes sweep {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes blip {
    0%,
    12% {
      opacity: 0.15;
    }
    18% {
      opacity: 1;
    }
    100% {
      opacity: 0.15;
    }
  }
</style>
