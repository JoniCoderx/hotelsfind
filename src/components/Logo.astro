---
interface Props { light?: boolean; size?: number }
const { light = false, size = 32 } = Astro.props;
const id = `fl${Math.random().toString(36).slice(2, 7)}`;
---
<span class:list={['logo', { light }]}>
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0.2" y1="1" x2="0.8" y2="0">
        <stop offset="0" stop-color="#ff2d55" />
        <stop offset="0.5" stop-color="#ff4a1c" />
        <stop offset="1" stop-color="#ff9f1c" />
      </linearGradient>
    </defs>
    <path
      fill={`url(#${id})`}
      d="M16 1.5c1.5 5 8.5 8 8.5 17 0 6.5-3.9 11.5-8.5 11.5S7.5 25.8 7.5 20c0-4.5 2.3-7.6 4.5-9.5.2 2.9 1.3 4.7 3 5.5-.6-5.5-1.2-10 1-14.5z"
    />
    <path
      fill="#ffd36b"
      d="M16 17c1.2 2.5 4 3.6 4 7 0 2.6-1.8 4.4-4 4.4s-4-1.8-4-4.2c0-2 1.2-3.2 2.2-4 .2 1.2.8 1.8 1.6 2.1-.4-1.9-.5-3.7.2-5.3z"
    />
  </svg>
  <span class="word"><b>אש</b> הוטלס</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
  }
  .light {
    color: #fff;
  }
  .word {
    font-size: 23px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .word b {
    font-weight: 900;
  }
</style>
