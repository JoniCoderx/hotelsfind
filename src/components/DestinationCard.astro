---
import Img from './Img.astro';
import type { Destination } from '../data/destinations';
import { destPhotos } from '../data/photos';
import { href } from '../lib/url';
interface Props { d: Destination; n?: number; tall?: boolean }
const { d, n, tall = false } = Astro.props;
const photo = destPhotos[d.slug];
---
<a href={href(`/destinations/${d.slug}/`)} class:list={['dc', 'reveal', { tall }]}>
  <div class="ph">
    {photo ? (
      <Img photo={photo} sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw" max={1200} />
    ) : (
      <div class="ph-fallback">
        <span>{d.he}</span>
      </div>
    )}
    {d.flight && <span class="tag">✈ {d.flight}</span>}
  </div>
  <div class="meta">
    {n !== undefined && <span class="num ltr">{String(n).padStart(2, '0')}</span>}
    <span>{d.country}</span>
  </div>
  <h3 class="display">{d.he}</h3>
  <p>{d.tagline}</p>
  <span class="go">למלונות ב{d.he} <span class="arrow">←</span></span>
</a>

<style>
  .dc {
    display: flex;
    flex-direction: column;
  }
  .ph {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    background: var(--paper-2);
    margin-bottom: 18px;
  }
  .tall .ph {
    aspect-ratio: 4 / 5;
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .dc:hover .ph :global(img) {
    transform: scale(1.06);
  }
  .ph-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--night);
    color: var(--moon);
    font-family: var(--display);
    font-size: 96px;
    font-weight: 700;
  }
  .tag {
    position: absolute;
    top: 14px;
    inset-inline-start: 14px;
    padding: 6px 12px;
    background: var(--paper);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
    border-radius: 3px;
  }
  .meta {
    display: flex;
    gap: 14px;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }
  .num {
    color: var(--accent);
    font-weight: 800;
  }
  h3 {
    font-size: clamp(56px, 5vw, 76px);
    margin: 10px 0 6px;
  }
  .tall h3 {
    font-size: clamp(64px, 6.5vw, 104px);
  }
  p {
    color: var(--ink-2);
    margin-bottom: 14px;
  }
  .go {
    margin-top: auto;
    font-weight: 800;
    font-size: 15px;
  }
  .dc:hover .go {
    color: var(--accent);
  }
</style>
