---
import Img from './Img.astro';
import type { Destination } from '../data/destinations';
import { destPhotos, hotel } from '../data/photos';
import { href } from '../lib/url';
interface Props { d: Destination; big?: boolean }
const { d, big = false } = Astro.props;
const photo = destPhotos[d.slug] ?? hotel.sunset;
---
<a href={href(`/destinations/${d.slug}/`)} class:list={['dc', 'reveal', { big }]}>
  <div class="ph">
    <Img photo={photo} sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw" max={1200} />
    {d.flight && <span class="tag">{d.flight} טיסה</span>}
  </div>
  <div class="txt">
    <h3>{d.he} <span class="go" aria-hidden="true">←</span></h3>
    <p>{d.tagline}</p>
  </div>
</a>

<style>
  .dc {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ph {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--soft);
  }
  .big .ph {
    aspect-ratio: auto;
    flex: 1;
    min-height: 260px;
  }
  .ph :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .dc:hover .ph :global(img) {
    transform: scale(1.05);
  }
  .tag {
    position: absolute;
    top: 12px;
    inset-inline-start: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
  }
  .txt {
    padding-inline: 4px;
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 21px;
    font-weight: 700;
    margin: 0 0 2px;
  }
  .big h3 {
    font-size: 26px;
  }
  .go {
    color: var(--fire);
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .dc:hover .go {
    opacity: 1;
    transform: none;
  }
  p {
    margin: 0;
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.45;
  }
</style>
