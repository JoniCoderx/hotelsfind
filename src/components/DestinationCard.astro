---
import Img from './Img.astro';
import type { Destination } from '../data/destinations';
import { destPhotos, hotel } from '../data/photos';
import { href } from '../lib/url';
interface Props { d: Destination; big?: boolean }
const { d, big = false } = Astro.props;
const photo = destPhotos[d.slug] ?? hotel.sunset;
---
<a href={href(`/destinations/${d.slug}/`)} class:list={['dc', 'reveal', { big }]}>
  <Img photo={photo} sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw" max={1200} />
  <div class="shade" aria-hidden="true"></div>
  {d.flight && <span class="tag">✈ {d.flight}</span>}
  <div class="txt">
    <h3>{d.he}</h3>
    <p>{d.tagline}</p>
  </div>
  <span class="go" aria-hidden="true">←</span>
</a>

<style>
  .dc {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--soft);
    color: #fff;
    isolation: isolate;
  }
  .big {
    aspect-ratio: auto;
    min-height: 100%;
  }
  .dc :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .dc:hover :global(img) {
    transform: scale(1.06);
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.1) 50%, transparent 70%);
  }
  .tag {
    position: absolute;
    top: 14px;
    inset-inline-start: 14px;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
  }
  .txt {
    position: absolute;
    inset-inline: 20px 64px;
    bottom: 18px;
  }
  h3 {
    font-size: clamp(26px, 2.4vw, 32px);
    font-weight: 900;
    margin: 0 0 4px;
  }
  .big h3 {
    font-size: clamp(32px, 3.6vw, 48px);
  }
  p {
    margin: 0;
    font-size: 15px;
    opacity: 0.88;
    line-height: 1.4;
  }
  .go {
    position: absolute;
    inset-inline-end: 18px;
    bottom: 20px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    font-weight: 900;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .dc:hover .go {
    background: var(--fire);
    color: #fff;
    transform: translateX(-4px);
  }
</style>
