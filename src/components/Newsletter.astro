---
// Newsletter sign-up, shown in the footer of every page. Posts to /api/subscribe, which saves the address
// and sends the welcome email. Before the mail service is set up (`ready` false) there is no form: it says plainly
// that sign-up isn't open and that no addresses are collected, and points to the Telegram channel.
import { href } from '../lib/url';
import { site } from '../data/site';

const { ready = true } = Astro.props as { ready?: boolean };
---
<section class="nl" aria-labelledby="nl-h">
  <div class="nl-txt">
    <p class="nl-kick">✉️ רשימת התפוצה של מלונזול{!ready && <span class="nl-soon">נפתחת בקרוב</span>}</p>
    <h2 id="nl-h">מלון במחיר טוב, <span>פעם בשבוע במייל</span></h2>
    <p class="nl-sub">כל שבוע כמה מלונות שבדקנו במחיר טוב מהרגיל, ומדריך אחד לפני שמזמינים. בלי הצפות, ואפשר להסיר בלחיצה.</p>
  </div>
  {ready ? (
  <form class="nl-form" novalidate data-ready="1" data-telegram={site.telegram}>
    <div class="nl-row">
      <label class="sr" for="nl-email">כתובת אימייל</label>
      <input id="nl-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="name@example.com" dir="ltr" required />
      <input class="hp" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit" class="btn nl-btn">הרשמה</button>
    </div>
    <p class="nl-legal">
      בהרשמה אתם מאשרים לקבל מאיתנו דיוור שיווקי (פרסומת) במייל. אפשר להסיר בכל רגע מכל מייל. פרטים ב<a href={href('/privacy/')}>מדיניות הפרטיות</a>.
    </p>
    <p class="nl-msg" role="status" aria-live="polite"></p>
  </form>
  ) : (
  <div class="nl-form nl-closed">
    <p class="nl-closed-t">ההרשמה עוד לא פתוחה, ואנחנו לא אוספים כתובות מייל בינתיים. הדילים עולים כבר עכשיו בערוץ הטלגרם.</p>
    <a class="btn nl-btn" href={site.telegram} target="_blank" rel="noopener">לערוץ הטלגרם</a>
  </div>
  )}
</section>

<script>
  const MSG: Record<string, string> = {
    ok: 'נרשמתם! 🎉 שלחנו לכם מייל קבלת פנים.',
    already: 'הכתובת הזאת כבר רשומה. תודה!',
    bad_email: 'נראה שיש טעות בכתובת. בדקו ונסו שוב.',
    too_many: 'רגע, יותר מדי ניסיונות. נסו שוב בעוד דקה.',
    error: 'משהו השתבש. נסו שוב בעוד רגע, או כתבו לנו ל-hello@malonzol.com.',
  };
  for (const form of document.querySelectorAll<HTMLFormElement>('form.nl-form')) {
    const msg = form.querySelector<HTMLElement>('.nl-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const show = (key: string, ok = false) => {
        msg.textContent = MSG[key] ?? MSG.error;
        msg.classList.toggle('ok', ok);
      };
      const email = String(data.get('email') ?? '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return show('bad_email');
      btn.disabled = true;
      btn.textContent = 'שולח…';
      try {
        const r = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website: data.get('website') }),
        });
        const body = await r.json().catch(() => ({}));
        if (r.ok) {
          show(body.already ? 'already' : 'ok', true);
          form.reset();
          (window as any).va?.('event', { name: 'newsletter_signup' });
        } else show(body.error);
      } catch {
        show('error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'הרשמה';
      }
    });
  }
</script>

<style>
  .nl {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
    padding: clamp(24px, 4vw, 40px);
    margin-bottom: 56px;
    border-radius: 28px;
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(18, 181, 160, 0.28) 0%, transparent 55%),
      radial-gradient(90% 120% at 0% 100%, rgba(255, 194, 46, 0.18) 0%, transparent 60%),
      #10204a;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .nl-soon {
    margin-inline-start: 8px;
    padding: 2px 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
  }
  .nl-kick {
    font-weight: 700;
    color: var(--sun);
    font-size: 14px;
    margin: 0 0 8px;
  }
  .nl h2 {
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
    color: #fff;
    margin: 0;
    text-wrap: balance;
  }
  .nl h2 span {
    color: #5ff0d8;
  }
  .nl-sub {
    color: #c3cbe0;
    margin: 10px 0 0;
    max-width: 46ch;
    text-wrap: pretty;
  }
  .nl-row {
    display: flex;
    gap: 10px;
    background: #fff;
    border-radius: 999px;
    padding: 6px;
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.6);
  }
  .nl-row input[type='email'] {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    padding: 10px 18px;
    text-align: left;
  }
  .nl-row:focus-within {
    box-shadow: 0 0 0 3px rgba(95, 240, 216, 0.6);
  }
  .nl-btn {
    background: var(--sun);
    color: var(--ink);
    border-radius: 999px;
    padding: 12px 26px;
    font-weight: 800;
    border: 0;
    cursor: pointer;
    white-space: nowrap;
  }
  .nl-btn:hover {
    filter: brightness(1.05);
  }
  .nl-btn:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  .nl-closed-t {
    margin: 0 0 14px;
    color: #dfe5f2;
    line-height: 1.55;
  }
  .nl-legal {
    font-size: 12.5px;
    color: #9aa5bb;
    margin: 12px 4px 0;
    line-height: 1.6;
  }
  .nl-legal a {
    color: #c3cbe0;
    text-decoration: underline;
  }
  .nl-msg {
    min-height: 1.4em;
    margin: 8px 4px 0;
    font-weight: 700;
    color: #ffb4ae;
  }
  .nl-msg.ok {
    color: #5ff0d8;
  }
  .nl-msg :global(a) {
    color: #fff;
    text-decoration: underline;
  }
  /* Off-screen by clipping, not by a far offset: in a right-to-left page a far offset widens the page. */
  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    opacity: 0;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 820px) {
    .nl {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .nl-row {
      flex-direction: column;
      border-radius: 22px;
    }
    .nl-row input[type='email'] {
      padding: 12px 14px;
      text-align: center;
    }
    .nl-btn {
      width: 100%;
    }
  }
</style>
