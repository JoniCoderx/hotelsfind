---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((it) => (
    <details>
      <summary>
        <span>{it.q}</span>
        <i aria-hidden="true"></i>
      </summary>
      <p>{it.a}</p>
    </details>
  ))}
</div>

<style>
  .faq {
    border-top: 1.5px solid var(--ink);
  }
  details {
    border-bottom: 1px solid var(--line-strong);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 0;
    font-weight: 800;
    font-size: clamp(18px, 1.6vw, 22px);
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--accent);
  }
  i {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
  }
  i::before,
  i::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 18px;
    height: 2.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 0.3s;
  }
  i::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] i::after {
    transform: translate(-50%, -50%) rotate(0);
  }
  p {
    padding: 0 0 26px;
    margin: 0;
    max-width: 70ch;
    color: var(--ink-2);
  }
</style>
