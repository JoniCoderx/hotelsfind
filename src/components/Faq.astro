---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((it) => (
    <details class="reveal">
      <summary>
        <span>{it.q}</span>
        <i aria-hidden="true"></i>
      </summary>
      <p>{it.a}</p>
    </details>
  ))}
</div>

<style>
  .faq {
    display: grid;
    gap: 12px;
  }
  details {
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface);
    transition: background 0.3s, border-color 0.3s;
  }
  details[open] {
    background: var(--surface-2);
    border-color: var(--border-strong);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 26px;
    font-weight: 700;
    font-size: 18px;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  i {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
  }
  i::before,
  i::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 12px;
    height: 2px;
    background: var(--text);
    transform: translate(-50%, -50%);
    transition: transform 0.3s;
  }
  i::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] i::after {
    transform: translate(-50%, -50%) rotate(0);
  }
  p {
    padding: 0 26px 22px;
    margin: 0;
    color: var(--muted);
  }
</style>
