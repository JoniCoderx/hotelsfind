---
import { destinations } from '../data/destinations';
import { href } from '../lib/url';

interface Props {
  /** Pre-fill the destination (destination pages). */
  presetSlug?: string;
  /** Where the form submits; the comparison page uses /compare/. */
  action?: string;
}
const { presetSlug, action = '/search/' } = Astro.props;
const preset = destinations.find((d) => d.slug === presetSlug);
const options = destinations.map((d) => ({ he: d.he, en: d.en, country: d.country, slug: d.slug }));
---
<form
  class="sf"
  action={href(action)}
  method="get"
  role="search"
  data-options={JSON.stringify(options)}
>
  <div class="field dest">
    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.4" /></svg>
    <div class="fx">
      <label for="sf-q">לאן נוסעים?</label>
      <input
        id="sf-q"
        name="d"
        type="text"
        autocomplete="off"
        placeholder="עיר, אזור או מלון"
        value={preset?.he ?? ''}
        required
        role="combobox"
        aria-expanded="false"
        aria-controls="sf-list"
        aria-autocomplete="list"
      />
    </div>
    <input type="hidden" name="q" value={preset?.en ?? ''} />
    <input type="hidden" name="slug" value={preset?.slug ?? ''} />
    <ul id="sf-list" class="sf-list" role="listbox" hidden></ul>
  </div>

  <div class="field dates">
    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
    <div class="fx">
      <span class="lbl" id="sf-dl">תאריכים<span class="d-n"></span></span>
      <button type="button" class="dv d-btn" id="sf-dv" aria-haspopup="dialog" aria-expanded="false" aria-controls="sf-cal" aria-labelledby="sf-dl sf-dv"></button>
    </div>
    <input type="hidden" id="sf-in" name="in" />
    <input type="hidden" id="sf-out" name="out" />
  </div>
  <div id="sf-cal" class="d-pop" role="dialog" aria-label="בחירת תאריכים" hidden>
    <div class="d-top">
      <b>מתי נוסעים?</b>
      <button type="button" class="d-x" aria-label="סגירה">×</button>
    </div>
    <div class="d-wk" aria-hidden="true">{['א׳', 'ב׳', 'ג׳', 'ד׳', 'ה׳', 'ו׳', 'ש׳'].map((d) => <span>{d}</span>)}</div>
    <button type="button" class="d-nav d-prev" aria-label="החודש הקודם"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg></button>
    <button type="button" class="d-nav d-next" aria-label="החודש הבא"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg></button>
    <div class="d-months"></div>
    <div class="d-foot">
      <div class="d-presets" role="group" aria-label="בחירה מהירה">
        <button type="button" data-preset="weekend">סופ״ש הקרוב</button>
        <button type="button" data-preset="weekend2">סופ״ש הבא</button>
        <button type="button" data-preset="week">שבוע, מיום א׳</button>
      </div>
      <div class="d-bar">
        <span class="d-sum" aria-live="polite"></span>
        <button type="button" class="btn btn-fire d-ok">בחירה</button>
      </div>
    </div>
  </div>

  <div class="field guests">
    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.4" /><path d="M2.8 19.5c.6-3.4 3.2-5.3 6.2-5.3s5.6 1.9 6.2 5.3" /><path d="M15.5 4.9a3.2 3.2 0 0 1 0 6.2M18 14.6c1.8.7 3 2.4 3.3 4.9" /></svg>
    <div class="fx">
      <label for="sf-g">אורחים</label>
      <button id="sf-g" type="button" class="g-btn" aria-expanded="false" aria-controls="sf-pop">
        <span class="g-sum">2 מבוגרים · חדר אחד</span>
      </button>
    </div>
    <div id="sf-pop" class="g-pop" hidden>
      {[
        { n: 'a', label: 'מבוגרים', sub: 'גיל 18+', v: 2, min: 1, max: 16 },
        { n: 'c', label: 'ילדים', sub: 'גיל 0–17', v: 0, min: 0, max: 10 },
        { n: 'r', label: 'חדרים', sub: '', v: 1, min: 1, max: 8 },
      ].map((s) => (
        <div class="step">
          <div>
            <b>{s.label}</b>
            {s.sub && <small>{s.sub}</small>}
          </div>
          <div class="step-ctl">
            <button type="button" data-step={s.n} data-d="-1" aria-label={`הפחת ${s.label}`}>−</button>
            <output data-out={s.n}>{s.v}</output>
            <button type="button" data-step={s.n} data-d="1" aria-label={`הוסף ${s.label}`}>+</button>
          </div>
          <input type="hidden" name={s.n} value={s.v} data-min={s.min} data-max={s.max} />
        </div>
      ))}
      <div class="ages" id="sf-ages" hidden>
        <p>בחרו את הגיל של כל ילד ביום הצ׳ק-אאוט. המחיר תלוי בזה.</p>
        <div class="ages-in"></div>
      </div>
      <p class="rooms-note" hidden>מחירים חיים מוצגים כרגע לחדר אחד בלבד. ליותר חדרים נפתח לכם את אותו חיפוש באתרי ההזמנות.</p>
      <button type="button" class="btn btn-fire g-done">סיום</button>
    </div>
  </div>

  <button type="submit" class="btn btn-fire go">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.6" fill="none"/><path d="m20 20-3.6-3.6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
    חיפוש
  </button>
</form>

<style>
  .rooms-note {
    margin: 4px 0 10px;
    padding: 8px 12px;
    border-radius: 10px;
    background: #fff4d6;
    color: var(--sun-ink);
    font-size: 14px;
    line-height: 1.45;
  }
  .rooms-note[hidden] {
    display: none;
  }
  /* A teal frame holding white fields, one strong blue button. */
  .sf {
    position: relative;
    display: grid;
    grid-template-columns: 1.45fr 1.55fr 1.1fr auto;
    gap: 4px;
    padding: 5px;
    background: var(--frame);
    color: var(--ink);
    border-radius: 22px;
    box-shadow: 0 18px 40px -18px rgba(6, 30, 110, 0.45);
    text-align: start;
  }
  .field {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    min-height: 62px;
    padding: 8px 14px;
    background: #fff;
    border-radius: 16px;
    cursor: pointer;
    transition: box-shadow 0.15s;
  }
  .field:hover {
    box-shadow: inset 0 0 0 1.5px #c9d6f2;
  }
  .field:focus-within {
    box-shadow: inset 0 0 0 2px var(--fire);
  }
  .ic {
    flex: none;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dest .ic circle {
    fill: var(--ink-2);
    stroke: none;
  }
  .fx {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  label,
  .lbl {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted);
    line-height: 1.2;
    cursor: pointer;
  }
  input[type='text'],
  .g-btn,
  .dv {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 16.5px;
    font-weight: 700;
    padding: 0;
    outline: none;
    text-align: start;
    cursor: pointer;
    line-height: 1.4;
  }
  input[type='text'] {
    cursor: text;
  }
  .g-btn,
  .dv {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  input::placeholder {
    color: #9aa3b2;
    font-weight: 500;
  }
  .go {
    height: auto;
    min-height: 62px;
    padding-inline: 30px;
    border-radius: 16px;
    font-size: 18px;
    font-weight: 700;
  }

  .sf-list {
    position: absolute;
    inset-inline-start: 0;
    top: calc(100% + 10px);
    z-index: 30;
    width: min(420px, 92vw);
    margin: 0;
    padding: 8px;
    list-style: none;
    max-height: 380px;
    overflow: auto;
    background: #fff;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    cursor: default;
  }
  .sf-list :global(li) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 12px;
    cursor: pointer;
    font-weight: 600;
  }
  .sf-list :global(li::before) {
    content: '';
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 10px;
    background: var(--soft)
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z' fill='none' stroke='%231d6bff' stroke-width='1.8'/><circle cx='12' cy='9.5' r='2.4' fill='%231d6bff'/></svg>")
      center / 18px no-repeat;
  }
  .sf-list :global(li small) {
    display: block;
    color: var(--muted);
    font-weight: 400;
  }
  .sf-list :global(li[aria-selected='true']),
  .sf-list :global(li:hover) {
    background: var(--soft);
  }

  .g-pop {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 10px);
    z-index: 30;
    width: 320px;
    padding: 20px;
    display: grid;
    gap: 16px;
    background: #fff;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    cursor: default;
  }
  .g-pop[hidden] {
    display: none;
  }
  .step {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .step small {
    display: block;
    color: var(--muted);
    font-size: 13px;
  }
  .step-ctl {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .step-ctl button {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1.5px solid var(--fire);
    background: #fff;
    color: var(--fire);
    font-size: 20px;
    font-weight: 600;
    cursor: pointer;
  }
  .step-ctl button:hover {
    background: var(--warm);
  }
  output {
    min-width: 20px;
    text-align: center;
    font-weight: 700;
  }
  .g-done {
    height: 46px;
    border-radius: 12px;
  }
  .ages p {
    margin: 0 0 8px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .ages-in {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .ages-in :global(label) {
    display: grid;
    gap: 2px;
    font-size: 12.5px;
  }
  .ages-in :global(select) {
    font: inherit;
    font-size: 16px;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--ink);
  }
  .ages-in :global(select:invalid) {
    border-color: #f2a33a;
  }

  @media (max-width: 960px) {
    .sf {
      grid-template-columns: 1fr;
    }
    .field {
      min-height: 58px;
    }
    .go {
      min-height: 54px;
    }
    .g-pop {
      inset-inline: 0;
      width: auto;
    }
  }
  .d-n {
    margin-inline-start: 6px;
    color: var(--fire);
  }
  .d-btn {
    display: block;
  }

  /* Date range picker: two months side by side; a full-screen sheet on phones. */
  .d-pop {
    position: absolute;
    top: calc(100% + 10px);
    inset-inline: 0;
    z-index: 40;
    width: min(760px, 100%);
    margin-inline: auto;
    padding: 20px 22px 16px;
    background: #fff;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    cursor: default;
  }
  .d-pop[hidden] {
    display: none;
  }
  .d-top,
  .d-wk {
    display: none;
  }
  .d-nav {
    position: absolute;
    top: 16px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .d-nav:hover {
    background: var(--soft);
  }
  .d-nav:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .d-nav svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .d-prev {
    inset-inline-start: 18px;
  }
  .d-next {
    inset-inline-end: 18px;
  }
  .d-months {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 34px;
  }
  .d-months :global(.d-m h3) {
    margin: 6px 0 12px;
    text-align: center;
    font-size: 17px;
  }
  .d-months :global(.d-grid) {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    row-gap: 2px;
  }
  .d-months :global(.d-h) {
    padding-bottom: 6px;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .d-months :global(.d-d) {
    position: relative;
    height: 42px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }
  .d-months :global(.d-d span) {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin: auto;
    border-radius: 12px;
  }
  .d-months :global(.d-d:hover:not(:disabled) span) {
    box-shadow: inset 0 0 0 2px var(--fire);
  }
  .d-months :global(.d-d:disabled) {
    color: #c3c9d4;
    cursor: default;
  }
  .d-months :global(.d-d.today span) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* The band between check-in and check-out. */
  .d-months :global(.d-d.in::before),
  .d-months :global(.d-d.s.has-e::before),
  .d-months :global(.d-d.e::before) {
    content: '';
    position: absolute;
    inset-block: 1px;
    inset-inline: 0;
    background: #e3ecff;
  }
  .d-months :global(.d-d.s.has-e::before) {
    inset-inline-start: 50%;
  }
  .d-months :global(.d-d.e::before) {
    inset-inline-end: 50%;
  }
  .d-months :global(.d-d.s span),
  .d-months :global(.d-d.e span) {
    background: var(--fire);
    color: #fff;
  }
  .d-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .d-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .d-presets button {
    padding: 8px 14px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }
  .d-presets button:hover {
    border-color: var(--fire);
    color: var(--fire);
  }
  .d-bar {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .d-sum {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .d-ok {
    min-height: 44px;
    padding-inline: 26px;
    border-radius: 12px;
  }
  .d-ok:disabled {
    opacity: 0.45;
    cursor: default;
  }

  @media (max-width: 640px) {
    .d-pop {
      position: fixed;
      inset: 0;
      z-index: 1000;
      width: auto;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      border: 0;
      border-radius: 0;
    }
    .d-pop[hidden] {
      display: none;
    }
    .d-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      font-size: 18px;
    }
    .d-x {
      width: 40px;
      height: 40px;
      border: 0;
      border-radius: 50%;
      background: var(--soft);
      font-size: 24px;
      line-height: 1;
      color: var(--ink);
      cursor: pointer;
    }
    .d-wk {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      padding: 8px 14px;
      border-bottom: 1px solid var(--line);
      text-align: center;
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
    }
    .d-nav {
      display: none;
    }
    .d-months {
      flex: 1;
      overflow-y: auto;
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 8px 14px 20px;
      overscroll-behavior: contain;
    }
    .d-months :global(.d-m h3) {
      margin: 14px 0 8px;
      text-align: start;
    }
    .d-months :global(.d-h) {
      display: none;
    }
    .d-months :global(.d-d) {
      height: 46px;
    }
    .d-foot {
      margin: 0;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      box-shadow: 0 -6px 20px rgba(18, 24, 38, 0.06);
    }
    .d-presets {
      flex-wrap: nowrap;
      overflow-x: auto;
      width: 100%;
    }
    .d-presets button {
      flex: none;
    }
    .d-bar {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

<script>
  import { adultsHe, kidsHe, roomsHe } from '../lib/he';
  import { pageLive } from '../lib/pagemode';
  type Opt = { he: string; en: string; country: string; slug: string };


  document.querySelectorAll<HTMLFormElement>('form.sf').forEach((form) => {
    const options: Opt[] = JSON.parse(form.dataset.options || '[]');
    const input = form.querySelector<HTMLInputElement>('#sf-q')!;
    const hidden = form.querySelector<HTMLInputElement>('input[name="q"]')!;
    const slugIn = form.querySelector<HTMLInputElement>('input[name="slug"]')!;
    const list = form.querySelector<HTMLUListElement>('#sf-list')!;
    const din = form.querySelector<HTMLInputElement>('#sf-in')!;
    const dout = form.querySelector<HTMLInputElement>('#sf-out')!;
    let active = -1;
    let shown: Opt[] = [];

    // Restore a previous search: from the URL on /search, otherwise from the last search in this tab,
    // so going back or opening a destination page keeps the dates and guests.
    const KEY = 'mz-last-search';
    let params = new URLSearchParams(location.search);
    if (!params.has('in') && !params.has('a')) {
      try {
        const saved = new URLSearchParams(sessionStorage.getItem(KEY) || '');
        // A destination page keeps its own destination; only the dates and guests carry over.
        if (input.value) for (const k of ['d', 'q', 'slug']) saved.delete(k);
        params = saved;
      } catch {}
    }
    if (params.get('d')) {
      input.value = params.get('d')!;
      hidden.value = params.get('q') || '';
      slugIn.value = params.get('slug') || '';
    }
    // ---------- dates: one range picker, two months side by side (a scrolling sheet on phones) ----------
    const pad = (n: number) => String(n).padStart(2, '0');
    const now = new Date();
    const todayIso = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    const dateRe = /^\d{4}-\d{2}-\d{2}$/;
    const utc = (s: string) => new Date(s + 'T00:00:00Z');
    const addIso = (s: string, n: number) => new Date(utc(s).getTime() + n * 86_400_000).toISOString().slice(0, 10);
    const nightsOf = (a: string, b: string) => Math.round((utc(b).getTime() - utc(a).getTime()) / 86_400_000);
    const MAX_NIGHTS = 30;
    const lastDay = addIso(todayIso, 500);
    if (dateRe.test(params.get('in') || '') && dateRe.test(params.get('out') || '') && params.get('in')! >= todayIso && params.get('out')! > params.get('in')!) {
      din.value = params.get('in')!;
      dout.value = params.get('out')!;
    }
    // Default: the Thursday-to-Saturday weekend about two weeks out.
    if (!din.value) {
      const thu = addIso(todayIso, 14 + ((4 - utc(todayIso).getUTCDay() + 7) % 7));
      din.value = thu;
      dout.value = addIso(thu, 2);
    }

    const dayFmt = new Intl.DateTimeFormat('he-IL', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
    const shortFmt = new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'short', timeZone: 'UTC' });
    const longFmt = new Intl.DateTimeFormat('he-IL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
    const monthFmt = new Intl.DateTimeFormat('he-IL', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    const nightsHe = (n: number) => (n === 1 ? 'לילה אחד' : `${n} לילות`);

    const dField = form.querySelector<HTMLElement>('.dates')!;
    const dBtn = form.querySelector<HTMLButtonElement>('.d-btn')!;
    const dN = form.querySelector<HTMLElement>('.d-n')!;
    const cal = form.querySelector<HTMLElement>('.d-pop')!;
    const months = cal.querySelector<HTMLElement>('.d-months')!;
    const dSum = cal.querySelector<HTMLElement>('.d-sum')!;
    const dOk = cal.querySelector<HTMLButtonElement>('.d-ok')!;
    const prevBtn = cal.querySelector<HTMLButtonElement>('.d-prev')!;
    const nextBtn = cal.querySelector<HTMLButtonElement>('.d-next')!;
    const phone = matchMedia('(max-width: 640px)');

    // While the picker is open the choice lives here; the form's inputs change only on a complete range.
    let start = din.value;
    let end = dout.value;
    let hover = '';
    let view = start.slice(0, 7); // first month shown, YYYY-MM

    const paintField = () => {
      dBtn.textContent = `${dayFmt.format(utc(din.value))} – ${dayFmt.format(utc(dout.value))}`;
      dN.textContent = ` · ${nightsHe(nightsOf(din.value, dout.value))}`;
    };

    const monthAdd = (ym: string, n: number) => {
      const d = new Date(Date.UTC(Number(ym.slice(0, 4)), Number(ym.slice(5, 7)) - 1 + n, 1));
      return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}`;
    };

    function monthHtml(ym: string) {
      const first = utc(`${ym}-01`);
      const days = new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth() + 1, 0)).getUTCDate();
      const lead = first.getUTCDay(); // Sunday first, as Israeli calendars are
      const to = end || (hover && hover > start && nightsOf(start, hover) <= MAX_NIGHTS ? hover : '');
      const heads = ['א׳', 'ב׳', 'ג׳', 'ד׳', 'ה׳', 'ו׳', 'ש׳'].map((h) => `<span class="d-h">${h}</span>`).join('');
      let cells = '<span></span>'.repeat(lead);
      for (let i = 1; i <= days; i++) {
        const d = `${ym}-${pad(i)}`;
        const off = d < todayIso || d > lastDay || (!end && start && d > start && nightsOf(start, d) > MAX_NIGHTS);
        const cls = [
          d === todayIso ? 'today' : '',
          d === start ? 's' : '',
          d === start && to ? 'has-e' : '',
          to && d === to ? 'e' : '',
          to && d > start && d < to ? 'in' : '',
        ].filter(Boolean).join(' ');
        const label = `${longFmt.format(utc(d))}${d === start ? ', צ׳ק-אין' : ''}${d === end ? ', צ׳ק-אאוט' : ''}`;
        cells += `<button type="button" class="d-d ${cls}" data-d="${d}" aria-label="${label}"${d === start || d === end ? ' aria-pressed="true"' : ''}${off ? ' disabled' : ''}><span>${i}</span></button>`;
      }
      return `<div class="d-m"><h3>${monthFmt.format(first)}</h3><div class="d-grid">${heads}${cells}</div></div>`;
    }

    function drawCal() {
      const count = phone.matches ? 13 : 2;
      const from = phone.matches ? todayIso.slice(0, 7) : view;
      months.innerHTML = Array.from({ length: count }, (_, i) => monthHtml(monthAdd(from, i))).join('');
      prevBtn.disabled = view <= todayIso.slice(0, 7);
      nextBtn.disabled = monthAdd(view, 1) >= lastDay.slice(0, 7);
      dSum.textContent = start && end
        ? `${shortFmt.format(utc(start))} – ${shortFmt.format(utc(end))} · ${nightsHe(nightsOf(start, end))}`
        : start
          ? 'עכשיו בחרו את יום הצ׳ק-אאוט'
          : 'בחרו את יום הצ׳ק-אין';
      dOk.disabled = !(start && end);
    }

    const openCal = () => {
      start = din.value;
      end = dout.value;
      hover = '';
      view = start.slice(0, 7);
      drawCal();
      cal.hidden = false;
      dBtn.setAttribute('aria-expanded', 'true');
      // Keep the calendar inside the window, whatever the page around the form does.
      cal.style.transform = '';
      if (!phone.matches) {
        const r = cal.getBoundingClientRect();
        const shift = r.left < 12 ? 12 - r.left : r.right > innerWidth - 12 ? innerWidth - 12 - r.right : 0;
        if (shift) cal.style.transform = `translateX(${shift}px)`;
      }
      form.querySelector<HTMLElement>('.g-pop')!.hidden = true; // one popover at a time
      if (phone.matches) {
        // A full-screen sheet: lift it out of the page's stacking contexts so the site header can't cover it.
        document.body.appendChild(cal);
        document.documentElement.style.overflow = 'hidden';
        // Bring the check-in month into view.
        requestAnimationFrame(() => months.querySelector('.d-d.s')?.closest('.d-m')?.scrollIntoView({ block: 'start' }));
      }
    };
    const closeCal = (commit: boolean) => {
      if (commit && start && end) {
        din.value = start;
        dout.value = end;
        paintField();
      }
      cal.hidden = true;
      if (cal.parentElement !== form) form.appendChild(cal);
      dBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    };

    dField.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.d-pop')) (cal.hidden ? openCal : () => closeCal(true))();
    });
    months.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.d-d');
      if (!b || b.disabled) return;
      const d = b.dataset.d!;
      if (!start || end || d <= start) {
        start = d;
        end = '';
      } else {
        end = d;
      }
      drawCal();
      // On wide screens a complete range is the whole job; phones confirm with the button.
      if (start && end && !phone.matches) setTimeout(() => closeCal(true), 180);
    });
    months.addEventListener('mouseover', (e) => {
      if (!start || end) return;
      const d = (e.target as HTMLElement).closest<HTMLElement>('.d-d')?.dataset.d || '';
      if (d !== hover) {
        hover = d;
        drawCal();
      }
    });
    prevBtn.addEventListener('click', () => {
      view = monthAdd(view, -1);
      drawCal();
    });
    nextBtn.addEventListener('click', () => {
      view = monthAdd(view, 1);
      drawCal();
    });
    dOk.addEventListener('click', () => closeCal(true));
    cal.querySelector('.d-x')!.addEventListener('click', () => closeCal(false));
    cal.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        const dow = utc(todayIso).getUTCDay();
        if (b.dataset.preset === 'week') {
          start = addIso(todayIso, 7 - dow || 7); // next Sunday
          end = addIso(start, 5); // to Friday
        } else {
          // Thursday to Saturday: this coming Thursday, or today when it is Thursday.
          const thu = addIso(todayIso, (4 - dow + 7) % 7);
          start = b.dataset.preset === 'weekend2' ? addIso(thu, 7) : thu;
          end = addIso(start, 2);
        }
        view = start.slice(0, 7);
        drawCal();
        if (!phone.matches) setTimeout(() => closeCal(true), 180);
      }),
    );
    document.addEventListener('click', (e) => {
      // The path is taken at dispatch: a day button is re-rendered (detached) by the time this runs.
      const path = e.composedPath();
      if (!cal.hidden && !phone.matches && !path.includes(cal) && !path.includes(dField)) closeCal(true);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !cal.hidden) {
        closeCal(false);
        dBtn.focus();
      }
    });
    phone.addEventListener('change', () => !cal.hidden && drawCal());
    paintField();
    form.querySelector<HTMLElement>('.dest')!.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.sf-list')) input.focus();
    });

    // Destination combobox.
    const render = () => {
      const t = input.value.trim().toLowerCase();
      shown = options
        .filter((o) => !t || o.he.includes(t) || o.en.toLowerCase().includes(t) || o.country.includes(t))
        .slice(0, 8);
      list.innerHTML = shown
        .map(
          (o, i) =>
            `<li role="option" id="sf-o${i}" aria-selected="${i === active}" data-i="${i}"><span>${o.he}<small>${o.country}</small></span></li>`,
        )
        .join('');
      const open = shown.length > 0 && document.activeElement === input;
      list.hidden = !open;
      input.setAttribute('aria-expanded', String(open));
      input.setAttribute('aria-activedescendant', active >= 0 ? `sf-o${active}` : '');
    };
    const pick = (o: Opt) => {
      input.value = o.he;
      hidden.value = o.en;
      slugIn.value = o.slug;
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
    };
    input.addEventListener('focus', render);
    input.addEventListener('input', () => {
      hidden.value = '';
      slugIn.value = '';
      active = -1;
      render();
    });
    input.addEventListener('keydown', (e) => {
      if (list.hidden) return;
      if (e.key === 'ArrowDown') active = Math.min(active + 1, shown.length - 1);
      else if (e.key === 'ArrowUp') active = Math.max(active - 1, 0);
      else if (e.key === 'Enter' && active >= 0) {
        e.preventDefault();
        pick(shown[active]);
        return;
      } else if (e.key === 'Escape') {
        list.hidden = true;
        return;
      } else return;
      e.preventDefault();
      render();
    });
    list.addEventListener('mousedown', (e) => {
      const li = (e.target as HTMLElement).closest('li');
      if (li) {
        e.preventDefault();
        pick(shown[Number(li.dataset.i)]);
      }
    });
    input.addEventListener('blur', () => setTimeout(() => (list.hidden = true), 120));

    // Guests popover.
    const gBtn = form.querySelector<HTMLButtonElement>('.g-btn')!;
    const pop = form.querySelector<HTMLDivElement>('.g-pop')!;
    const sum = form.querySelector<HTMLSpanElement>('.g-sum')!;
    const val = (n: string) => Number(form.querySelector<HTMLInputElement>(`input[name="${n}"]`)!.value);
    const summary = () => {
      const a = val('a'), c = val('c'), r = val('r');
      sum.textContent =
        adultsHe(a) + (c ? ` · ${kidsHe(c)}` : '') + ` · ${roomsHe(r)}`;
      // Said before the search, not as a dead end after it.
      form.querySelector<HTMLElement>('.rooms-note')!.hidden = !(r > 1 && pageLive());
    };
    const toggle = (open: boolean) => {
      if (open && !cal.hidden) closeCal(true);
      pop.hidden = !open;
      gBtn.setAttribute('aria-expanded', String(open));
    };
    gBtn.addEventListener('click', () => toggle(pop.hidden));
    form.querySelector<HTMLElement>('.guests')!.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (!t.closest('.g-pop') && !t.closest('.g-btn')) toggle(pop.hidden);
    });
    form.querySelector('.g-done')!.addEventListener('click', () => toggle(false));
    document.addEventListener('click', (e) => {
      if (!pop.hidden && !(e.target as HTMLElement).closest('.guests')) toggle(false);
    });
    // One age picker per child; Agoda and Booking both price children by age.
    const agesBox = form.querySelector<HTMLDivElement>('.ages')!;
    const agesIn = agesBox.querySelector<HTMLDivElement>('.ages-in')!;
    const startAges = params.getAll('ca');
    const renderAges = () => {
      const keep = [...agesIn.querySelectorAll('select')].map((x) => x.value);
      const n = val('c');
      agesIn.innerHTML = Array.from({ length: n }, (_, i) => {
        const v = keep[i] ?? startAges[i] ?? '';
        const opts = Array.from({ length: 18 }, (_, a) => `<option value="${a}"${String(a) === v ? ' selected' : ''}>${a === 0 ? 'פחות משנה' : a}</option>`).join('');
        return `<label>ילד ${i + 1}<select name="ca" required><option value="">גיל</option>${opts}</select></label>`;
      }).join('');
      agesBox.hidden = n === 0;
    };
    renderAges();
    summary();
    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        const n = b.dataset.step!;
        const h = form.querySelector<HTMLInputElement>(`input[name="${n}"]`)!;
        const v = Math.min(Number(h.dataset.max), Math.max(Number(h.dataset.min), Number(h.value) + Number(b.dataset.d)));
        h.value = String(v);
        form.querySelector(`[data-out="${n}"]`)!.textContent = String(v);
        if (n === 'c') renderAges();
        summary();
      }),
    );

    // Free text that matches a known destination still gets its English search term.
    // A missing child age blocks the submit; open the guests panel so the picker can be seen.
    form.addEventListener(
      'invalid',
      (e) => {
        const t = e.target as HTMLElement;
        if (t.matches('select[name="ca"]') && pop.hidden) {
          toggle(true);
          requestAnimationFrame(() => t.focus());
        }
      },
      true,
    );
    form.addEventListener('submit', () => {
      if (!hidden.value) {
        const m = options.find((o) => o.he === input.value.trim());
        hidden.value = m ? m.en : input.value.trim();
        slugIn.value = m ? m.slug : '';
      }
      try {
        sessionStorage.setItem(KEY, new URLSearchParams(new FormData(form) as never).toString());
      } catch {}
    });
  });
</script>
