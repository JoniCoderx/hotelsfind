---
import { destinations } from '../data/destinations';
import { href } from '../lib/url';

interface Props {
  /** Pre-fill the destination (destination pages). */
  presetSlug?: string;
}
const { presetSlug } = Astro.props;
const preset = destinations.find((d) => d.slug === presetSlug);
const options = destinations.map((d) => ({ he: d.he, en: d.en, country: d.country, slug: d.slug }));
---
<form
  class="sf"
  action={href('/search/')}
  method="get"
  role="search"
  data-options={JSON.stringify(options)}
>
  <div class="field dest">
    <label for="sf-q">לאן נוסעים?</label>
    <input
      id="sf-q"
      name="d"
      type="text"
      autocomplete="off"
      placeholder="עיר, אזור או מלון"
      value={preset?.he ?? ''}
      required
      role="combobox"
      aria-expanded="false"
      aria-controls="sf-list"
      aria-autocomplete="list"
    />
    <input type="hidden" name="q" value={preset?.en ?? ''} />
    <ul id="sf-list" class="sf-list" role="listbox" hidden></ul>
  </div>

  <div class="field">
    <label for="sf-in">צ׳ק-אין</label>
    <input id="sf-in" name="in" type="date" />
  </div>

  <div class="field">
    <label for="sf-out">צ׳ק-אאוט</label>
    <input id="sf-out" name="out" type="date" />
  </div>

  <div class="field guests">
    <label for="sf-g">אורחים</label>
    <button id="sf-g" type="button" class="g-btn" aria-expanded="false" aria-controls="sf-pop">
      <span class="g-sum">2 מבוגרים · חדר 1</span>
    </button>
    <div id="sf-pop" class="g-pop" hidden>
      {[
        { n: 'a', label: 'מבוגרים', sub: 'גיל 18+', v: 2, min: 1, max: 16 },
        { n: 'c', label: 'ילדים', sub: 'גיל 0–17', v: 0, min: 0, max: 10 },
        { n: 'r', label: 'חדרים', sub: '', v: 1, min: 1, max: 8 },
      ].map((s) => (
        <div class="step">
          <div>
            <b>{s.label}</b>
            {s.sub && <small>{s.sub}</small>}
          </div>
          <div class="step-ctl">
            <button type="button" data-step={s.n} data-d="-1" aria-label={`הפחת ${s.label}`}>−</button>
            <output data-out={s.n}>{s.v}</output>
            <button type="button" data-step={s.n} data-d="1" aria-label={`הוסף ${s.label}`}>+</button>
          </div>
          <input type="hidden" name={s.n} value={s.v} data-min={s.min} data-max={s.max} />
        </div>
      ))}
      <button type="button" class="btn btn-ink g-done">סיום</button>
    </div>
  </div>

  <button type="submit" class="btn btn-accent go">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.6" fill="none"/><path d="m20 20-3.6-3.6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
    השוו מחירים
  </button>
</form>

<style>
  .sf {
    position: relative;
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1.15fr auto;
    background: var(--card);
    color: var(--ink);
    border-radius: 6px;
    box-shadow: 0 30px 60px -30px rgba(15, 26, 42, 0.45), 0 0 0 1px rgba(15, 26, 42, 0.08);
    text-align: start;
  }
  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 18px 22px;
    min-width: 0;
    border-inline-start: 1px solid var(--line);
    transition: background 0.2s;
  }
  .field:first-child {
    border-inline-start: 0;
  }
  .field:hover,
  .field:focus-within {
    background: #fff;
  }
  label {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }
  input[type='text'],
  input[type='date'],
  .g-btn {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 19px;
    font-weight: 700;
    padding: 0;
    outline: none;
    text-align: start;
    cursor: pointer;
  }
  input[type='text'] {
    cursor: text;
  }
  .g-btn {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  input::placeholder {
    color: #a39c8f;
    font-weight: 500;
  }
  .go {
    height: auto;
    min-height: 84px;
    border-radius: 0 6px 6px 0;
    padding-inline: 34px;
    font-size: 19px;
  }
  :global([dir='rtl']) .go {
    border-radius: 6px 0 0 6px;
  }

  .sf-list {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 8px);
    z-index: 30;
    margin: 0;
    padding: 6px;
    list-style: none;
    max-height: 360px;
    overflow: auto;
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 24px 50px -20px rgba(15, 26, 42, 0.4), 0 0 0 1px var(--line);
    min-width: 300px;
  }
  .sf-list :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
  }
  .sf-list :global(li small) {
    color: var(--muted);
    font-weight: 400;
  }
  .sf-list :global(li[aria-selected='true']),
  .sf-list :global(li:hover) {
    background: var(--paper);
  }

  .g-pop {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 8px);
    z-index: 30;
    width: 310px;
    padding: 20px;
    display: grid;
    gap: 16px;
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 24px 50px -20px rgba(15, 26, 42, 0.4), 0 0 0 1px var(--line);
  }
  .g-pop[hidden] {
    display: none;
  }
  .step {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .step small {
    display: block;
    color: var(--muted);
    font-size: 13px;
  }
  .step-ctl {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .step-ctl button {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    font-size: 20px;
    cursor: pointer;
  }
  .step-ctl button:hover {
    border-color: var(--ink);
  }
  output {
    min-width: 20px;
    text-align: center;
    font-weight: 800;
  }
  .g-done {
    height: 46px;
  }

  @media (max-width: 1020px) {
    .sf {
      grid-template-columns: 1fr 1fr;
    }
    .dest,
    .guests,
    .go {
      grid-column: 1 / -1;
    }
    .field {
      border-inline-start: 0;
      border-top: 1px solid var(--line);
    }
    .field:nth-child(3) {
      border-inline-start: 1px solid var(--line);
    }
    .dest {
      border-top: 0;
    }
    .go,
    :global([dir='rtl']) .go {
      min-height: 64px;
      border-radius: 0 0 6px 6px;
    }
    .g-pop {
      inset-inline: 0;
      width: auto;
    }
  }
</style>

<script>
  type Opt = { he: string; en: string; country: string; slug: string };

  const iso = (d: Date) => d.toISOString().slice(0, 10);
  const addDays = (d: Date, n: number) => new Date(d.getTime() + n * 86_400_000);

  document.querySelectorAll<HTMLFormElement>('form.sf').forEach((form) => {
    const options: Opt[] = JSON.parse(form.dataset.options || '[]');
    const input = form.querySelector<HTMLInputElement>('#sf-q')!;
    const hidden = form.querySelector<HTMLInputElement>('input[name="q"]')!;
    const list = form.querySelector<HTMLUListElement>('#sf-list')!;
    const din = form.querySelector<HTMLInputElement>('#sf-in')!;
    const dout = form.querySelector<HTMLInputElement>('#sf-out')!;
    let active = -1;
    let shown: Opt[] = [];

    // Restore a previous search from the URL (the /search page).
    const params = new URLSearchParams(location.search);
    if (params.get('d')) {
      input.value = params.get('d')!;
      hidden.value = params.get('q') || '';
    }
    const dateRe = /^\d{4}-\d{2}-\d{2}$/;
    if (dateRe.test(params.get('in') || '') && dateRe.test(params.get('out') || '')) {
      din.value = params.get('in')!;
      dout.value = params.get('out')!;
    }
    for (const n of ['a', 'c', 'r']) {
      const h = form.querySelector<HTMLInputElement>(`input[name="${n}"]`)!;
      const v = Number(params.get(n));
      if (params.has(n) && Number.isInteger(v) && v >= Number(h.dataset.min) && v <= Number(h.dataset.max)) {
        h.value = String(v);
        form.querySelector(`[data-out="${n}"]`)!.textContent = String(v);
      }
    }

    // Dates: default to a weekend two weeks out, and keep checkout after checkin.
    const today = new Date();
    din.min = iso(today);
    if (!din.value) {
      const start = addDays(today, 14 + ((4 - today.getDay() + 7) % 7));
      din.value = iso(start);
      dout.value = iso(addDays(start, 2));
    }
    dout.min = iso(addDays(new Date(din.value), 1));
    din.addEventListener('change', () => {
      const next = iso(addDays(new Date(din.value), 1));
      dout.min = next;
      if (!dout.value || dout.value <= din.value) dout.value = iso(addDays(new Date(din.value), 2));
    });

    // Destination combobox.
    const render = () => {
      const t = input.value.trim().toLowerCase();
      shown = options
        .filter((o) => !t || o.he.includes(t) || o.en.toLowerCase().includes(t) || o.country.includes(t))
        .slice(0, 8);
      list.innerHTML = shown
        .map(
          (o, i) =>
            `<li role="option" id="sf-o${i}" aria-selected="${i === active}" data-i="${i}"><span>${o.he}</span><small>${o.country}</small></li>`,
        )
        .join('');
      const open = shown.length > 0 && document.activeElement === input;
      list.hidden = !open;
      input.setAttribute('aria-expanded', String(open));
      input.setAttribute('aria-activedescendant', active >= 0 ? `sf-o${active}` : '');
    };
    const pick = (o: Opt) => {
      input.value = o.he;
      hidden.value = o.en;
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
    };
    input.addEventListener('focus', render);
    input.addEventListener('input', () => {
      hidden.value = '';
      active = -1;
      render();
    });
    input.addEventListener('keydown', (e) => {
      if (list.hidden) return;
      if (e.key === 'ArrowDown') active = Math.min(active + 1, shown.length - 1);
      else if (e.key === 'ArrowUp') active = Math.max(active - 1, 0);
      else if (e.key === 'Enter' && active >= 0) {
        e.preventDefault();
        pick(shown[active]);
        return;
      } else if (e.key === 'Escape') {
        list.hidden = true;
        return;
      } else return;
      e.preventDefault();
      render();
    });
    list.addEventListener('mousedown', (e) => {
      const li = (e.target as HTMLElement).closest('li');
      if (li) {
        e.preventDefault();
        pick(shown[Number(li.dataset.i)]);
      }
    });
    input.addEventListener('blur', () => setTimeout(() => (list.hidden = true), 120));

    // Guests popover.
    const gBtn = form.querySelector<HTMLButtonElement>('.g-btn')!;
    const pop = form.querySelector<HTMLDivElement>('.g-pop')!;
    const sum = form.querySelector<HTMLSpanElement>('.g-sum')!;
    const val = (n: string) => Number(form.querySelector<HTMLInputElement>(`input[name="${n}"]`)!.value);
    const summary = () => {
      const a = val('a'), c = val('c'), r = val('r');
      sum.textContent =
        (a === 1 ? 'מבוגר 1' : `${a} מבוגרים`) +
        (c ? ` · ${c === 1 ? 'ילד 1' : `${c} ילדים`}` : '') +
        ` · ${r === 1 ? 'חדר 1' : `${r} חדרים`}`;
    };
    const toggle = (open: boolean) => {
      pop.hidden = !open;
      gBtn.setAttribute('aria-expanded', String(open));
    };
    gBtn.addEventListener('click', () => toggle(pop.hidden));
    form.querySelector('.g-done')!.addEventListener('click', () => toggle(false));
    document.addEventListener('click', (e) => {
      if (!pop.hidden && !(e.target as HTMLElement).closest('.guests')) toggle(false);
    });
    summary();
    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        const n = b.dataset.step!;
        const h = form.querySelector<HTMLInputElement>(`input[name="${n}"]`)!;
        const v = Math.min(Number(h.dataset.max), Math.max(Number(h.dataset.min), Number(h.value) + Number(b.dataset.d)));
        h.value = String(v);
        form.querySelector(`[data-out="${n}"]`)!.textContent = String(v);
        summary();
      }),
    );

    // Free text that matches a known destination still gets its English search term.
    form.addEventListener('submit', () => {
      if (!hidden.value) {
        const m = options.find((o) => o.he === input.value.trim());
        hidden.value = m ? m.en : input.value.trim();
      }
    });
  });
</script>
