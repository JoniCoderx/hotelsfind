---
import Logo from './Logo.astro';
import { href } from '../lib/url';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const links = [
  { to: '/destinations/', label: 'יעדים' },
  { to: '/#how', label: 'איך זה עובד' },
  { to: '/#partners', label: 'אתרי ההזמנות' },
  { to: '/#faq', label: 'שאלות' },
];
---
<header class:list={['hdr', { overlay }]}>
  <div class="wrap hdr-in">
    <a href={href('/')} aria-label="לילה זול, דף הבית"><Logo light={overlay} /></a>
    <nav class="nav" aria-label="ראשי">
      {links.map((l) => <a href={href(l.to)}>{l.label}</a>)}
    </nav>
    <a href={href('/#search')} class="btn btn-accent cta">חפשו מלון</a>
    <button class="burger" aria-label="תפריט" aria-expanded="false" aria-controls="mnav">
      <span></span><span></span>
    </button>
  </div>
  <nav id="mnav" class="mnav" aria-label="תפריט נייד" hidden>
    {links.map((l) => <a href={href(l.to)}>{l.label}</a>)}
    <a href={href('/#search')} class="btn btn-accent">חפשו מלון</a>
  </nav>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .overlay {
    position: absolute;
    inset-inline: 0;
    background: transparent;
    border-color: rgba(255, 255, 255, 0.22);
    color: #fff;
  }
  .hdr-in {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 76px;
  }
  .nav {
    display: flex;
    gap: 30px;
    margin-inline-start: auto;
    font-weight: 600;
    font-size: 16px;
  }
  .nav a {
    position: relative;
    padding-block: 6px;
  }
  .nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s;
  }
  .nav a:hover::after {
    transform: scaleX(1);
  }
  .cta {
    height: 46px;
    padding-inline: 22px;
    font-size: 16px;
  }
  .burger {
    display: none;
    margin-inline-start: auto;
    width: 46px;
    height: 46px;
    border: 1.5px solid currentColor;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .burger span {
    width: 20px;
    height: 2px;
    background: currentColor;
    transition: transform 0.25s;
  }
  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  .mnav {
    display: grid;
    padding: 8px 24px 24px;
    background: var(--paper);
    color: var(--ink);
  }
  .mnav[hidden] {
    display: none;
  }
  .mnav a:not(.btn) {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--display);
    font-size: 40px;
    line-height: 1;
  }
  .mnav .btn {
    margin-top: 18px;
  }
  @media (max-width: 900px) {
    .nav,
    .cta {
      display: none;
    }
    .burger {
      display: flex;
    }
  }
</style>

<script>
  const b = document.querySelector<HTMLButtonElement>('.burger');
  const m = document.getElementById('mnav');
  b?.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    if (m) m.hidden = open;
  });
  m?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      m.hidden = true;
      b?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
