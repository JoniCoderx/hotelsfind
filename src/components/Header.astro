---
import Logo from './Logo.astro';
import { href } from '../lib/url';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const links = [
  { to: '/destinations/', label: 'יעדים' },
  { to: '/#deals', label: 'דילים חמים' },
  { to: '/#how', label: 'איך זה עובד' },
  { to: '/#faq', label: 'שאלות' },
];
---
<header class:list={['hdr', { overlay }]}>
  <div class="wrap hdr-in">
    <a href={href('/')} aria-label="StayRadar, דף הבית"><Logo light={overlay} /></a>
    <nav class="nav" aria-label="ראשי">
      {links.map((l) => <a href={href(l.to)}>{l.label}</a>)}
    </nav>
    <a href={href('/#search')} class="btn btn-fire cta">חפשו מלון</a>
    <button class="burger" aria-label="תפריט" aria-expanded="false" aria-controls="mnav">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav id="mnav" class="mnav" aria-label="תפריט נייד" hidden>
    {links.map((l) => <a href={href(l.to)}>{l.label}</a>)}
    <a href={href('/#search')} class="btn btn-fire">חפשו מלון</a>
  </nav>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .hdr.scrolled {
    border-bottom-color: var(--line);
  }
  .overlay {
    position: absolute;
    inset-inline: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: transparent;
    color: #fff;
  }
  .hdr-in {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 70px;
  }
  .nav {
    display: flex;
    gap: 4px;
    margin-inline-start: auto;
    font-weight: 500;
    font-size: 16px;
    color: var(--ink-2);
  }
  .nav a {
    padding: 8px 14px;
    border-radius: 999px;
    transition: background 0.2s;
  }
  .nav a:hover {
    background: var(--soft);
    color: var(--ink);
  }
  .overlay .nav a:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .cta {
    height: 44px;
    padding-inline: 20px;
    font-size: 15px;
  }
  .burger {
    display: none;
    margin-inline-start: auto;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 12px;
    background: var(--soft);
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }
  .burger span {
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.2s, opacity 0.2s;
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .mnav {
    display: grid;
    gap: 4px;
    padding: 8px 20px 20px;
    background: #fff;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .mnav[hidden] {
    display: none;
  }
  .mnav a:not(.btn) {
    padding: 14px 6px;
    font-size: 20px;
    font-weight: 600;
    border-bottom: 1px solid var(--line);
  }
  .mnav .btn {
    margin-top: 12px;
  }
  @media (max-width: 900px) {
    .nav,
    .cta {
      display: none;
    }
    .burger {
      display: flex;
    }
  }
</style>

<script>
  const hdr = document.querySelector('.hdr');
  const onScroll = () => hdr?.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  const b = document.querySelector<HTMLButtonElement>('.burger');
  const m = document.getElementById('mnav');
  b?.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    if (m) m.hidden = open;
  });
  m?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      m.hidden = true;
      b?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
