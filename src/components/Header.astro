---
import Logo from './Logo.astro';
import { href } from '../lib/url';
const links = [
  { to: '/destinations/', label: 'יעדים' },
  { to: '/#how', label: 'איך זה עובד' },
  { to: '/#partners', label: 'השותפים' },
  { to: '/#faq', label: 'שאלות' },
];
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a href={href('/')} class="brand" aria-label="HotelsFind, דף הבית">
      <Logo />
      <span class="ltr">Hotels<b>Find</b></span>
    </a>
    <nav class="nav" aria-label="ראשי">
      {links.map((l) => <a href={href(l.to)}>{l.label}</a>)}
    </nav>
    <a href={href('/#search')} class="btn btn-primary hdr-cta">חפשו מלון</a>
    <button class="burger" aria-label="תפריט" aria-expanded="false" aria-controls="mnav">
      <span></span><span></span>
    </button>
  </div>
  <nav id="mnav" class="mnav" aria-label="תפריט נייד" hidden>
    {links.map((l) => <a href={href(l.to)}>{l.label}</a>)}
    <a href={href('/#search')} class="btn btn-primary">חפשו מלון</a>
  </nav>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    background: rgba(6, 6, 11, 0.55);
    border-bottom: 1px solid var(--border);
  }
  .hdr-in {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .brand b {
    font-weight: 900;
  }
  .nav {
    display: flex;
    gap: 6px;
    margin-inline-start: auto;
  }
  .nav a {
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 500;
    transition: color 0.2s, background 0.2s;
  }
  .nav a:hover {
    color: var(--text);
    background: var(--surface);
  }
  .hdr-cta {
    --h: 44px;
    font-size: 15px;
    padding-inline: 20px;
  }
  .burger {
    display: none;
    margin-inline-start: auto;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .burger span {
    width: 18px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.25s;
  }
  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  .mnav {
    display: grid;
    gap: 4px;
    padding: 8px 20px 20px;
  }
  .mnav[hidden] {
    display: none;
  }
  .mnav a:not(.btn) {
    padding: 14px 4px;
    border-bottom: 1px solid var(--border);
    font-size: 19px;
    font-weight: 600;
  }
  .mnav .btn {
    margin-top: 12px;
  }
  @media (max-width: 880px) {
    .nav,
    .hdr-cta {
      display: none;
    }
    .burger {
      display: flex;
    }
  }
</style>

<script>
  const b = document.querySelector<HTMLButtonElement>('.burger');
  const m = document.getElementById('mnav');
  b?.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    if (m) m.hidden = open;
  });
  m?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      m.hidden = true;
      b?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
