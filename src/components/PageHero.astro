---
// Shared page header: the brand band, optionally over a photo, with breadcrumbs, title and lead.
// `overlap` leaves room for a card (e.g. the search form) that pulls up over the band's bottom edge.
import Img from './Img.astro';
import type { Photo } from '../lib/photo';
import { href } from '../lib/url';

interface Crumb { label: string; to?: string }
interface Props {
  title: string;
  accent?: string;
  eyebrow?: string;
  lead?: string;
  photo?: Photo;
  crumbs?: Crumb[];
  compact?: boolean;
  overlap?: boolean;
  center?: boolean;
}
const { title, accent, eyebrow, lead, photo, crumbs, compact = false, overlap = false, center = false } = Astro.props;
---
<section class:list={['phero', { compact, overlap, center, photo: Boolean(photo) }]}>
  {photo && <Img photo={{ ...photo, alt: '' }} class="phero-bg" eager sizes="100vw" max={2000} />}
  <div class="phero-shade" aria-hidden="true"></div>
  <div class="wrap phero-in rise">
    {crumbs && (
      <nav class="crumbs" aria-label="פירורי לחם">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true">›</span>}
            {c.to ? <a href={href(c.to)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="h1">{title}{accent && <> <span class="sun">{accent}</span></>}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(40px, 6vw, 84px) clamp(44px, 6vw, 80px);
    background:
      radial-gradient(60% 90% at 0% 100%, rgba(18, 181, 160, 0.3) 0%, transparent 60%),
      radial-gradient(40% 70% at 100% 0%, rgba(255, 255, 255, 0.12) 0%, transparent 70%),
      var(--brand-band);
    color: #fff;
  }
  .phero.compact {
    padding-block: clamp(32px, 4.5vw, 56px);
  }
  .phero.overlap {
    padding-bottom: clamp(84px, 9vw, 120px);
  }
  .phero :global(.phero-bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .photo .phero-shade {
    background:
      linear-gradient(270deg, rgba(6, 30, 120, 0.9) 0%, rgba(8, 44, 170, 0.62) 55%, rgba(8, 44, 170, 0.3) 100%),
      linear-gradient(0deg, rgba(6, 24, 90, 0.5) 0%, transparent 50%);
  }
  .center .phero-in {
    text-align: center;
    justify-items: center;
  }
  .phero-in {
    display: grid;
    gap: 0;
  }
  .phero-in > :global(*) {
    max-width: 760px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.78);
  }
  .crumbs a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: #fff;
    font-weight: 600;
  }
  .eyebrow {
    justify-self: start;
    margin: 0 0 12px;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .center .eyebrow {
    justify-self: center;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    color: #fff;
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 24px rgba(4, 16, 70, 0.3);
  }
  .compact h1 {
    font-size: clamp(30px, 4vw, 46px);
  }
  .sun {
    color: var(--sun);
  }
  .lead {
    margin: 14px 0 0;
    font-size: clamp(17px, 1.6vw, 20px);
    color: rgba(255, 255, 255, 0.9);
  }
</style>
