---
import Logo from './Logo.astro';
import { israel, abroad } from '../data/destinations';
import { site } from '../data/site';
import { href } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="big">
      <p class="display">לילה טוב.<br /><span class="accent">ולילה זול.</span></p>
      <a href={href('/#search')} class="btn btn-accent">התחילו להשוות <span class="arrow">←</span></a>
    </div>
    <div class="grid">
      <div class="brand">
        <Logo light />
        <p>{site.slogan} משווים את אתרי ההזמנות הגדולים בעולם, ואתם מזמינים איפה שהכי משתלם.</p>
        <a class="mail ltr" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div>
        <h3>מלונות בישראל</h3>
        <ul>{israel.map((d) => <li><a href={href(`/destinations/${d.slug}/`)}>מלונות ב{d.he}</a></li>)}</ul>
      </div>
      <div>
        <h3>מלונות בחו"ל</h3>
        <ul class="cols">{abroad.map((d) => <li><a href={href(`/destinations/${d.slug}/`)}>מלונות ב{d.he}</a></li>)}</ul>
      </div>
      <div>
        <h3>לילה זול</h3>
        <ul>
          <li><a href={href('/about/')}>מי אנחנו</a></li>
          <li><a href={href('/disclosure/')}>גילוי נאות ושותפים</a></li>
          <li><a href={href('/terms/')}>תנאי שימוש</a></li>
          <li><a href={href('/privacy/')}>מדיניות פרטיות</a></li>
          <li><a href={href('/accessibility/')}>הצהרת נגישות</a></li>
          <li><a href={href('/credits/')}>קרדיט לתמונות</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>
        לילה זול ({site.domain}) הוא אתר השוואה שמפנה לאתרי הזמנות חיצוניים. איננו סוכנות נסיעות, איננו מוכרים חדרים ואיננו גובים
        תשלום. ההזמנה, התשלום ותנאי הביטול הם בין המזמין לבין אתר ההזמנות או המלון. המחירים נקבעים על ידי השותפים ואינם מובטחים.
        ייתכן שנקבל עמלה מהשותפים על הזמנות שבוצעו דרך הקישורים באתר, ללא עלות נוספת עבורכם.
      </p>
      <p>© {year} לילה זול. שמות המותגים שייכים לבעליהם.</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--night);
    color: var(--paper);
    padding-block: 96px 32px;
    font-size: 15px;
  }
  .big {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 64px;
    margin-bottom: 56px;
    border-bottom: 1px solid rgba(243, 238, 228, 0.15);
  }
  .big .display {
    font-size: clamp(72px, 11vw, 170px);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.6fr 1fr;
    gap: 40px;
  }
  .brand p {
    color: rgba(243, 238, 228, 0.65);
    margin-top: 16px;
    max-width: 34ch;
  }
  .mail {
    color: var(--moon);
  }
  h3 {
    font-size: 14px;
    font-weight: 800;
    color: var(--moon);
    margin-bottom: 16px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .cols {
    grid-template-columns: 1fr 1fr;
    column-gap: 20px;
  }
  li a {
    color: rgba(243, 238, 228, 0.72);
  }
  li a:hover {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
  .legal {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid rgba(243, 238, 228, 0.15);
    font-size: 13px;
    color: rgba(243, 238, 228, 0.45);
  }
  .legal p {
    max-width: 110ch;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 540px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
