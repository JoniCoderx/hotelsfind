---
import Logo from './Logo.astro';
import Newsletter from './Newsletter.astro';
import Img from './Img.astro';
import { hotel } from '../data/photos';
import { israel, abroad } from '../data/destinations';
import { site } from '../data/site';
import { href } from '../lib/url';
import { priceMode } from '../lib/mode';

const live = priceMode() === 'live';
// The sign-up form appears once Resend is set up for this deployment, so visitors never meet a dead form.
const newsletter = Boolean(process.env.RESEND_API_KEY);
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="cta">
      <Img photo={{ ...hotel.sunset, alt: '' }} class="cta-bg" sizes="(max-width: 1200px) 100vw, 1200px" max={1600} />
      <div class="cta-txt">
        <p class="big">מוכנים לחופשה?<br /><span class="fire">המלון הבא מחכה.</span></p>
        <p class="sub">{live ? "חיפוש אחד, מחירים מ-Agoda, ובלחיצה בדיקה גם באתרים נוספים." : "חיפוש אחד, ובלחיצה אותו חיפוש ב-Booking, Agoda ועוד."}</p>
      </div>
      <a href={href('/#search')} class="btn btn-sun">למחירים <span class="arrow">←</span></a>
    </div>
    {newsletter && <Newsletter />}
    <div class="grid">
      <div class="brand">
        <Logo light height={34} />
        <p>{site.slogan} {live ? "מחירי מלונות מ-Agoda וקישור מהיר לאותו חיפוש באתרי ההזמנות הגדולים." : "קישור מהיר לאותו חיפוש באתרי ההזמנות הגדולים."}</p>
        <span class="mail ltr">{site.email}</span>
        <div class="socials">
        <a class="social" href={site.instagram} target="_blank" rel="noopener me" aria-label="מלונזול באינסטגרם">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg>
          <span>אינסטגרם <span class="ltr">@malonzoll</span></span>
        </a>
        <a class="social" href={site.telegram} target="_blank" rel="noopener me" aria-label="ערוץ הטלגרם של מלונזול">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M21.9 4.3 18.7 19.4c-.2 1.1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.2 13 1.4 11.5c-1-.3-1.1-1 .2-1.5L20.5 2.9c.9-.3 1.6.2 1.4 1.4Z"/></svg>
          <span>ערוץ טלגרם</span>
        </a>
        </div>
      </div>
      <div>
        <h2 class="fh">מלונות בישראל</h2>
        <ul>{israel.map((d) => <li><a href={href(`/destinations/${d.slug}/`)}>מלונות ב{d.he}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="fh">מלונות בחו"ל</h2>
        <ul class="cols">{abroad.map((d) => <li><a href={href(`/destinations/${d.slug}/`)}>מלונות ב{d.he}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="fh">מלונזול</h2>
        <ul>
          <li><a href={href('/guides/')}>מדריכי מלונות</a></li>
          <li><a href={href('/best/')}>מלונות מומלצים</a></li>
          <li><a href={href('/how-it-works/')}>איך זה עובד</a></li>
          <li><a href={href('/about/')}>מי אנחנו</a></li>
          <li><a href={href('/disclosure/')}>גילוי נאות ושותפים</a></li>
          <li><a href={href('/terms/')}>תנאי שימוש</a></li>
          <li><a href={href('/privacy/')}>מדיניות פרטיות</a></li>
          <li><a href={href('/accessibility/')}>הצהרת נגישות</a></li>
          <li><a href={href('/credits/')}>קרדיט לתמונות</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>
        מלונזול ({site.domain}) הוא אתר חיפוש שמפנה לאתרי הזמנות חיצוניים. איננו סוכנות נסיעות, איננו מוכרים חדרים ואיננו גובים
        תשלום. ההזמנה, התשלום ותנאי הביטול הם בין המזמין לבין אתר ההזמנות או המלון. המחירים נקבעים על ידי השותפים, מתעדכנים כל
        הזמן ואינם מובטחים. ייתכן שנקבל עמלה מהשותפים על הזמנות שבוצעו דרך הקישורים באתר. מלונזול לא גובה מכם תשלום על השימוש או על ההפניה.
      </p>
      <p>© {year} מלונזול. שמות המותגים שייכים לבעליהם.</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: #0b1530;
    color: #e6ebf5;
    padding-block: 64px 28px;
    font-size: 15px;
    margin-top: 40px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(26px, 4vw, 44px);
    border-radius: 28px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--brand);
    color: #fff;
    margin-bottom: 56px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }
  .cta :global(.cta-bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(270deg, rgba(6, 30, 120, 0.92) 0%, rgba(8, 44, 170, 0.7) 60%, rgba(8, 44, 170, 0.35) 100%);
  }
  .cta .fire {
    background: none;
    -webkit-text-fill-color: var(--sun);
    color: var(--sun);
  }
  .btn-sun {
    background: var(--sun);
    color: var(--ink);
    font-weight: 800;
  }
  .btn-sun:hover {
    background: #ffd25e;
  }
  .big {
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .sub {
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.6fr 1fr;
    gap: 40px;
  }
  .brand p {
    color: #aab4c8;
    margin-top: 14px;
    max-width: 34ch;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    font-weight: 700;
  }
  .social:hover {
    border-color: #fff;
  }
  .mail {
    color: var(--sun);
    user-select: all;
  }
  .fh {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 12px;
    color: #fff;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 7px;
  }
  .cols {
    grid-template-columns: 1fr 1fr;
    column-gap: 20px;
  }
  li a {
    color: #aab4c8;
    transition: color 0.2s;
  }
  li a:hover {
    color: #fff;
  }
  .legal {
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 13px;
    color: #9aa5bb;
  }
  .legal p {
    max-width: 110ch;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 540px) {
    .ftr {
      padding-top: 40px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    ul {
      grid-template-columns: 1fr 1fr;
      column-gap: 16px;
      font-size: 14.5px;
    }
    .cta {
      margin-bottom: 36px;
    }
  }
</style>
