---
import Base from './Base.astro';
interface Props { title: string; heading: string; description?: string }
const { title, heading, description } = Astro.props;
---
<Base title={`${title} | לילה זול`} description={description}>
  <section class="wrap page">
    <h1 class="display d-xl">{heading}</h1>
    <div class="prose"><slot /></div>
  </section>
</Base>

<style>
  .page {
    padding-block: 72px 110px;
  }
  h1 {
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 1.5px solid var(--ink);
  }
</style>
