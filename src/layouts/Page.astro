---
import Base from './Base.astro';
interface Props { title: string; heading: string; description?: string }
const { title, heading, description } = Astro.props;
---
<Base title={`${title} | HotelsFind`} description={description}>
  <section class="wrap page">
    <h1 class="h-lg">{heading}</h1>
    <div class="prose"><slot /></div>
  </section>
</Base>

<style>
  .page {
    padding-block: 64px 96px;
  }
</style>
