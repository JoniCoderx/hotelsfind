---
import '@fontsource-variable/assistant';
// Page headings use Rubik ExtraBold, the typeface the logo is drawn from.
import '@fontsource/rubik/hebrew-800.css';
import '@fontsource/rubik/latin-800.css';
import hebrewFont from '@fontsource-variable/assistant/files/assistant-hebrew-wght-normal.woff2?url';
import headingFont from '@fontsource/rubik/files/rubik-hebrew-800-normal.woff2?url';
import '../styles/global.css';
import '../styles/hotels.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { href } from '../lib/url';
import { priceMode } from '../lib/mode';

interface Props {
  title: string;
  description?: string;
  /** Structured data objects, each rendered as its own JSON-LD script. */
  jsonLd?: object[];
  noindex?: boolean;
  /** The page opens with a photo header: the site header floats over it. */
  overlay?: boolean;
  /** Share image for this page (absolute URL or site path); defaults to the brand card. */
  image?: string;
  /** Marks the page as an article for link previews (guides). ISO dates. */
  article?: { published: string; modified: string };
}

const { title, description = site.description, jsonLd = [], noindex = false, overlay = false, image, article } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// The share image promises prices only when the deployment shows them.
// Travelpayouts Drive: the script name is the account marker in base64, so it follows PUBLIC_TP_MARKER.
const tpMarker = (import.meta.env.PUBLIC_TP_MARKER ?? '').trim();
const drive = import.meta.env.PUBLIC_TP_DRIVE;
const driveSrc = drive !== 'off' && tpMarker ? `https://emrld.ltd/${btoa(tpMarker)}.js?t=${encodeURIComponent(tpMarker)}` : '';
const brandImage = new URL(href(priceMode() === 'live' ? '/og.png' : '/og-links.png'), Astro.site).toString() + '?v=3';
const ogImage = image ? new URL(image, Astro.site).toString() : brandImage;

const baseLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    alternateName: site.nameHe,
    url: new URL(href('/'), Astro.site).toString(),
    logo: new URL(href('/icon-512.png'), Astro.site).toString(),
    email: site.email,
    sameAs: [site.instagram, site.telegram, site.tiktok],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    inLanguage: 'he-IL',
    url: new URL(href('/'), Astro.site).toString(),
    potentialAction: {
      '@type': 'SearchAction',
      target: `${new URL(href('/search/'), Astro.site)}?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="price-mode" content={priceMode()} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0b2c95" />
    <!-- Search results show a site icon only from a crawlable raster or ICO; the SVG serves modern browsers. -->
    <link rel="icon" href={href('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <link rel="alternate" hreflang="he-IL" href={canonical} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified} />}
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={hebrewFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Travelpayouts Drive: verifies site ownership and adds Drive's link tools. Loads once PUBLIC_TP_MARKER is set;
         PUBLIC_TP_DRIVE=off removes it. -->
    {driveSrc && <script is:inline data-noptimize="1" data-cfasync="false" data-no-defer="1" data-cmp-ab="2" define:vars={{ driveSrc }}>
      (function () {
        function load() {
          var script = document.createElement('script');
          script.async = 1;
          script.setAttribute('data-cmp-ab', '2');
          script.src = driveSrc;
          document.head.appendChild(script);
        }
        // After the page has loaded and the browser is idle, so it never delays the first paint.
        function idle() { 'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 3000 }) : setTimeout(load, 1500); }
        document.readyState === 'complete' ? idle() : addEventListener('load', idle);
      })();
    </script>}
    {[...baseLd, ...jsonLd].map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body data-overlay={overlay ? "" : undefined}>
    <a class="skip" href="#main">דלגו לתוכן</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { trackOutbound } from '../lib/outbound';
      trackOutbound();
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
