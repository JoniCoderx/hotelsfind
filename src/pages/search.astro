---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import { href } from '../lib/url';
import { priceMode } from '../lib/mode';

const live = priceMode() === 'live';
---
<Base title="תוצאות חיפוש | מלונזול" description={live ? "מחירי מלונות מ-Agoda ובדיקה מהירה של אותו חיפוש ב-Booking, Expedia, Hotels.com ו-Trip.com." : "אותו חיפוש מלונות ב-Booking, Agoda, Expedia, Hotels.com ו-Trip.com."} noindex>
  <section class="top">
    <div class="wrap">
      <button type="button" class="sum-bar" id="sum-bar" aria-expanded="false" aria-controls="top-form" hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.4" fill="none"/><path d="m20 20-3.6-3.6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        <span class="sb-txt"><b id="sb-where"></b><small id="sb-when"></small></span>
        <span class="sb-edit">שינוי</span>
      </button>
      <div class="top-form" id="top-form"><SearchForm /></div>
    </div>
  </section>

  <div class="tools" id="tools" hidden>
    <div class="wrap tools-in">
      <button type="button" class="tool" id="f-open" aria-controls="filters" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
        סינון <span class="f-count" id="f-count-m"></span>
      </button>
      <label class="tool">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4v16m0 0-3.5-3.5M8 20l3.5-3.5M16 20V4m0 0-3.5 3.5M16 4l3.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
        <span>מיון</span>
        <select id="f-sort-m" aria-label="מיון">
          <option value="Recommended">מומלץ</option>
          <option value="PriceAsc">המחיר הנמוך ביותר</option>
          <option value="AllGuestsReviewScore">ציון אורחים</option>
          <option value="StarRatingDesc">כוכבים</option>
        </select>
      </label>
    </div>
  </div>
  <div class="f-back" id="f-back" hidden></div>

  <div class="wrap res">
    <aside class="filters" id="filters" aria-label="סינון">
      <div class="f-head">
        <h2>סינון <span class="f-count" id="f-count"></span></h2>
        <button type="button" class="f-reset" id="f-reset">ניקוי</button>
        <button type="button" class="f-close" id="f-close" aria-label="סגירה">×</button>
      </div>
      <fieldset>
        <legend>מחיר ללילה עד</legend>
        <input type="range" id="f-max" aria-label="מחיר ללילה עד" min="200" max="3000" step="50" value="3000" />
        <output id="f-max-out">ללא הגבלה</output>
      </fieldset>
      <fieldset>
        <legend>כוכבים</legend>
        <div class="pills" data-f="stars">
          <button type="button" data-v="0" aria-pressed="true">הכל</button>
          <button type="button" data-v="3" aria-pressed="false" dir="ltr">3+</button>
          <button type="button" data-v="4" aria-pressed="false" dir="ltr">4+</button>
          <button type="button" data-v="5" aria-pressed="false">5</button>
        </div>
      </fieldset>
      <fieldset>
        <legend>ציון אורחים</legend>
        <div class="pills" data-f="score">
          <button type="button" data-v="0" aria-pressed="true">הכל</button>
          <button type="button" data-v="7" aria-pressed="false" dir="ltr">7+</button>
          <button type="button" data-v="8" aria-pressed="false" dir="ltr">8+</button>
          <button type="button" data-v="9" aria-pressed="false" dir="ltr">9+</button>
        </div>
      </fieldset>
      <fieldset class="checks">
        <legend>עוד</legend>
        <label><input type="checkbox" id="f-deal" /> רק דילים במבצע</label>
        <label><input type="checkbox" id="f-bf" /> ארוחת בוקר כלולה</label>
      </fieldset>
      <button type="button" class="btn btn-fire f-apply" id="f-apply">הצגת תוצאות</button>
    </aside>

    <section class="main" aria-live="polite">
      <div class="r-head">
        <div>
          <h1 id="r-title">חיפוש מלונות</h1>
          <p id="r-sum">בחרו יעד ותאריכים כדי לראות מחירים.</p>
        </div>
        <label class="sort">
          <span>מיון</span>
          <select id="f-sort">
            <option value="Recommended">מומלץ</option>
            <option value="PriceAsc">המחיר הנמוך ביותר</option>
            <option value="AllGuestsReviewScore">ציון אורחים</option>
            <option value="StarRatingDesc">כוכבים</option>
          </select>
        </label>
      </div>

      <div class="compare" id="compare" hidden>
        <span>בדיקת מחיר לאותו יעד ותאריכים ב:</span>
        <div id="compare-links"></div>
      </div>
      <p class="compare-note" id="compare-note" hidden></p>
      {live && <p class="aff">חלק מהקישורים הם קישורי שותפים: אם תזמינו דרכם, ייתכן שנקבל עמלה מאתר ההזמנות. מלונזול לא גובה מכם תשלום על השימוש או על ההפניה.</p>}

      <p class="checked" id="checked" hidden></p>
      <p class="demo" id="demo" hidden>נתוני דוגמה בלבד: מפתח Agoda עוד לא מחובר, השמות והמחירים כאן לא אמיתיים.</p>

      {live && (
      <div class="scan" id="scan" hidden aria-live="polite">
        <div class="radar" aria-hidden="true"><span class="sw"></span><i></i><i></i><i></i></div>
        <div>
          <b>מביאים מחירים מ-Agoda…</b>
          <span>לתאריכים ולאורחים שבחרתם</span>
        </div>
      </div>
      )}
      <div id="list" class="list"></div>
      <button type="button" class="btn btn-line more" id="more" hidden>הצג עוד מלונות</button>
      <p class="more-note" id="more-note" hidden></p>

      <div id="links" class="links" hidden>
        <p class="why-links" id="links-why"></p>
        <h2>בדקו מחירים ישירות באתרי ההזמנות</h2>
        <p class="links-note">
          <b>הסדר כאן אינו לפי מחיר.</b> את המחירים לא בדקנו, ורואים אותם באתרים עצמם. חלק מהקישורים הם קישורי שותפים: אם
          תזמינו דרכם ייתכן שנקבל עמלה, בלי תוספת למחיר שלכם. <a href={href('/disclosure/')}>איך אנחנו מרוויחים</a>
        </p>
        <ul id="links-list"></ul>
      </div>

      <noscript><p>כדי לראות מחירים יש להפעיל JavaScript בדפדפן.</p></noscript>
      <p class="fine">
        {live
          ? 'המחירים מגיעים מ-Agoda בזמן החיפוש, ללילה ולפני מיסים ודמי שירות, ועשויים להשתנות. את שאר האתרים איננו בודקים: הקישורים פותחים שם את אותו יעד ותאריכים.'
          : 'הקישורים פותחים את אותו יעד ותאריכים באתרי ההזמנות. את המחירים והתנאים רואים שם.'} ההזמנה מתבצעת באתר השותף, ואנו עשויים לקבל
        עמלה. מלונזול לא גובה מכם תשלום. <a href={href('/disclosure/')}>גילוי נאות</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .top {
    background: var(--brand-band);
    padding-block: 18px 22px;
  }
  .sum-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 14px;
    border: 4px solid var(--sun);
    border-radius: 14px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .sum-bar[hidden] {
    display: none;
  }
  .sb-txt {
    flex: 1;
    min-width: 0;
    display: grid;
    line-height: 1.3;
  }
  .sb-txt b {
    font-size: 17px;
  }
  .sb-txt small {
    color: var(--ink-2);
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sb-edit {
    color: var(--fire);
    font-weight: 700;
    font-size: 15px;
  }
  .tools {
    position: sticky;
    top: 58px;
    z-index: 30;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .tools[hidden],
  .f-back[hidden] {
    display: none;
  }
  .tools-in {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .tool {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
    cursor: pointer;
  }
  .tool + .tool {
    border-inline-start: 1px solid var(--line);
  }
  .tool select {
    position: absolute;
    inset: 0;
    opacity: 0;
    font-size: 16px;
    cursor: pointer;
  }
  .f-close,
  .f-apply {
    display: none;
  }
  .res {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 32px;
    align-items: start;
    padding-block: 32px 80px;
  }
  .filters {
    position: sticky;
    top: 90px;
    display: grid;
    gap: 22px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .res:has(.filters[hidden]) {
    grid-template-columns: 1fr;
    max-width: 880px;
  }
  .filters[hidden],
  .sort[hidden] {
    display: none;
  }
  .f-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .f-head h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    margin: 0;
  }
  .f-count:not(:empty) {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--fire);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }
  .f-reset {
    border: 0;
    background: none;
    color: var(--fire-dark);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  legend {
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 10px;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--fire);
  }
  output {
    font-size: 14px;
    color: var(--ink-2);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pills button {
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .pills button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .checks label {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 15px;
    cursor: pointer;
  }
  .checks input {
    width: 18px;
    height: 18px;
    accent-color: var(--fire);
  }

  .main {
    min-width: 0;
  }
  .r-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 18px;
  }
  .r-head h1 {
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    margin: 0 0 4px;
  }
  .r-head p {
    margin: 0;
    color: var(--ink-2);
  }
  .sort {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  .sort select {
    font: inherit;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
  }
  .compare {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 14px 16px;
    border-radius: var(--r);
    background: var(--soft);
    margin-bottom: 18px;
    font-size: 14px;
    font-weight: 600;
  }
  .compare[hidden] {
    display: none;
  }
  .aff {
    margin: -6px 0 16px;
    font-size: 13px;
    color: var(--muted);
  }
  .compare-note {
    margin: -10px 0 18px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .compare-note[hidden] {
    display: none;
  }
  #compare-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  #compare-links :global(a) {
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    font-weight: 700;
  }
  #compare-links :global(a:hover) {
    border-color: var(--ink);
  }
  .demo {
    padding: 12px 16px;
    border-radius: var(--r);
    background: #fff4d6;
    font-weight: 600;
  }
  .demo[hidden] {
    display: none;
  }
  .list {
    display: grid;
    gap: 16px;
  }
  .scan {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 16px 20px;
    margin-bottom: 16px;
    border-radius: var(--r-lg);
    background: var(--warm);
  }
  .scan[hidden] {
    display: none;
  }
  .scan b {
    display: block;
    font-size: 17px;
  }
  .scan span {
    color: var(--ink-2);
    font-size: 14px;
  }
  .radar {
    position: relative;
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    background:
      radial-gradient(circle, transparent 0 30%, rgba(10, 92, 255, 0.18) 31% 32%, transparent 33% 62%, rgba(10, 92, 255, 0.18) 63% 64%, transparent 65%),
      #fff;
    box-shadow: inset 0 0 0 2px rgba(10, 92, 255, 0.25);
  }
  .radar .sw {
    position: absolute;
    inset: 0;
    background: conic-gradient(from 0deg, rgba(10, 124, 255, 0.55), rgba(0, 201, 167, 0.15) 22%, transparent 30%);
    animation: spin 1.4s linear infinite;
  }
  .radar i {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fire);
    animation: ping 1.4s ease-out infinite;
  }
  .radar i:nth-of-type(1) {
    top: 18%;
    left: 60%;
  }
  .radar i:nth-of-type(2) {
    top: 58%;
    left: 22%;
    animation-delay: 0.45s;
  }
  .radar i:nth-of-type(3) {
    top: 66%;
    left: 70%;
    animation-delay: 0.9s;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes ping {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    20% {
      opacity: 1;
      transform: scale(1.2);
    }
    100% {
      opacity: 0;
      transform: scale(0.8);
    }
  }
  .more {
    display: flex;
    margin: 24px auto 0;
  }
  .more[hidden],
  .more-note[hidden],
  .checked[hidden] {
    display: none;
  }
  .more-note {
    text-align: center;
    color: var(--ink-2);
    margin-top: 16px;
  }
  .checked {
    margin: 0 0 12px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .empty {
    padding: 40px;
    text-align: center;
    border-radius: var(--r-lg);
    background: var(--soft);
  }
  .links[hidden] {
    display: none;
  }
  .links h2 {
    font-size: clamp(21px, 2.4vw, 26px);
    margin-bottom: 6px;
  }
  .why-links {
    margin: 0 0 22px;
    padding: 12px 16px;
    border-radius: var(--r);
    background: #fff4d6;
    color: var(--sun-ink);
    font-weight: 600;
  }
  .why-links:empty {
    display: none;
  }
  .links-note {
    margin: 0 0 18px;
    padding: 12px 16px;
    border-radius: var(--r);
    background: var(--soft);
    color: var(--ink-2);
    font-size: 15px;
  }
  .links-note b {
    color: var(--ink);
  }
  .links-note a {
    color: var(--brand);
    text-decoration: underline;
  }
  .links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .links :global(li) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: #fff;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .links :global(li:hover) {
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }
  .links :global(.lk-mark) {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--a) 16%, #fff);
    color: color-mix(in srgb, var(--a) 70%, #000);
    font-size: 22px;
    font-weight: 800;
  }
  .links :global(.lk-go) {
    white-space: nowrap;
  }
  .links :global(h3) {
    font-size: 19px;
    margin: 0 0 2px;
  }
  .links :global(p) {
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  .links :global(.tip) {
    color: var(--muted);
    margin-top: 4px;
  }
  .fine {
    margin-top: 28px;
    font-size: 13px;
    color: var(--muted);
  }
  .fine a {
    color: var(--ink-2);
    text-decoration: underline;
  }
  @media (max-width: 960px) {
    .res {
      grid-template-columns: 1fr;
      padding-top: 18px;
    }
    .res:has(.filters[hidden]) {
      max-width: none;
    }
    /* Filters become a bottom sheet. */
    .filters {
      position: fixed;
      inset: auto 0 0 0;
      top: auto;
      z-index: 60;
      max-height: 86vh;
      overflow-y: auto;
      padding: 20px 20px max(20px, env(safe-area-inset-bottom));
      border: 0;
      border-radius: 24px 24px 0 0;
      background: #fff;
      box-shadow: 0 -20px 50px -20px rgba(6, 30, 110, 0.35);
      transform: translateY(105%);
      visibility: hidden;
      transition:
        transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
        visibility 0s 0.35s;
    }
    .filters.open {
      transform: none;
      visibility: visible;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .f-head {
      gap: 14px;
    }
    .f-head h2 {
      margin-inline-end: auto;
    }
    .f-close {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border: 0;
      border-radius: 50%;
      background: var(--soft);
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
    }
    .f-apply {
      display: flex;
      width: 100%;
      border-radius: 12px;
    }
    .f-back {
      position: fixed;
      inset: 0;
      z-index: 55;
      background: rgba(10, 20, 50, 0.45);
    }
    .r-head .sort {
      display: none;
    }
    .r-head {
      margin-bottom: 12px;
    }
    .r-head h1 {
      font-size: 24px;
    }
    .r-head p {
      font-size: 14.5px;
      line-height: 1.45;
    }
    .demo {
      padding: 10px 14px;
      font-size: 14px;
      font-weight: 500;
    }
    .list {
      gap: 12px;
    }
    .compare {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: -20px;
      padding: 12px 20px;
      border-radius: 0;
      white-space: nowrap;
    }
    #compare-links {
      flex-wrap: nowrap;
    }
  }
  @media (min-width: 961px) {
    .tools {
      display: none;
    }
  }
  @media (min-width: 761px) {
    .sum-bar {
      display: none !important;
    }
  }
  @media (max-width: 760px) {
    .top {
      padding-block: 10px 14px;
    }
    .top.has-q .top-form:not(.open) {
      display: none;
    }
    .top.has-q .top-form.open {
      margin-top: 10px;
    }
  }
  @media (max-width: 560px) {
    .links :global(li) {
      grid-template-columns: auto 1fr;
      gap: 12px 14px;
    }
    .links :global(.btn) {
      grid-column: 1 / -1;
      justify-content: center;
    }
  }
</style>

<script>
  import { adultsHe, kidsHe } from '../lib/he';
  import { pageLive } from '../lib/pagemode';
  import { partners, childNote, nights as countNights, type Partner } from '../lib/partners';
  import { hotelCard, skeleton, money } from '../lib/hotelcard';
  import { canonicalSearch } from '../lib/searchkey';
  import type { Hotel } from '../lib/agoda';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const p = new URLSearchParams(location.search);
  const label = (p.get('d') || '').trim();
  const q = (p.get('q') || label).trim();
  const dateRe = /^\d{4}-\d{2}-\d{2}$/;
  const checkin = dateRe.test(p.get('in') || '') ? p.get('in')! : undefined;
  const checkoutRaw = dateRe.test(p.get('out') || '') ? p.get('out')! : undefined;
  const checkout = checkin && checkoutRaw && checkoutRaw > checkin ? checkoutRaw : undefined;
  const int = (k: string, def: number, min: number, max: number) => {
    const v = Number(p.get(k));
    return p.has(k) && Number.isInteger(v) && v >= min && v <= max ? v : def;
  };
  const query = {
    q,
    checkin,
    checkout,
    adults: int('a', 2, 1, 16),
    children: int('c', 0, 0, 10),
    rooms: int('r', 1, 1, 8),
    childAges: p
      .getAll('ca')
      .map(Number)
      .filter((n) => Number.isInteger(n) && n >= 0 && n <= 17),
    source: 'search',
  };
  const nights = countNights(query);
  const esc = (t: string) => t.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const fmt = (d: string) =>
    new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'short' }).format(new Date(d + 'T12:00:00'));

  // Filter state lives in the URL so results can be shared and survive reloads.
  const state = {
    sort: p.get('sort') || 'Recommended',
    stars: int('stars', 0, 0, 5),
    score: int('score', 0, 0, 10),
    max: int('max', 3000, 200, 3000),
    deal: p.get('deal') === '1',
    bf: p.get('bf') === '1',
    deep: false,
  };

  let hotels: Hotel[] = [];
  let mode = '';

  // ---------- header + compare chips ----------
  if (q) {
    const where = label || q;
    $('r-title').textContent = `מלונות ב${where}`;
    document.title = `מלונות ב${where} | מלונזול`;
    const parts = [
      checkin && checkout ? `${fmt(checkin)} – ${fmt(checkout)}` : 'תאריכים גמישים',
      nights ? `${nights} לילות` : '',
      adultsHe(query.adults),
      query.children ? kidsHe(query.children) : '',
    ].filter(Boolean);
    $('r-sum').textContent = parts.join(' · ');
    // Phones: a compact summary bar stands in for the full form until tapped.
    $('sb-where').textContent = where;
    $('sb-when').textContent = parts.join(' · ');
    const bar = $('sum-bar');
    const form = $('top-form');
    bar.hidden = false;
    bar.closest('.top')!.classList.add('has-q');
    bar.addEventListener('click', () => {
      const open = form.classList.toggle('open');
      bar.setAttribute('aria-expanded', String(open));
    });
    $('tools').hidden = false;
    $('compare-links').innerHTML = partners
      .map((x) => `<a href="${esc(x.build(query))}" target="_blank" rel="sponsored noopener"><span dir="ltr">${x.name}</span></a>`)
      .join('');
    if (query.children) {
      const keeps = partners.filter((x) => x.passesChildAges).map((x) => x.name);
      $('compare-note').textContent = `פרטי הילדים מצורפים לקישור ל-${keeps.join(', ')}: ודאו שהם מופיעים נכון באתר. בשאר האתרים הזינו אותם שם מחדש.`;
      $('compare-note').hidden = false;
    }
    $('compare').hidden = false;
  }

  // What each site opens with, so people can trust the hand-off before they click.
  const carried = (x: Partner) => {
    const bits = [checkin && checkout ? `${fmt(checkin)} – ${fmt(checkout)}` : 'בלי תאריכים', adultsHe(query.adults)];
    if (query.children) bits.push(x.passesChildAges ? `${kidsHe(query.children)} כולל הגילאים` : kidsHe(query.children));
    return `נפתח עם ${bits.join(' · ')}`;
  };

  // ---------- partner list (no live prices for this destination/dates) ----------
  function showLinks(why: string) {
    $('links-why').textContent = why;
    $('filters').hidden = true;
    $('tools').hidden = true;
    ($('f-sort').closest('.sort') as HTMLElement).hidden = true;
    $('compare').hidden = true;
    $('compare-note').hidden = true;
    $('list').innerHTML = '';
    const asia = /Thailand|Dubai|Abu Dhabi|Emirates|Japan|Vietnam|Bali|Georgia|India|תאילנד|דובאי/i;
    const usa = /USA|New York|United States|Miami|Las Vegas|Canada|ניו יורק|ארה"ב/i;
    const order: Partner['id'][] = asia.test(q + label)
      ? ['agoda', 'trip', 'booking', 'hotelscom', 'expedia']
      : usa.test(q + label)
        ? ['expedia', 'hotelscom', 'booking', 'agoda', 'trip']
        : ['booking', 'agoda', 'hotelscom', 'expedia', 'trip'];
    $('links-list').innerHTML = order
      .map((id) => {
        const x = partners.find((y) => y.id === id)!;
        return `<li style="--a:${x.accent}">
          <span class="lk-mark" aria-hidden="true">${x.name.charAt(0)}</span>
          <div class="lk-txt"><h3><bdi>${x.name}</bdi></h3><p>${carried(x)}</p>${childNote(x, query) ? `<p class="tip">${childNote(x, query)}</p>` : ''}</div>
          <a class="btn btn-fire lk-go" href="${esc(x.build(query))}" target="_blank" rel="sponsored noopener"><span>לחיפוש ב-<bdi>${x.name}</bdi></span> <span class="arrow" aria-hidden="true">←</span></a>
        </li>`;
      })
      .join('');
    $('links').hidden = false;
  }

  // ---------- live results ----------
  function render() {
    const shown = state.bf ? hotels.filter((h) => h.breakfast) : hotels;
    const list = $('list');
    if (!shown.length) {
      const filtered = state.stars || state.score || state.max < 3000 || state.deal || state.bf;
      list.innerHTML = filtered
        ? `<div class="empty"><h3>לא מצאנו מלונות שמתאימים לסינון</h3><p>נסו להרחיב את טווח המחיר או לנקות את הסינון. אפשר גם לבדוק ישירות באתרים למעלה.</p></div>`
        : `<div class="empty"><h3>לא התקבלו הצעות מ-Agoda לחיפוש הזה</h3><p>החיבור לא החזיר חדרים לתאריכים ולהרכב האורחים האלה, וזה לא בהכרח אומר שאין חדרים באתר. אפשר לנסות תאריכים אחרים או לבדוק ישירות באתרים למעלה.</p></div>`;
      $('more').hidden = true;
      return;
    }
    const cheapest = Math.min(...shown.map((h) => h.rate));
    $('r-sum').textContent =
      $('r-sum').textContent!.split(' | ')[0] + ` | ${shown.length} מלונות, החל מ-${money(cheapest)} ללילה`;
    list.innerHTML = shown.map((h) => hotelCard(h, { ...query, city: q.split(',')[0] })).join('');
    $('more').hidden = state.deep || shown.length < 20;
  }

  let ctrl: AbortController | undefined;
  async function load() {
    if (!q) return;
    // Links-only deployments never ask for prices; the search opens on the partner sites.
    if (!pageLive()) return showLinks(''); // links mode: the list's own note says it
    if (!checkin || !checkout) return showLinks('בחרו תאריכים כדי לראות מחירים. בינתיים אפשר לבדוק ישירות באתרים:');
    if (query.rooms > 1) return showLinks('מחירים חיים זמינים אצלנו כרגע רק לחדר אחד. ליותר מחדר אחד בדקו ישירות באתרים:');
    if (query.children && query.childAges.length !== query.children)
      return showLinks('כדי לראות מחירים לילדים צריך לבחור את הגיל של כל ילד בחיפוש. בינתיים אפשר לבדוק ישירות באתרים:');
    ctrl?.abort();
    ctrl = new AbortController();
    if (!state.deep) $('list').innerHTML = skeleton(4);
    $('more').hidden = true;
    $('more-note').hidden = true;
    const scan = $('scan');
    scan.hidden = false;
    const started = Date.now();
    const done = () => window.setTimeout(() => (scan.hidden = true), Math.max(0, 600 - (Date.now() - started)));
    const api = {
      q,
      d: label,
      slug: p.get('slug') || '',
      in: checkin,
      out: checkout,
      a: String(query.adults),
      c: String(query.children),
      ages: query.childAges.join(','),
      sort: state.sort,
      stars: String(state.stars),
      score: String(state.score),
      deal: state.deal ? '1' : '0',
      deep: state.deep ? '1' : '',
      max: state.max < 3000 ? String(state.max) : '',
    };
    try {
      const res = await fetch(`/api/search?${canonicalSearch(api)}`, { signal: ctrl.signal });
      const data = await res.json();
      mode = data.mode;
      done();
      if (mode !== 'live' && mode !== 'demo')
        return showLinks(
          data.error
            ? 'לא הצלחנו לקבל מחירים כרגע. אפשר לבדוק ישירות באתרים:'
            : 'ליעד הזה עוד אין לנו מחירים חיים. אפשר לבדוק ישירות באתרים:',
        );
      $('demo').hidden = mode !== 'demo';
      if (data.checkedAt) {
        const t = new Intl.DateTimeFormat('he-IL', { hour: '2-digit', minute: '2-digit' }).format(new Date(data.checkedAt));
        $('checked').textContent = mode === 'demo' ? 'נתוני דוגמה, לא מחירים אמיתיים.' : `המחירים נבדקו ב-Agoda בשעה ${t}. הם עשויים להשתנות עד ההזמנה.`;
        $('checked').hidden = false;
      }
      const before = new Set(hotels.map((h) => h.id));
      hotels = data.hotels || [];
      render();
      // "Show more" reports honestly whether it found anything new.
      if (state.deep && before.size) {
        const added = hotels.filter((h) => !before.has(h.id)).length;
        $('more-note').textContent = added ? `נוספו ${added} מלונות.` : 'לא נמצאו מלונות נוספים לחיפוש הזה ב-Agoda.';
        $('more-note').hidden = false;
      }
    } catch (e) {
      if ((e as Error).name !== 'AbortError') {
        done();
        showLinks('לא הצלחנו לקבל מחירים כרגע. אפשר לבדוק ישירות באתרים:');
      }
    }
  }

  // ---------- filter controls ----------
  function syncUrl() {
    const u = new URL(location.href);
    const set = (k: string, v: string, def: string) => (v === def ? u.searchParams.delete(k) : u.searchParams.set(k, v));
    set('sort', state.sort, 'Recommended');
    set('stars', String(state.stars), '0');
    set('score', String(state.score), '0');
    set('max', String(state.max), '3000');
    set('deal', state.deal ? '1' : '0', '0');
    set('bf', state.bf ? '1' : '0', '0');
    history.replaceState(null, '', u);
  }
  let t: number | undefined;
  const refetch = () => {
    syncUrl();
    clearTimeout(t);
    t = window.setTimeout(load, 250);
  };

  const sortSel = $<HTMLSelectElement>('f-sort');
  const sortM = $<HTMLSelectElement>('f-sort-m');
  sortSel.value = sortM.value = state.sort;
  for (const sel of [sortSel, sortM]) {
    sel.addEventListener('change', () => {
      state.sort = sortSel.value = sortM.value = sel.value;
      refetch();
    });
  }

  const maxIn = $<HTMLInputElement>('f-max');
  const maxOut = $('f-max-out');
  const showMax = () => (maxOut.textContent = state.max >= 3000 ? 'ללא הגבלה' : money(state.max));
  maxIn.value = String(state.max);
  showMax();
  maxIn.addEventListener('input', () => {
    state.max = Number(maxIn.value);
    showMax();
  });
  maxIn.addEventListener('change', refetch);

  document.querySelectorAll<HTMLElement>('.pills').forEach((group) => {
    const key = group.dataset.f as 'stars' | 'score';
    const btns = group.querySelectorAll<HTMLButtonElement>('button');
    const paint = () => btns.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.v) === state[key])));
    paint();
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        state[key] = Number(b.dataset.v);
        paint();
        refetch();
      }),
    );
  });

  const deal = $<HTMLInputElement>('f-deal');
  const bf = $<HTMLInputElement>('f-bf');
  deal.checked = state.deal;
  bf.checked = state.bf;
  deal.addEventListener('change', () => {
    state.deal = deal.checked;
    refetch();
  });
  bf.addEventListener('change', () => {
    state.bf = bf.checked;
    syncUrl();
    if (hotels.length) render();
  });

  $('f-reset').addEventListener('click', () => {
    Object.assign(state, { sort: 'Recommended', stars: 0, score: 0, max: 3000, deal: false, bf: false });
    sortSel.value = sortM.value = state.sort;
    maxIn.value = '3000';
    showMax();
    deal.checked = bf.checked = false;
    document.querySelectorAll<HTMLButtonElement>('.pills button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === '0')));
    refetch();
  });

  // Bottom sheet on phones.
  const fOpen = $('f-open');
  const fBack = $('f-back');
  // On phones the panel is a modal dialog: focus moves in, stays in, and returns to the opener.
  const panel = $('filters');
  const focusables = () =>
    [...panel.querySelectorAll<HTMLElement>('button, input, select, [tabindex]:not([tabindex="-1"])')].filter((el) => el.offsetParent);
  const sheet = (open: boolean) => {
    if (open === panel.classList.contains('open')) return;
    panel.classList.toggle('open', open);
    fBack.hidden = !open;
    fOpen.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) {
      panel.setAttribute('role', 'dialog');
      panel.setAttribute('aria-modal', 'true');
      setTimeout(() => $('f-close').focus(), 50);
    } else {
      panel.removeAttribute('role');
      panel.removeAttribute('aria-modal');
      fOpen.focus();
    }
  };
  fOpen.addEventListener('click', () => sheet(true));
  for (const id of ['f-close', 'f-apply', 'f-back']) $(id).addEventListener('click', () => sheet(false));
  addEventListener('keydown', (e) => {
    if (!panel.classList.contains('open')) return;
    if (e.key === 'Escape') return sheet(false);
    if (e.key !== 'Tab') return;
    const list = focusables();
    const first = list[0];
    const last = list[list.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    } else if (!panel.contains(document.activeElement)) {
      e.preventDefault();
      first.focus();
    }
  });
  const countActive = () => {
    const n = [state.stars > 0, state.score > 0, state.max < 3000, state.deal, state.bf].filter(Boolean).length;
    $('f-count').textContent = $('f-count-m').textContent = n ? String(n) : '';
  };
  countActive();
  document.getElementById('filters')!.addEventListener('click', () => setTimeout(countActive));
  document.getElementById('filters')!.addEventListener('change', countActive);

  $('more').addEventListener('click', () => {
    state.deep = true;
    load();
  });

  load();
</script>
