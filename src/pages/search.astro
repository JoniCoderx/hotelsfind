---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import { href } from '../lib/url';
---
<Base title="תוצאות חיפוש | מלונזול" description="מחירי מלונות בזמן אמת והשוואה בין Agoda, Booking, Expedia, Hotels.com ו-Trip.com." noindex>
  <section class="top">
    <div class="wrap">
      <SearchForm />
    </div>
  </section>

  <div class="wrap res">
    <aside class="filters" id="filters" aria-label="סינון">
      <div class="f-head">
        <button type="button" class="f-toggle" id="f-toggle" aria-expanded="false" aria-controls="filters">
          <h2>סינון</h2><span class="f-count" id="f-count"></span><span class="f-chev" aria-hidden="true">▾</span>
        </button>
        <button type="button" class="f-reset" id="f-reset">ניקוי</button>
      </div>
      <fieldset>
        <legend>מחיר ללילה עד</legend>
        <input type="range" id="f-max" min="200" max="3000" step="50" value="3000" />
        <output id="f-max-out">ללא הגבלה</output>
      </fieldset>
      <fieldset>
        <legend>כוכבים</legend>
        <div class="pills" data-f="stars">
          <button type="button" data-v="0" aria-pressed="true">הכל</button>
          <button type="button" data-v="3" aria-pressed="false">3+</button>
          <button type="button" data-v="4" aria-pressed="false">4+</button>
          <button type="button" data-v="5" aria-pressed="false">5</button>
        </div>
      </fieldset>
      <fieldset>
        <legend>ציון אורחים</legend>
        <div class="pills" data-f="score">
          <button type="button" data-v="0" aria-pressed="true">הכל</button>
          <button type="button" data-v="7" aria-pressed="false">7+</button>
          <button type="button" data-v="8" aria-pressed="false">8+</button>
          <button type="button" data-v="9" aria-pressed="false">9+</button>
        </div>
      </fieldset>
      <fieldset class="checks">
        <legend>עוד</legend>
        <label><input type="checkbox" id="f-deal" /> רק דילים במבצע</label>
        <label><input type="checkbox" id="f-bf" /> ארוחת בוקר כלולה</label>
      </fieldset>
    </aside>

    <section class="main" aria-live="polite">
      <div class="r-head">
        <div>
          <h1 id="r-title">מלונות במחיר הכי טוב</h1>
          <p id="r-sum">בחרו יעד ותאריכים כדי לראות מחירים.</p>
        </div>
        <label class="sort">
          <span>מיון</span>
          <select id="f-sort">
            <option value="Recommended">מומלץ</option>
            <option value="PriceAsc">המחיר הנמוך ביותר</option>
            <option value="AllGuestsReviewScore">ציון אורחים</option>
            <option value="StarRatingDesc">כוכבים</option>
          </select>
        </label>
      </div>

      <div class="compare" id="compare" hidden>
        <span>השוו את אותו חיפוש גם ב:</span>
        <div id="compare-links"></div>
      </div>

      <p class="demo" id="demo" hidden>נתוני דוגמה בלבד: מפתח Agoda עוד לא מחובר, השמות והמחירים כאן לא אמיתיים.</p>

      <div class="scan" id="scan" hidden aria-live="polite">
        <div class="radar" aria-hidden="true"><span class="sw"></span><i></i><i></i><i></i></div>
        <div>
          <b>סורקים את כל אתרי ההזמנות…</b>
          <span>בודקים עכשיו: <bdi id="scan-site">Agoda</bdi></span>
        </div>
      </div>
      <div id="list" class="list"></div>
      <button type="button" class="btn btn-line more" id="more" hidden>הצג עוד מלונות</button>

      <div id="links" class="links" hidden>
        <h2>בחרו אתר, החיפוש שלכם כבר מחכה שם</h2>
        <ol id="links-list"></ol>
      </div>

      <noscript><p>כדי לראות מחירים יש להפעיל JavaScript בדפדפן.</p></noscript>
      <p class="fine">
        המחירים מגיעים מאתרי ההזמנות בזמן אמת, ללילה ולפני מיסים, ועשויים להשתנות. ההזמנה מתבצעת באתר השותף, ואנו עשויים לקבל
        עמלה ללא עלות נוספת עבורכם. <a href={href('/disclosure/')}>גילוי נאות</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .top {
    background: var(--warm);
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }
  .res {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 32px;
    align-items: start;
    padding-block: 32px 80px;
  }
  .filters {
    position: sticky;
    top: 90px;
    display: grid;
    gap: 22px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .res:has(.filters[hidden]) {
    grid-template-columns: 1fr;
    max-width: 880px;
  }
  .filters[hidden],
  .sort[hidden] {
    display: none;
  }
  .f-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .f-head h2 {
    font-size: 18px;
    margin: 0;
  }
  .f-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: default;
  }
  .f-chev {
    display: none;
  }
  .f-count:not(:empty) {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--fire);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }
  .f-reset {
    border: 0;
    background: none;
    color: var(--fire-dark);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  legend {
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 10px;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--fire);
  }
  output {
    font-size: 14px;
    color: var(--ink-2);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pills button {
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .pills button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .checks label {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 15px;
    cursor: pointer;
  }
  .checks input {
    width: 18px;
    height: 18px;
    accent-color: var(--fire);
  }

  .r-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 18px;
  }
  .r-head h1 {
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    margin: 0 0 4px;
  }
  .r-head p {
    margin: 0;
    color: var(--ink-2);
  }
  .sort {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  .sort select {
    font: inherit;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
  }
  .compare {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 14px 16px;
    border-radius: var(--r);
    background: var(--soft);
    margin-bottom: 18px;
    font-size: 14px;
    font-weight: 600;
  }
  .compare[hidden] {
    display: none;
  }
  #compare-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  #compare-links :global(a) {
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    font-weight: 700;
  }
  #compare-links :global(a:hover) {
    border-color: var(--ink);
  }
  .demo {
    padding: 12px 16px;
    border-radius: var(--r);
    background: #fff4d6;
    font-weight: 600;
  }
  .demo[hidden] {
    display: none;
  }
  .list {
    display: grid;
    gap: 16px;
  }
  .scan {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 16px 20px;
    margin-bottom: 16px;
    border-radius: var(--r-lg);
    background: var(--warm);
  }
  .scan[hidden] {
    display: none;
  }
  .scan b {
    display: block;
    font-size: 17px;
  }
  .scan span {
    color: var(--ink-2);
    font-size: 14px;
  }
  .radar {
    position: relative;
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    background:
      radial-gradient(circle, transparent 0 30%, rgba(10, 92, 255, 0.18) 31% 32%, transparent 33% 62%, rgba(10, 92, 255, 0.18) 63% 64%, transparent 65%),
      #fff;
    box-shadow: inset 0 0 0 2px rgba(10, 92, 255, 0.25);
  }
  .radar .sw {
    position: absolute;
    inset: 0;
    background: conic-gradient(from 0deg, rgba(10, 124, 255, 0.55), rgba(0, 201, 167, 0.15) 22%, transparent 30%);
    animation: spin 1.4s linear infinite;
  }
  .radar i {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fire);
    animation: ping 1.4s ease-out infinite;
  }
  .radar i:nth-of-type(1) {
    top: 18%;
    left: 60%;
  }
  .radar i:nth-of-type(2) {
    top: 58%;
    left: 22%;
    animation-delay: 0.45s;
  }
  .radar i:nth-of-type(3) {
    top: 66%;
    left: 70%;
    animation-delay: 0.9s;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes ping {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    20% {
      opacity: 1;
      transform: scale(1.2);
    }
    100% {
      opacity: 0;
      transform: scale(0.8);
    }
  }
  .more {
    display: flex;
    margin: 24px auto 0;
  }
  .more[hidden] {
    display: none;
  }
  .empty {
    padding: 40px;
    text-align: center;
    border-radius: var(--r-lg);
    background: var(--soft);
  }
  .links[hidden] {
    display: none;
  }
  .links h2 {
    font-size: 20px;
    margin-bottom: 14px;
  }
  .links ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .links :global(li) {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .links :global(li.top) {
    border-color: var(--fire);
    box-shadow: 0 0 0 3px rgba(10, 92, 255, 0.12);
  }
  .links :global(.n) {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--soft);
    font-weight: 700;
    font-size: 20px;
  }
  .links :global(li.top .n) {
    background: var(--fire-grad);
    color: #fff;
  }
  .links :global(h3) {
    font-size: 19px;
    margin: 0 0 2px;
  }
  .links :global(p) {
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  .links :global(.tip) {
    color: var(--muted);
    margin-top: 4px;
  }
  .fine {
    margin-top: 28px;
    font-size: 13px;
    color: var(--muted);
  }
  .fine a {
    color: var(--ink-2);
    text-decoration: underline;
  }
  @media (max-width: 960px) {
    .res {
      grid-template-columns: 1fr;
    }
    .filters {
      position: static;
      grid-template-columns: 1fr 1fr;
      padding: 14px 18px;
    }
    .filters:not(.open) fieldset {
      display: none;
    }
    .f-head {
      grid-column: 1 / -1;
    }
    .f-toggle {
      cursor: pointer;
    }
    .f-chev {
      display: inline;
      transition: transform 0.2s;
    }
    .open .f-chev {
      transform: rotate(180deg);
    }
  }
  @media (max-width: 560px) {
    .filters {
      grid-template-columns: 1fr;
    }
    .links :global(li) {
      grid-template-columns: 40px 1fr;
    }
    .links :global(.btn) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { partners, nights as countNights, type Partner } from '../lib/partners';
  import { hotelCard, skeleton, money } from '../lib/hotelcard';
  import type { Hotel } from '../lib/agoda';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const p = new URLSearchParams(location.search);
  const label = (p.get('d') || '').trim();
  const q = (p.get('q') || label).trim();
  const dateRe = /^\d{4}-\d{2}-\d{2}$/;
  const checkin = dateRe.test(p.get('in') || '') ? p.get('in')! : undefined;
  const checkoutRaw = dateRe.test(p.get('out') || '') ? p.get('out')! : undefined;
  const checkout = checkin && checkoutRaw && checkoutRaw > checkin ? checkoutRaw : undefined;
  const int = (k: string, def: number, min: number, max: number) => {
    const v = Number(p.get(k));
    return p.has(k) && Number.isInteger(v) && v >= min && v <= max ? v : def;
  };
  const query = {
    q,
    checkin,
    checkout,
    adults: int('a', 2, 1, 16),
    children: int('c', 0, 0, 10),
    rooms: int('r', 1, 1, 8),
    source: 'search',
  };
  const nights = countNights(query);
  const esc = (t: string) => t.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const fmt = (d: string) =>
    new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'short' }).format(new Date(d + 'T12:00:00'));

  // Filter state lives in the URL so results can be shared and survive reloads.
  const state = {
    sort: p.get('sort') || 'Recommended',
    stars: int('stars', 0, 0, 5),
    score: int('score', 0, 0, 10),
    max: int('max', 3000, 200, 3000),
    deal: p.get('deal') === '1',
    bf: p.get('bf') === '1',
    deep: false,
  };

  let hotels: Hotel[] = [];
  let mode = '';

  // ---------- header + compare chips ----------
  if (q) {
    const where = label || q;
    $('r-title').textContent = `מלונות ב${where}`;
    document.title = `מלונות ב${where} | מלונזול`;
    const parts = [
      checkin && checkout ? `${fmt(checkin)} – ${fmt(checkout)}` : 'תאריכים גמישים',
      nights ? `${nights} לילות` : '',
      query.adults === 1 ? 'מבוגר 1' : `${query.adults} מבוגרים`,
      query.children ? (query.children === 1 ? 'ילד 1' : `${query.children} ילדים`) : '',
    ].filter(Boolean);
    $('r-sum').textContent = parts.join(' · ');
    $('compare-links').innerHTML = partners
      .map((x) => `<a href="${esc(x.build(query))}" target="_blank" rel="sponsored noopener"><span dir="ltr">${x.name}</span></a>`)
      .join('');
    $('compare').hidden = false;
  }

  // ---------- partner list (no live prices for this destination/dates) ----------
  function showLinks() {
    $('filters').hidden = true;
    ($('f-sort').closest('.sort') as HTMLElement).hidden = true;
    $('compare').hidden = true;
    $('list').innerHTML = '';
    const asia = /Thailand|Dubai|Abu Dhabi|Emirates|Japan|Vietnam|Bali|Georgia|India|תאילנד|דובאי/i;
    const usa = /USA|New York|United States|Miami|Las Vegas|Canada|ניו יורק|ארה"ב/i;
    const order: Partner['id'][] = asia.test(q + label)
      ? ['agoda', 'trip', 'booking', 'hotelscom', 'expedia']
      : usa.test(q + label)
        ? ['expedia', 'hotelscom', 'booking', 'agoda', 'trip']
        : ['booking', 'agoda', 'hotelscom', 'expedia', 'trip'];
    $('links-list').innerHTML = order
      .map((id, i) => {
        const x = partners.find((y) => y.id === id)!;
        return `<li class="${i === 0 ? 'top' : ''}">
          <span class="n">${i + 1}</span>
          <div><h3 dir="ltr" style="text-align:right">${x.name}</h3><p>${esc(x.pitch)}</p><p class="tip">${esc(x.tip)}</p></div>
          <a class="btn ${i === 0 ? 'btn-fire' : 'btn-line'}" href="${esc(x.build(query))}" target="_blank" rel="sponsored noopener"><span>למחירים ב-<bdi>${x.name}</bdi></span></a>
        </li>`;
      })
      .join('');
    $('links').hidden = false;
  }

  // ---------- live results ----------
  function render() {
    const shown = state.bf ? hotels.filter((h) => h.breakfast) : hotels;
    const list = $('list');
    if (!shown.length) {
      list.innerHTML = `<div class="empty"><h3>לא מצאנו מלונות שמתאימים לסינון</h3><p>נסו להרחיב את טווח המחיר או לנקות את הסינון. אפשר גם לבדוק ישירות באתרים למעלה.</p></div>`;
      $('more').hidden = true;
      return;
    }
    const cheapest = Math.min(...shown.map((h) => h.rate));
    $('r-sum').textContent =
      $('r-sum').textContent!.split(' | ')[0] + ` | ${shown.length} מלונות, החל מ-${money(cheapest)} ללילה`;
    list.innerHTML = shown.map((h) => hotelCard(h, { ...query, city: q.split(',')[0] }, nights)).join('');
    $('more').hidden = state.deep || shown.length < 20;
  }

  let ctrl: AbortController | undefined;
  async function load() {
    if (!q) return;
    if (!checkin || !checkout) return showLinks();
    ctrl?.abort();
    ctrl = new AbortController();
    $('list').innerHTML = skeleton(4);
    $('more').hidden = true;
    const scan = $('scan');
    const names = partners.map((x) => x.name);
    let k = 0;
    scan.hidden = false;
    const tick = window.setInterval(() => ($('scan-site').textContent = names[++k % names.length]), 320);
    const started = Date.now();
    const done = () =>
      window.setTimeout(() => {
        clearInterval(tick);
        scan.hidden = true;
      }, Math.max(0, 900 - (Date.now() - started)));
    const api = new URLSearchParams({
      q,
      d: label,
      slug: p.get('slug') || '',
      in: checkin,
      out: checkout,
      a: String(query.adults),
      c: String(query.children),
      sort: state.sort,
      stars: String(state.stars),
      score: String(state.score),
      deal: state.deal ? '1' : '0',
      deep: state.deep ? '1' : '0',
    });
    if (state.max < 3000) api.set('max', String(state.max));
    try {
      const res = await fetch(`/api/search?${api}`, { signal: ctrl.signal });
      const data = await res.json();
      mode = data.mode;
      done();
      if (mode !== 'live' && mode !== 'demo') return showLinks();
      $('demo').hidden = mode !== 'demo';
      hotels = data.hotels || [];
      render();
    } catch (e) {
      if ((e as Error).name !== 'AbortError') {
        done();
        showLinks();
      } else clearInterval(tick);
    }
  }

  // ---------- filter controls ----------
  function syncUrl() {
    const u = new URL(location.href);
    const set = (k: string, v: string, def: string) => (v === def ? u.searchParams.delete(k) : u.searchParams.set(k, v));
    set('sort', state.sort, 'Recommended');
    set('stars', String(state.stars), '0');
    set('score', String(state.score), '0');
    set('max', String(state.max), '3000');
    set('deal', state.deal ? '1' : '0', '0');
    set('bf', state.bf ? '1' : '0', '0');
    history.replaceState(null, '', u);
  }
  let t: number | undefined;
  const refetch = () => {
    syncUrl();
    clearTimeout(t);
    t = window.setTimeout(load, 250);
  };

  const sortSel = $<HTMLSelectElement>('f-sort');
  sortSel.value = state.sort;
  sortSel.addEventListener('change', () => {
    state.sort = sortSel.value;
    refetch();
  });

  const maxIn = $<HTMLInputElement>('f-max');
  const maxOut = $('f-max-out');
  const showMax = () => (maxOut.textContent = state.max >= 3000 ? 'ללא הגבלה' : money(state.max));
  maxIn.value = String(state.max);
  showMax();
  maxIn.addEventListener('input', () => {
    state.max = Number(maxIn.value);
    showMax();
  });
  maxIn.addEventListener('change', refetch);

  document.querySelectorAll<HTMLElement>('.pills').forEach((group) => {
    const key = group.dataset.f as 'stars' | 'score';
    const btns = group.querySelectorAll<HTMLButtonElement>('button');
    const paint = () => btns.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.v) === state[key])));
    paint();
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        state[key] = Number(b.dataset.v);
        paint();
        refetch();
      }),
    );
  });

  const deal = $<HTMLInputElement>('f-deal');
  const bf = $<HTMLInputElement>('f-bf');
  deal.checked = state.deal;
  bf.checked = state.bf;
  deal.addEventListener('change', () => {
    state.deal = deal.checked;
    refetch();
  });
  bf.addEventListener('change', () => {
    state.bf = bf.checked;
    syncUrl();
    if (hotels.length) render();
  });

  $('f-reset').addEventListener('click', () => {
    Object.assign(state, { sort: 'Recommended', stars: 0, score: 0, max: 3000, deal: false, bf: false });
    sortSel.value = state.sort;
    maxIn.value = '3000';
    showMax();
    deal.checked = bf.checked = false;
    document.querySelectorAll<HTMLButtonElement>('.pills button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === '0')));
    refetch();
  });

  const toggle = $('f-toggle');
  toggle.addEventListener('click', () => {
    const open = $('filters').classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  const countActive = () => {
    const n = [state.stars > 0, state.score > 0, state.max < 3000, state.deal, state.bf].filter(Boolean).length;
    $('f-count').textContent = n ? String(n) : '';
  };
  countActive();
  document.getElementById('filters')!.addEventListener('click', () => setTimeout(countActive));
  document.getElementById('filters')!.addEventListener('change', countActive);

  $('more').addEventListener('click', () => {
    state.deep = true;
    load();
  });

  load();
</script>
