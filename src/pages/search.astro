---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import { href } from '../lib/url';
---
<Base title="השוואת מחירים | לילה זול" description="השוו את מחיר המלון שלכם בין Booking, Agoda, Expedia, Hotels.com ו-Trip.com." noindex>
  <section class="top">
    <div class="wrap">
      <p class="kicker">ההשוואה שלכם מוכנה</p>
      <h1 class="display d-xl" id="r-title">מלונות במחיר הכי טוב</h1>
      <p class="lead" id="r-sum">בחרו יעד ותאריכים כדי להשוות.</p>
      <SearchForm />
    </div>
  </section>

  <section class="wrap results" aria-live="polite">
    <ol id="r-list" class="r-list"></ol>
    <noscript><p class="lead">כדי להשוות מחירים יש להפעיל JavaScript בדפדפן.</p></noscript>
    <aside class="how">
      <h2>איך מוציאים מההשוואה את המקסימום</h2>
      <ol>
        <li>פתחו לפחות 3 אתרים. כל קישור נפתח בלשונית חדשה עם החיפוש שלכם מוכן.</li>
        <li>חפשו את אותו מלון בכל אתר והשוו את <b>המחיר הסופי</b> כולל מיסים.</li>
        <li>שימו לב לתנאי ביטול ולארוחת בוקר. לפעמים מחיר מעט גבוה כולל הרבה יותר.</li>
        <li>התחברו לחשבון באתר: מחירי חברים זולים לרוב מהמחיר הציבורי.</li>
      </ol>
      <p class="fine">
        לילה זול הוא אתר השוואה. ההזמנה מתבצעת באתר השותף, ואנו עשויים לקבל עמלה ללא עלות נוספת עבורכם.
        <a href={href('/disclosure/')}>גילוי נאות</a>
      </p>
    </aside>
  </section>
</Base>

<style>
  .top {
    padding-block: 64px 40px;
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
    margin-bottom: 56px;
  }
  .top .lead {
    margin: 18px 0 32px;
  }
  .results {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 56px;
    align-items: start;
    padding-bottom: 110px;
  }
  .r-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--ink);
  }
  .r-list :global(li) {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line-strong);
    animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 0.07s);
  }
  .r-list :global(li.top-pick) {
    background: var(--card);
    margin-inline: -24px;
    padding-inline: 24px;
    box-shadow: inset 4px 0 0 var(--accent);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .r-list :global(.rank) {
    font-family: var(--display);
    font-size: 72px;
    line-height: 0.8;
    color: var(--accent);
  }
  .r-list :global(h2) {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 900;
    margin: 0 0 6px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .r-list :global(.badge) {
    font-size: 12px;
    font-weight: 800;
    padding: 4px 10px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 3px;
  }
  .r-list :global(p) {
    margin: 0;
    color: var(--ink-2);
  }
  .r-list :global(.tip) {
    margin-top: 6px;
    font-size: 15px;
    color: var(--muted);
  }
  .r-list :global(.tip b) {
    color: var(--accent);
  }
  .how {
    position: sticky;
    top: 100px;
    padding: 30px;
    background: var(--night);
    color: var(--paper);
    border-radius: 6px;
  }
  .how h2 {
    font-size: 21px;
  }
  .how ol {
    padding-inline-start: 20px;
    color: rgba(243, 238, 228, 0.75);
    font-size: 15px;
    display: grid;
    gap: 10px;
  }
  .how ol b {
    color: #fff;
  }
  .fine {
    font-size: 13px;
    color: rgba(243, 238, 228, 0.5);
    margin: 18px 0 0;
  }
  .fine a {
    color: var(--moon);
  }
  @media (max-width: 980px) {
    .results {
      grid-template-columns: 1fr;
    }
    .how {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .r-list :global(li) {
      grid-template-columns: 48px 1fr;
      gap: 14px;
    }
    .r-list :global(.rank) {
      font-size: 56px;
    }
    .r-list :global(.btn) {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
</style>

<script>
  import { partners, nights, type Partner } from '../lib/partners';

  const p = new URLSearchParams(location.search);
  const label = (p.get('d') || '').trim();
  const q = (p.get('q') || label).trim();
  const dateRe = /^\d{4}-\d{2}-\d{2}$/;
  const checkin = dateRe.test(p.get('in') || '') ? p.get('in')! : undefined;
  const checkout = dateRe.test(p.get('out') || '') ? p.get('out')! : undefined;
  const int = (k: string, def: number, min: number, max: number) => {
    const v = Number(p.get(k));
    return Number.isInteger(v) && v >= min && v <= max ? v : def;
  };
  const s = {
    q,
    checkin,
    checkout: checkin && checkout && checkout > checkin ? checkout : undefined,
    adults: int('a', 2, 1, 16),
    children: int('c', 0, 0, 10),
    rooms: int('r', 1, 1, 8),
    source: 'search',
  };

  // Suggested order: each partner is strongest in different regions.
  const asia = /Thailand|Dubai|Abu Dhabi|Emirates|Japan|Vietnam|Bali|Indonesia|Singapore|Philippines|Georgia|India|תאילנד|דובאי/i;
  const usa = /USA|New York|United States|Miami|Las Vegas|Los Angeles|Canada|Mexico|ניו יורק|ארה"ב/i;
  const order: Partner['id'][] = asia.test(q + label)
    ? ['agoda', 'trip', 'booking', 'hotelscom', 'expedia']
    : usa.test(q + label)
      ? ['expedia', 'hotelscom', 'booking', 'agoda', 'trip']
      : ['booking', 'agoda', 'hotelscom', 'expedia', 'trip'];
  const ranked = order.map((id) => partners.find((x) => x.id === id)!);

  const fmt = (d: string) =>
    new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'short' }).format(new Date(d + 'T12:00:00'));
  const esc = (t: string) => t.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  const title = document.getElementById('r-title')!;
  const sum = document.getElementById('r-sum')!;
  const list = document.getElementById('r-list')!;

  if (q) {
    title.textContent = `מלונות ב${label || q}`;
    const n = nights(s);
    const parts = [
      s.checkin && s.checkout ? `${fmt(s.checkin)} – ${fmt(s.checkout)}` : 'תאריכים גמישים',
      n ? `${n} לילות` : '',
      s.adults === 1 ? 'מבוגר 1' : `${s.adults} מבוגרים`,
      s.children ? (s.children === 1 ? 'ילד 1' : `${s.children} ילדים`) : '',
      s.rooms > 1 ? `${s.rooms} חדרים` : '',
    ].filter(Boolean);
    sum.textContent = `${parts.join(' · ')}. בחרו אתר, החיפוש שלכם כבר מחכה שם.`;
    document.title = `מלונות ב${label || q} | השוואת מחירים | לילה זול`;

    list.innerHTML = ranked
      .map(
        (x, i) => `
        <li style="--i:${i}" class="${i === 0 ? 'top-pick' : ''}">
          <span class="rank" dir="ltr">${i + 1}</span>
          <div>
            <h2><span dir="ltr">${x.name}</span>${i === 0 ? '<span class="badge">מומלץ ליעד הזה</span>' : ''}</h2>
            <p>${esc(x.pitch)}</p>
            <p class="tip"><b>טיפ:</b> ${esc(x.tip)}</p>
          </div>
          <a class="btn ${i === 0 ? 'btn-accent' : 'btn-line'}" href="${esc(x.build(s))}" target="_blank" rel="sponsored noopener">
            <span>למחירים ב-<bdi>${x.name}</bdi> <span class="arrow">←</span></span>
          </a>
        </li>`,
      )
      .join('');
  }
</script>
