---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---
<Base title="העמוד לא נמצא | לילה זול" noindex>
  <section class="wrap nf">
    <p class="display big ltr accent">404</p>
    <h1 class="display d-lg">העמוד הזה יצא לחופשה.</h1>
    <p class="lead">אבל המלון הבא שלכם עדיין מחכה.</p>
    <a class="btn btn-accent" href={href('/')}>חזרה לחיפוש <span class="arrow">←</span></a>
  </section>
</Base>
<style>
  .nf {
    min-height: 70vh;
    display: grid;
    align-content: center;
    gap: 16px;
    padding-block: 80px;
  }
  .big {
    font-size: clamp(160px, 26vw, 360px);
  }
</style>
