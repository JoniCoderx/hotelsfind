---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Img from '../../components/Img.astro';
import { guides } from '../../data/guides';
import { destPhotos, hotel } from '../../data/photos';
import { href } from '../../lib/url';

const abs = (path: string) => new URL(href(path), Astro.site).toString();
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'מלונזול', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'מדריכים', item: abs('/guides/') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: guides.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.title, url: abs(`/guides/${g.slug}/`) })),
  },
];
---
<Base
  overlay
  title="מדריכי מלונות: איפה לישון ומה לבדוק | מלונזול"
  description="מדריכים קצרים לבחירת מלון: איפה לישון באתונה, בברצלונה ובבודפשט, מלונות באילת למשפחות, ספא בים המלח, דובאי ליד החוף ועוד."
  jsonLd={ld}
>
  <PageHero
    photo={hotel.infinity}
    crumbs={[{ label: 'ראשי', to: '/' }, { label: 'מדריכים' }]}
    eyebrow={`${guides.length} מדריכים`}
    title="איפה"
    accent="לישון?"
    lead="מדריכים קצרים שעוזרים לבחור אזור ומלון: מה מתאים לכם, מה לבדוק לפני ההזמנה, ומתי הכי משתלם."
  />
  <section class="wrap block">
    <div class="g">
      {guides.map((g) => (
        <a class="gc" href={href(`/guides/${g.slug}/`)}>
          <div class="ph"><Img photo={destPhotos[g.dest] ?? hotel.sunset} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 380px" max={1200} /></div>
          <div class="tx">
            <h2>{g.title}</h2>
            <p>{g.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .block {
    padding-block: 48px 80px;
  }
  .g {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .gc {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--line);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .gc:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .ph {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tx {
    padding: 18px 20px 22px;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 19px;
    line-height: 1.35;
  }
  p {
    margin: 0;
    font-size: 15px;
    color: var(--ink-2);
  }
  @media (max-width: 1060px) {
    .g {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .g {
      grid-template-columns: 1fr;
    }
  }
</style>
