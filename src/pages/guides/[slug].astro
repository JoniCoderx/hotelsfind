---
import Base from '../../layouts/Base.astro';
import SearchForm from '../../components/SearchForm.astro';
import Faq from '../../components/Faq.astro';
import PageHero from '../../components/PageHero.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import Img from '../../components/Img.astro';
import Glance from '../../components/Glance.astro';
import MonthStrip from '../../components/MonthStrip.astro';
import '../../styles/article.css';
import { guides, guidePhoto, type Guide } from '../../data/guides';
import DestinationCard from '../../components/DestinationCard.astro';
import { bySlug, destinations } from '../../data/destinations';
import { relatedGuides } from '../../lib/related';
import { photoSrc } from '../../lib/photo';
import { href } from '../../lib/url';
import HotelMap from '../../components/HotelMap.astro';
import GoCompare from '../../components/GoCompare.astro';
import { geo } from '../../data/geo';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}

const PUBLISHED = '2026-10-28';

const { g } = Astro.props as { g: Guide };
const d = destinations.find((x) => x.slug === g.dest);
const photo = guidePhoto(g);
// Where the quick links search: the guide's own place, else its destination.
const place = g.place ?? (d && { he: d.he, en: d.en });
// The hotel map centres on the guide's destination, else on its own place by name.
const at = g.dest ? geo[g.dest] : undefined;
const mapPlace = g.place ? { address: g.place.en } : at;
const more = relatedGuides(g, guides, (dest) => (dest && bySlug[dest]?.region) || 'abroad');
// Reading time from the guide's own words, at about 180 Hebrew words a minute.
const words = [g.lead, ...g.sections.flatMap((s) => [s.h, ...(s.p ?? []), ...(s.list ?? []).map((i) => `${i.name ?? ''} ${i.text}`)]), ...g.checklist]
  .join(' ')
  .split(/\s+/).length;
const minutes = Math.max(2, Math.round(words / 180));
// The logo's three colours, in turn, for section numbers and area cards.
const tones = ['var(--t1)', 'var(--t2)', 'var(--t3)'];
const isSeason = (h: string) => /מתי|עונה/.test(h);
const abs = (path: string) => new URL(href(path), Astro.site).toString();

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: g.title,
    description: g.description,
    inLanguage: 'he-IL',
    image: new URL(photoSrc(photo, 1200), Astro.site).toString(),
    datePublished: PUBLISHED,
    dateModified: PUBLISHED,
    author: { '@type': 'Organization', name: 'מלונזול', url: abs('/') },
    publisher: { '@type': 'Organization', name: 'מלונזול', logo: { '@type': 'ImageObject', url: abs('/favicon.svg') } },
    mainEntityOfPage: abs(`/guides/${g.slug}/`),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'מלונזול', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'מדריכים', item: abs('/guides/') },
      { '@type': 'ListItem', position: 3, name: g.title, item: abs(`/guides/${g.slug}/`) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: g.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  overlay
  title={`${g.seoTitle} | מלונזול`}
  description={g.description}
  jsonLd={ld}
  image={photoSrc(photo, 1200)}
  article={{ published: PUBLISHED, modified: PUBLISHED }}
>
  <PageHero
    photo={photo}
    overlap={Boolean(place)}
    crumbs={[{ label: 'ראשי', to: '/' }, { label: 'מדריכים', to: '/guides/' }, { label: place?.he ?? g.title }]}
    eyebrow={place ? `מדריך · ${place.he}` : 'מדריך'}
    title={g.title}
    lead={g.lead}
  >
    <p class="meta"><span>{minutes} דקות קריאה</span><span aria-hidden="true">·</span><span>עודכן ב{g.updated ?? 'אוקטובר 2026'}</span></p>
  </PageHero>
  {place && (
    <div class="wrap dock">
      <div class="quick">
        <p><b>מחפשים מלון ב{place.he}?</b> <span>השוו מחירים מ-5 אתרי הזמנות, בלי להקליד שוב.</span></p>
        <GoCompare he={place.he} en={place.en} slug={d?.slug} />
      </div>
    </div>
  )}

  <section class="section">
    <div class={`wrap body${place ? '' : ' solo'}`}>
      <article class="guide art">
        <Glance
          where={{ label: 'איפה לישון', value: g.glance.where }}
          when={{ label: 'מתי לנסוע', value: g.glance.when }}
          key={{ label: 'הכי חשוב לבדוק', value: g.glance.key }}
        />

        <nav class="toc" aria-label="בעמוד הזה">
          <span>בעמוד הזה</span>
          <ol>
            {g.sections.map((sec, i) => <li><a href={`#s${i + 1}`}>{sec.h}</a></li>)}
            <li><a href="#check">רשימת בדיקה</a></li>
          </ol>
        </nav>

        {g.sections.map((sec, i) => (
          <section class="sec" id={`s${i + 1}`} style={`--c:${tones[i % 3]}`}>
            <h2><span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{sec.h}</h2>
            {sec.p?.map((t) => <p>{t}</p>)}
            {isSeason(sec.h) && g.season && (
              <MonthStrip best={g.season.best} busy={g.season.busy} />
            )}
            {sec.list && sec.list.some((x) => x.name) && (
              <div class="areas">
                {sec.list.map((x, k) => (
                  <div class="area" style={`--c:${tones[k % 3]}`}>
                    <span class="an" aria-hidden="true">{k + 1}</span>
                    <h3>{x.name}</h3>
                    {x.tag && <p class="tag">מתאים ל: {x.tag}</p>}
                    <p>{x.text}</p>
                  </div>
                ))}
              </div>
            )}
            {sec.list && !sec.list.some((x) => x.name) && (
              <ul class="tips">
                {sec.list.map((x) => <li>{x.text}</li>)}
              </ul>
            )}
            {sec.dests && (
              <div class="dests">
                {sec.dests.map((s) => destinations.find((x) => x.slug === s)).filter((x) => !!x).map((x) => <DestinationCard d={x} sizes="(max-width: 600px) 92vw, 260px" />)}
              </div>
            )}
          </section>
        ))}

        {mapPlace && place && <HotelMap place={mapPlace} he={place.he} campaign={`guide-${g.slug}`} />}

        <section class="check" id="check" data-key={`mz-check-${g.slug}`} aria-labelledby="check-h">
          <div class="check-head">
            <h2 id="check-h">לפני שמזמינים</h2>
            <span class="progress" aria-live="polite"><b>0</b>/{g.checklist.length}</span>
          </div>
          <ul>
            {g.checklist.map((c, k) => (
              <li><button type="button" role="checkbox" aria-checked="false" data-i={k}><i aria-hidden="true"></i>{c}</button></li>
            ))}
          </ul>
        </section>

        <div class="cta" id="search">
          <div>
            <h2>{place ? `מוכנים לחפש מלון ב${place.he}?` : 'מוכנים לחפש מלון?'}</h2>
            <p>{place ? `כל המלונות ב${place.he} עם המחיר בכל אתר הזמנות. או בחרו תאריכים ואורחים כאן:` : 'בחרו יעד, תאריכים ואורחים, ונשווה את המחירים בכמה אתרי הזמנות:'}</p>
          </div>
          <div class="cta-go">
            {place && <GoCompare he={place.he} en={place.en} slug={d?.slug} label={`לכל המלונות ב${place.he}`} />}
            {d && <a class="cta-link" href={href(`/destinations/${d.slug}/`)}>עוד על {d.he}</a>}
          </div>
          <div class="cta-form"><SearchForm presetSlug={d?.slug} /></div>
        </div>
      </article>

      {place && <QuickLinks he={place.he} en={place.en} source={`guide-${g.slug}`} lat={g.place ? undefined : at?.lat} lng={g.place ? undefined : at?.lng} />}
    </div>
  </section>

  <section class="section faq-sec">
    <div class="wrap faq-wrap">
      <div>
        <p class="label">שאלות נפוצות</p>
        <h2 class="h2">שאלות ותשובות</h2>
      </div>
      <Faq items={g.faq} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row-head">
        <h2 class="h2">עוד מדריכים</h2>
        <a href={href('/guides/')} class="btn btn-soft">כל המדריכים <span class="arrow">←</span></a>
      </div>
      <div class="more">
        {more.map((m) => (
          <a class="gc" href={href(`/guides/${m.slug}/`)}>
            <div class="ph"><Img photo={guidePhoto(m)} sizes="(max-width: 700px) 92vw, 380px" max={1200} /></div>
            <h3>{m.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .dock {
    position: relative;
    z-index: 5;
    margin-top: calc(-1 * clamp(56px, 6vw, 80px));
  }
  .quick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    padding: 18px 22px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 18px 40px -18px rgba(6, 30, 110, 0.45);
    border: 4px solid var(--frame);
  }
  .quick p {
    margin: 0;
    font-size: 17px;
  }
  .quick p span {
    color: var(--ink-2);
  }
  .cta-form {
    flex-basis: 100%;
  }
  /* The article column is narrow for a one-line form: destination and button on their own rows. */
  .cta-form :global(.sf) {
    grid-template-columns: 1.4fr 1fr;
  }
  .cta-form :global(.sf > .dest),
  .cta-form :global(.sf > .go) {
    grid-column: 1 / -1;
  }
  @media (max-width: 960px) {
    .cta-form :global(.sf) {
      grid-template-columns: 1fr;
    }
  }
  .body {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 56px;
    align-items: start;
  }
  .body.solo {
    grid-template-columns: minmax(0, 820px);
  }
  .dests {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
    margin-top: 20px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.82);
  }
  .faq-sec {
    background: var(--warm);
  }
  .faq-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: start;
  }
  .row-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 32px;
    margin-bottom: 26px;
  }
  .row-head .h2 {
    margin: 0;
  }
  .more {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .gc {
    display: block;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--line);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .gc:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .gc .ph {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .gc .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gc h3 {
    margin: 0;
    padding: 16px 18px 18px;
    font-size: 18px;
    line-height: 1.35;
  }
  @media (max-width: 1060px) {
    .body,
    .faq-wrap {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  @media (max-width: 760px) {
    .more {
      grid-template-columns: 1fr;
    }

  }
</style>

<script>
  // Tick-off checklist; ticks are kept per guide in this browser only.
  document.querySelectorAll<HTMLElement>('.check').forEach((box) => {
    const key = box.dataset.key!;
    const btns = [...box.querySelectorAll<HTMLButtonElement>('button[role="checkbox"]')];
    const count = box.querySelector('.progress b')!;
    let done: number[] = [];
    try {
      done = JSON.parse(localStorage.getItem(key) || '[]');
    } catch {}
    const paint = () => {
      btns.forEach((b, i) => b.setAttribute('aria-checked', String(done.includes(i))));
      count.textContent = String(done.length);
    };
    btns.forEach((b, i) =>
      b.addEventListener('click', () => {
        done = done.includes(i) ? done.filter((x) => x !== i) : [...done, i];
        try {
          localStorage.setItem(key, JSON.stringify(done));
        } catch {}
        paint();
      }),
    );
    paint();
  });
</script>
