---
import Base from '../../layouts/Base.astro';
import SearchForm from '../../components/SearchForm.astro';
import Faq from '../../components/Faq.astro';
import PageHero from '../../components/PageHero.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import Img from '../../components/Img.astro';
import Glance from '../../components/Glance.astro';
import MonthStrip from '../../components/MonthStrip.astro';
import '../../styles/article.css';
import { guides, type Guide } from '../../data/guides';
import { destinations } from '../../data/destinations';
import { destPhotos, hotel } from '../../data/photos';
import { photoSrc } from '../../lib/photo';
import { href } from '../../lib/url';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}

const PUBLISHED = '2026-10-28';

const { g } = Astro.props as { g: Guide };
const d = destinations.find((x) => x.slug === g.dest)!;
const photo = destPhotos[d.slug] ?? hotel.sunset;
const more = guides.filter((x) => x.slug !== g.slug).slice(0, 3);
// Reading time from the guide's own words, at about 180 Hebrew words a minute.
const words = [g.lead, ...g.sections.flatMap((s) => [s.h, ...(s.p ?? []), ...(s.list ?? []).map((i) => `${i.name ?? ''} ${i.text}`)]), ...g.checklist]
  .join(' ')
  .split(/\s+/).length;
const minutes = Math.max(2, Math.round(words / 180));
// The logo's three colours, in turn, for section numbers and area cards.
const tones = ['var(--t1)', 'var(--t2)', 'var(--t3)'];
const isSeason = (h: string) => /מתי|עונה/.test(h);
const abs = (path: string) => new URL(href(path), Astro.site).toString();

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: g.title,
    description: g.description,
    inLanguage: 'he-IL',
    image: new URL(photoSrc(photo, 1200), Astro.site).toString(),
    datePublished: PUBLISHED,
    dateModified: PUBLISHED,
    author: { '@type': 'Organization', name: 'מלונזול', url: abs('/') },
    publisher: { '@type': 'Organization', name: 'מלונזול', logo: { '@type': 'ImageObject', url: abs('/favicon.svg') } },
    mainEntityOfPage: abs(`/guides/${g.slug}/`),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'מלונזול', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'מדריכים', item: abs('/guides/') },
      { '@type': 'ListItem', position: 3, name: g.title, item: abs(`/guides/${g.slug}/`) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: g.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  overlay
  title={`${g.seoTitle} | מלונזול`}
  description={g.description}
  jsonLd={ld}
  image={photoSrc(photo, 1200)}
  article={{ published: PUBLISHED, modified: PUBLISHED }}
>
  <PageHero
    photo={photo}
    overlap
    crumbs={[{ label: 'ראשי', to: '/' }, { label: 'מדריכים', to: '/guides/' }, { label: d.he }]}
    eyebrow={`מדריך · ${d.he}`}
    title={g.title}
    lead={g.lead}
  >
    <p class="meta"><span>{minutes} דקות קריאה</span><span aria-hidden="true">·</span><span>עודכן באוקטובר 2026</span></p>
  </PageHero>
  <div class="wrap dock" id="top-search"><SearchForm presetSlug={d.slug} /></div>

  <section class="section">
    <div class="wrap body">
      <article class="guide art">
        <Glance
          where={{ label: 'איפה לישון', value: g.glance.where }}
          when={{ label: 'מתי לנסוע', value: g.glance.when }}
          key={{ label: 'הכי חשוב לבדוק', value: g.glance.key }}
        />

        <nav class="toc" aria-label="בעמוד הזה">
          <span>בעמוד הזה</span>
          <ol>
            {g.sections.map((sec, i) => <li><a href={`#s${i + 1}`}>{sec.h}</a></li>)}
            <li><a href="#check">רשימת בדיקה</a></li>
          </ol>
        </nav>

        {g.sections.map((sec, i) => (
          <section class="sec" id={`s${i + 1}`} style={`--c:${tones[i % 3]}`}>
            <h2><span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{sec.h}</h2>
            {sec.p?.map((t) => <p>{t}</p>)}
            {isSeason(sec.h) && (
              <MonthStrip best={g.season.best} busy={g.season.busy} />
            )}
            {sec.list && sec.list.some((x) => x.name) && (
              <div class="areas">
                {sec.list.map((x, k) => (
                  <div class="area" style={`--c:${tones[k % 3]}`}>
                    <span class="an" aria-hidden="true">{k + 1}</span>
                    <h3>{x.name}</h3>
                    {x.tag && <p class="tag">מתאים ל: {x.tag}</p>}
                    <p>{x.text}</p>
                  </div>
                ))}
              </div>
            )}
            {sec.list && !sec.list.some((x) => x.name) && (
              <ul class="tips">
                {sec.list.map((x) => <li>{x.text}</li>)}
              </ul>
            )}
          </section>
        ))}

        <section class="check" id="check" data-key={`mz-check-${g.slug}`} aria-labelledby="check-h">
          <div class="check-head">
            <h2 id="check-h">לפני שמזמינים</h2>
            <span class="progress" aria-live="polite"><b>0</b>/{g.checklist.length}</span>
          </div>
          <ul>
            {g.checklist.map((c, k) => (
              <li><button type="button" role="checkbox" aria-checked="false" data-i={k}><i aria-hidden="true"></i>{c}</button></li>
            ))}
          </ul>
        </section>

        <div class="cta">
          <div>
            <h2>מוכנים לחפש מלון ב{d.he}?</h2>
            <p>יעד, תאריכים ואורחים פעם אחת, ובלחיצה אותו חיפוש ב-Booking, Agoda ועוד.</p>
          </div>
          <div class="cta-go">
            <a class="btn btn-fire" href="#top-search">לחיפוש מלון <span class="arrow" aria-hidden="true">←</span></a>
            <a class="cta-link" href={href(`/destinations/${d.slug}/`)}>עוד על {d.he}</a>
          </div>
        </div>
      </article>

      <QuickLinks he={d.he} en={d.en} source={`guide-${g.slug}`} />
    </div>
  </section>

  <section class="section faq-sec">
    <div class="wrap faq-wrap">
      <div>
        <p class="label">שאלות נפוצות</p>
        <h2 class="h2">שאלות ותשובות</h2>
      </div>
      <Faq items={g.faq} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row-head">
        <h2 class="h2">עוד מדריכים</h2>
        <a href={href('/guides/')} class="btn btn-soft">כל המדריכים <span class="arrow">←</span></a>
      </div>
      <div class="more">
        {more.map((m) => (
          <a class="gc" href={href(`/guides/${m.slug}/`)}>
            <div class="ph"><Img photo={destPhotos[m.dest] ?? hotel.sunset} sizes="(max-width: 700px) 92vw, 380px" max={1200} /></div>
            <h3>{m.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .dock {
    position: relative;
    z-index: 5;
    margin-top: calc(-1 * clamp(56px, 6vw, 80px));
  }
  .body {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 56px;
    align-items: start;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.82);
  }
  .faq-sec {
    background: var(--warm);
  }
  .faq-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: start;
  }
  .row-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 32px;
    margin-bottom: 26px;
  }
  .row-head .h2 {
    margin: 0;
  }
  .more {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .gc {
    display: block;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--line);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .gc:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .gc .ph {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .gc .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gc h3 {
    margin: 0;
    padding: 16px 18px 18px;
    font-size: 18px;
    line-height: 1.35;
  }
  @media (max-width: 1060px) {
    .body,
    .faq-wrap {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  @media (max-width: 760px) {
    .more {
      grid-template-columns: 1fr;
    }

  }
</style>

<script>
  // Tick-off checklist; ticks are kept per guide in this browser only.
  document.querySelectorAll<HTMLElement>('.check').forEach((box) => {
    const key = box.dataset.key!;
    const btns = [...box.querySelectorAll<HTMLButtonElement>('button[role="checkbox"]')];
    const count = box.querySelector('.progress b')!;
    let done: number[] = [];
    try {
      done = JSON.parse(localStorage.getItem(key) || '[]');
    } catch {}
    const paint = () => {
      btns.forEach((b, i) => b.setAttribute('aria-checked', String(done.includes(i))));
      count.textContent = String(done.length);
    };
    btns.forEach((b, i) =>
      b.addEventListener('click', () => {
        done = done.includes(i) ? done.filter((x) => x !== i) : [...done, i];
        try {
          localStorage.setItem(key, JSON.stringify(done));
        } catch {}
        paint();
      }),
    );
    paint();
  });
</script>
