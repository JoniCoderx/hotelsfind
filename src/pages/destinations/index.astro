---
import Base from '../../layouts/Base.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import { israel, abroad } from '../../data/destinations';
---
<Base
  title="כל היעדים: מלונות בישראל ובחו״ל | לילה זול"
  description="מלונות באילת, ים המלח, תל אביב, ירושלים, יוון, קפריסין, דובאי, אירופה וניו יורק. השוואת מחירים בין אתרי ההזמנות הגדולים."
>
  <section class="wrap head">
    <p class="kicker">{israel.length + abroad.length} יעדים</p>
    <h1 class="display d-xxl">לאן <span class="accent">הלילה?</span></h1>
    <p class="lead">בחרו יעד וקבלו טיפים, אזורים מומלצים והשוואת מחירים מיידית בכל אתרי ההזמנות.</p>
  </section>
  <section class="wrap block">
    <h2 class="display d-xl">ישראל</h2>
    <div class="g">{israel.map((d, i) => <DestinationCard d={d} n={i + 1} />)}</div>
  </section>
  <section class="wrap block">
    <h2 class="display d-xl">חו"ל</h2>
    <div class="g">{abroad.map((d, i) => <DestinationCard d={d} n={i + 1} />)}</div>
  </section>
</Base>

<style>
  .head {
    padding-block: 72px 32px;
  }
  .head .lead {
    margin-top: 20px;
  }
  .block {
    padding-block: 56px;
  }
  .block h2 {
    border-bottom: 1.5px solid var(--ink);
    padding-bottom: 12px;
    margin-bottom: 40px;
  }
  .g {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 56px 28px;
  }
</style>
