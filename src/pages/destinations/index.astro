---
import Base from '../../layouts/Base.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import Stories from '../../components/Stories.astro';
import { israel, abroad } from '../../data/destinations';
---
<Base
  title="כל היעדים: מלונות בישראל ובחו״ל | StayRadar"
  description="מלונות באילת, ים המלח, תל אביב, ירושלים, יוון, קפריסין, דובאי, אירופה וניו יורק. מחירים בזמן אמת והשוואה בין אתרי ההזמנות הגדולים."
>
  <section class="head">
    <div class="wrap">
      <p class="label">{israel.length + abroad.length} יעדים</p>
      <h1 class="h1">לאן <span class="fire">טסים?</span></h1>
      <p class="lead">בחרו יעד וקבלו מחירים בזמן אמת, אזורים מומלצים וטיפים לחיסכון.</p>
      <Stories />
    </div>
  </section>
  <section class="wrap block">
    <h2 class="h2">ישראל</h2>
    <div class="g">{israel.map((d) => <DestinationCard d={d} />)}</div>
  </section>
  <section class="wrap block">
    <h2 class="h2">חו"ל</h2>
    <div class="g">{abroad.map((d) => <DestinationCard d={d} />)}</div>
  </section>
</Base>

<style>
  .head {
    background: var(--warm);
    padding-block: 56px 32px;
    margin-bottom: 24px;
  }
  .head .lead {
    margin: 14px 0 26px;
  }
  .block {
    padding-block: 32px;
  }
  .g {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
    margin-top: 20px;
  }
</style>
