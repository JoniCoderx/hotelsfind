---
import Base from '../../layouts/Base.astro';
import SearchForm from '../../components/SearchForm.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import Faq from '../../components/Faq.astro';
import PageHero from '../../components/PageHero.astro';
import { destinations, faqFor, type Destination } from '../../data/destinations';
import { destPhotos, hotel } from '../../data/photos';
import { catalog } from '../../lib/catalog';
import { partners } from '../../lib/partners';
import { href } from '../../lib/url';
import { priceMode } from '../../lib/mode';

const live = priceMode() === 'live';

export function getStaticPaths() {
  return destinations.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props as { d: Destination };
const photo = destPhotos[d.slug] ?? hotel.sunset;
const faq = faqFor(d);
const related = destinations.filter((x) => x.region === d.region && x.slug !== d.slug).slice(0, 4);
const hotels = (catalog[d.slug] ?? []).slice(0, 24);
const quick = partners.map((p) => ({ p, url: p.build({ q: d.en, adults: 2, children: 0, rooms: 1, source: d.slug }) }));
const abs = (path: string) => new URL(href(path), Astro.site).toString();

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'מלונזול', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'יעדים', item: abs('/destinations/') },
      { '@type': 'ListItem', position: 3, name: `מלונות ב${d.he}`, item: abs(`/destinations/${d.slug}/`) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TouristDestination',
    name: d.he,
    alternateName: d.en,
    description: d.intro,
    containedInPlace: { '@type': 'Country', name: d.country },
  },
];
---
<Base
  overlay
  title={live ? `מלונות ב${d.he}: מחירים מ-Agoda ובדיקה ב-Booking | מלונזול` : `מלונות ב${d.he}: אזורים מומלצים וטיפים | מלונזול`}
  description={`מלונות ב${d.he}: ${live ? 'מחירים מ-Agoda לתאריכים שלכם, ובדיקה מהירה של אותו חיפוש ב-Booking, Expedia, Hotels.com ו-Trip.com.' : 'אותו חיפוש בלחיצה ב-Booking, Agoda, Expedia, Hotels.com ו-Trip.com.'} ${d.tagline}. אזורים מומלצים, טיפים ומתי הכי זול.`}
  jsonLd={ld}
>
  <PageHero
    photo={photo}
    overlap
    crumbs={[{ label: 'ראשי', to: '/' }, { label: 'יעדים', to: '/destinations/' }, { label: d.he }]}
    eyebrow={`${d.country}${d.flight ? ` · ${d.flight} טיסה מתל אביב` : ''}`}
    title={`מלונות ב${d.he}`}
    lead={`${d.tagline}. ${live ? 'מחירים מ-Agoda, ובלחיצה אותו חיפוש גם ב-Booking ובשאר האתרים.' : 'חיפוש אחד, ובלחיצה אותו יעד ותאריכים ב-Booking, Agoda ובשאר האתרים.'}`}
  />
  <div class="wrap dock"><SearchForm presetSlug={d.slug} /></div>

  {live && (
  <section class="wrap live" id="live" hidden data-slug={d.slug} data-he={d.he} data-en={d.en}>
    <div class="row-head">
      <div>
        <p class="label">מחירים חיים מ-Agoda</p>
        <h2 class="h2">המלונות הכי שווים ב{d.he} לסופ"ש הקרוב</h2>
        <p class="sub" id="live-when"></p>
      </div>
      <a class="btn btn-ink" id="live-all" href="/search/">לכל המלונות והתאריכים <span class="arrow">←</span></a>
    </div>
    <p class="demo" id="live-demo" hidden>נתוני דוגמה: מפתח Agoda עוד לא מחובר.</p>
    <div class="live-grid" id="live-grid"></div>
  </section>
  )}

  <section class="section">
    <div class="wrap body">
      <article>
        <p class="intro">{d.intro}</p>

        <h2 class="h2 sm">איפה לישון ב{d.he}?</h2>
        <div class="areas">
          {d.areas.map((a, i) => (
            <div class="area reveal">
              <span class="n">{i + 1}</span>
              <h3>{a.name}</h3>
              <p>{a.text}</p>
            </div>
          ))}
        </div>

        <div class="twin">
          <div class="box" style="--c:var(--warm)">
            <h2>מתי הכי משתלם?</h2>
            <p>{d.bestTime}</p>
          </div>
          <div class="box" style="--c:var(--good-soft)">
            <h2>טיפים לחיסכון</h2>
            <ul>
              {d.tips.map((t) => <li>{t}</li>)}
              <li>השוו את אותו מלון ב-3 אתרים לפחות לפני ההזמנה.</li>
            </ul>
          </div>
        </div>
      </article>

      <section class="side" aria-labelledby="quick-h">
        <h2 id="quick-h">חיפוש מהיר ב{d.he}</h2>
        <p>כל קישור נפתח עם חיפוש מלונות ב{d.he} מוכן מראש.</p>
        <ul>
          {quick.map(({ p, url }) => (
            <li style={`--a:${p.accent}`}>
              <a href={url} target="_blank" rel="sponsored noopener">
                <span><b class="ltr">{p.name}</b></span>
                <span class="arrow" aria-hidden="true">←</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="fine">ייתכן שנקבל עמלה מהשותפים. מלונזול לא גובה מכם תשלום. <a href={href('/disclosure/')}>גילוי נאות</a></p>
      </section>
    </div>
  </section>

  {hotels.length > 0 && (
    <section class="section cat-sec">
      <div class="wrap">
        <h2 class="h2">מלונות פופולריים ב{d.he}</h2>
        <div class="cat">
          {hotels.map((h) => (
            <a class="ch" href={href(`/hotel/${d.slug}/${h.id}/`)}>
              {h.photo && <img src={h.photo} alt={h.name} loading="lazy" decoding="async" />}
              <div>
                <h3>{h.name}</h3>
                <p>
                  {h.stars > 0 && <span class="st">{'★'.repeat(Math.floor(h.stars))}</span>}
                  {h.score > 0 && <span class="sc">{h.score.toFixed(1)}</span>}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section faq-sec">
    <div class="wrap faq-wrap">
      <div>
        <p class="label">שאלות נפוצות</p>
        <h2 class="h2">מלונות ב{d.he}: שאלות ותשובות</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row-head">
        <h2 class="h2">עוד יעדים שאוהבים</h2>
        <a href={href('/destinations/')} class="btn btn-soft">כל היעדים <span class="arrow">←</span></a>
      </div>
      <div class="rel">{related.map((r) => <DestinationCard d={r} />)}</div>
    </div>
  </section>
</Base>

<style>
  .dock {
    position: relative;
    z-index: 5;
    margin-top: calc(-1 * clamp(56px, 6vw, 80px));
  }
  .live {
    padding-top: 56px;
  }
  .live[hidden] {
    display: none;
  }
  .row-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 32px;
    margin-bottom: 26px;
  }
  .row-head .h2 {
    margin: 0;
  }
  .sub {
    margin: 6px 0 0;
    color: var(--ink-2);
  }
  .demo {
    padding: 10px 14px;
    border-radius: 12px;
    background: #fff4d6;
    font-weight: 600;
    font-size: 14px;
  }
  .demo[hidden] {
    display: none;
  }
  .live-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .body {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 56px;
    align-items: start;
  }
  .intro {
    font-size: clamp(19px, 1.8vw, 23px);
    line-height: 1.55;
    margin-bottom: 48px;
  }
  .sm {
    font-size: clamp(26px, 2.6vw, 34px);
  }
  .areas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
    margin: 20px 0 48px;
  }
  .area {
    padding: 22px;
    border-radius: var(--r-lg);
    background: var(--soft);
  }
  .area .n {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--fire-grad);
    color: #fff;
    font-weight: 700;
    margin-bottom: 14px;
  }
  .area h3 {
    font-size: 18px;
    margin-bottom: 6px;
  }
  .area p {
    margin: 0;
    font-size: 15px;
    color: var(--ink-2);
  }
  .twin {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .box {
    padding: 26px;
    border-radius: var(--r-lg);
    background: var(--c);
  }
  .box h2 {
    font-size: 21px;
  }
  .box p,
  .box li {
    color: var(--ink-2);
  }
  .box ul {
    margin: 0;
    padding-inline-start: 18px;
    display: grid;
    gap: 6px;
  }
  .side {
    position: sticky;
    top: 90px;
    padding: 24px;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
  }
  .side h2 {
    font-size: 20px;
  }
  .side > p {
    color: var(--ink-2);
    font-size: 15px;
  }
  .side ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .side li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--soft);
    border-inline-start: 4px solid var(--a);
    transition: background 0.2s;
  }
  .side li a:hover {
    background: var(--line);
  }
  .side b {
    display: block;
    text-align: right;
  }
  .side small {
    color: var(--ink-2);
    font-size: 13px;
  }
  .fine {
    font-size: 13px !important;
    color: var(--muted) !important;
    margin: 16px 0 0;
  }
  .fine a {
    text-decoration: underline;
  }
  .cat-sec {
    background: var(--soft);
  }
  .cat {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
    margin-top: 24px;
  }
  .ch {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px;
    border-radius: var(--r);
    background: #fff;
    border: 1px solid var(--line);
  }
  .ch:hover {
    border-color: var(--ink);
  }
  .ch img {
    width: 64px;
    height: 64px;
    flex: none;
    border-radius: 12px;
    object-fit: cover;
  }
  .ch h3 {
    font-size: 15px;
    margin: 0 0 2px;
  }
  .ch p {
    margin: 0;
    display: flex;
    gap: 8px;
    font-size: 13px;
  }
  .st {
    color: var(--star);
  }
  .sc {
    padding: 0 6px;
    border-radius: 6px;
    background: var(--good);
    color: #fff;
    font-weight: 700;
  }
  .faq-sec {
    background: var(--warm);
  }
  .faq-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: start;
  }
  .rel {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  @media (max-width: 1060px) {
    .live-grid,
    .rel {
      grid-template-columns: repeat(2, 1fr);
    }
    .body,
    .faq-wrap {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .side {
      position: static;
    }
  }
  @media (max-width: 800px) {
    .twin {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .live-grid,
    .rel {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { hotelCard, skeleton } from '../../lib/hotelcard';
  import { canonicalSearch } from '../../lib/searchkey';


  const sec = document.getElementById('live');
  // The live section exists only when the deployment shows prices.
  if (sec) {
  const { slug, he, en } = sec.dataset as { slug: string; he: string; en: string };
  const iso = (d: Date) => d.toISOString().slice(0, 10);
  const now = new Date();
  const thu = new Date(now);
  thu.setDate(now.getDate() + (((4 - now.getDay() + 7) % 7) || 7));
  const sat = new Date(thu);
  sat.setDate(thu.getDate() + 2);
  const checkin = iso(thu);
  const checkout = iso(sat);
  const fmt = (d: Date) => new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long' }).format(d);

  const grid = document.getElementById('live-grid')!;
  grid.innerHTML = skeleton(4, 'tile');
  fetch(`/api/search?${canonicalSearch({ slug, in: checkin, out: checkout, a: '2', c: '0', sort: 'PriceAsc', score: '7' })}`)
    .then((r) => r.json())
    .then((data) => {
      if ((data.mode !== 'live' && data.mode !== 'demo') || !data.hotels?.length) return;
      document.getElementById('live-demo')!.hidden = data.mode !== 'demo';
      document.getElementById('live-when')!.textContent = `${fmt(thu)} – ${fmt(sat)} · 2 מבוגרים · ציון 7+`;
      const q = { q: en, checkin, checkout, adults: 2, children: 0, rooms: 1, source: slug, city: en.split(',')[0] };
      grid.innerHTML = data.hotels.slice(0, 8).map((h: never) => hotelCard(h, q, 'tile')).join('');
      (document.getElementById('live-all') as HTMLAnchorElement).href =
        `/search/?${new URLSearchParams({ d: he, q: en, slug, in: checkin, out: checkout, a: '2', c: '0', r: '1' })}`;
      sec.hidden = false;
    })
    .catch(() => {});
  }
</script>
