---
import Base from '../../layouts/Base.astro';
import SearchForm from '../../components/SearchForm.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import Faq from '../../components/Faq.astro';
import PageHero from '../../components/PageHero.astro';
import HotelMap from '../../components/HotelMap.astro';
import GoCompare from '../../components/GoCompare.astro';
import { geo } from '../../data/geo';
import QuickLinks from '../../components/QuickLinks.astro';
import Glance from '../../components/Glance.astro';
import MonthStrip from '../../components/MonthStrip.astro';
import '../../styles/article.css';
import { destinations, faqFor, type Destination } from '../../data/destinations';
import { guidesFor } from '../../data/guides';
import { destPhotos, hotel } from '../../data/photos';
import { photoSrc } from '../../lib/photo';
import { catalog } from '../../lib/catalog';
import { listsFor, listPath, listTitle } from '../../lib/best';
import { href } from '../../lib/url';
import { priceMode } from '../../lib/mode';

const live = priceMode() === 'live';

export function getStaticPaths() {
  return destinations.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props as { d: Destination };
const photo = destPhotos[d.slug] ?? hotel.sunset;
const faq = faqFor(d);
const related = destinations.filter((x) => x.region === d.region && x.slug !== d.slug).slice(0, 4);
const hotels = (catalog[d.slug] ?? []).slice(0, 24);
const bestLists = listsFor(catalog[d.slug], d.slug);
const destGuides = guidesFor(d.slug);
// The short answer to "when": the part of bestTime before its first colon, full stop or semicolon.
const whenShort = d.bestTime.split(/[:.;]/)[0].trim();
const tones = ['var(--t1)', 'var(--t2)', 'var(--t3)'];
const abs = (path: string) => new URL(href(path), Astro.site).toString();

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'מלונזול', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'יעדים', item: abs('/destinations/') },
      { '@type': 'ListItem', position: 3, name: `מלונות ב${d.he}`, item: abs(`/destinations/${d.slug}/`) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TouristDestination',
    name: d.he,
    alternateName: d.en,
    description: d.intro,
    containedInPlace: { '@type': 'Country', name: d.country },
  },
];
---
<Base
  overlay
  title={live ? `מלונות ב${d.he}: מחירים מ-Agoda ובדיקה ב-Booking | מלונזול` : `מלונות ב${d.he}: השוואת מחירים ומלון זול לתאריכים שלכם | מלונזול`}
  description={live ? `מלונות ב${d.he}: מחירים מ-Agoda לתאריכים שלכם, ובדיקה מהירה של אותו חיפוש ב-Booking, Expedia, Hotels.com ו-Trip.com. ${d.tagline}.` : `${d.tagline}. מלונות ב${d.he} עם המחיר של כל מלון ב-Booking, Agoda ו-Trip.com לתאריכים שלכם, איפה כדאי לישון ומתי הכי זול.`}
  jsonLd={ld}
  image={photoSrc(photo, 1200)}
>
  <PageHero
    photo={photo}
    overlap
    crumbs={[{ label: 'ראשי', to: '/' }, { label: 'יעדים', to: '/destinations/' }, { label: d.he }]}
    eyebrow={`${d.country}${d.flight ? ` · ${d.flight} טיסה מתל אביב` : ''}`}
    title={`מלונות ב${d.he}`}
    lead={`${d.tagline}. ${live ? 'מחירים מ-Agoda, ובלחיצה אותו חיפוש גם ב-Booking ובשאר האתרים.' : 'השוו את המחיר של כל מלון ב-Booking, Agoda ובשאר האתרים, בחיפוש אחד.'}`}
  />
  <div class="wrap dock" id="top-search"><SearchForm presetSlug={d.slug} /></div>

  {live && (
  <section class="wrap live" id="live" hidden data-slug={d.slug} data-he={d.he} data-en={d.en}>
    <div class="row-head">
      <div>
        <p class="label">מחירים חיים מ-Agoda</p>
        <h2 class="h2">המלונות הכי שווים ב{d.he} לסופ"ש הקרוב</h2>
        <p class="sub" id="live-when"></p>
      </div>
      <a class="btn btn-ink" id="live-all" href="/search/">לכל המלונות והתאריכים <span class="arrow">←</span></a>
    </div>
    <p class="demo" id="live-demo" hidden>נתוני דוגמה: מפתח Agoda עוד לא מחובר.</p>
    <div class="live-grid" id="live-grid"></div>
  </section>
  )}

  <section class="section">
    <div class="wrap body">
      <article class="art">
        <p class="intro">{d.intro}</p>
        {destGuides.map((gd) => (
          <a class="guide-link" href={href(`/guides/${gd.slug}/`)}>
            <span class="gl-tag">מדריך</span>
            <span class="gl-t">{gd.title}</span>
            <span class="arrow" aria-hidden="true">←</span>
          </a>
        ))}

        <Glance
          where={{ label: 'איפה לישון', value: d.areas[0].name }}
          when={{ label: 'מתי לנסוע', value: whenShort }}
          key={{ label: 'טיפ לחיסכון', value: d.tips[0] }}
        />

        <section class="sec" id="areas" style="--c:var(--t1)">
          <h2><span class="num" aria-hidden="true">01</span>איפה לישון ב{d.he}?</h2>
          <div class="areas">
            {d.areas.map((a, i) => (
              <div class="area" style={`--c:${tones[i % 3]}`}>
                <span class="an" aria-hidden="true">{i + 1}</span>
                <h3>{a.name}</h3>
                <p>{a.text}</p>
              </div>
            ))}
          </div>
        </section>

        {geo[d.slug] && <HotelMap place={geo[d.slug]} he={d.he} campaign={`dest-${d.slug}`} />}

        <section class="sec" id="when" style="--c:var(--t2)">
          <h2><span class="num" aria-hidden="true">02</span>מתי הכי משתלם?</h2>
          <p>{d.bestTime}</p>
          <MonthStrip best={d.season.best} busy={d.season.busy} />
        </section>

        <section class="sec" id="tips" style="--c:var(--t3)">
          <h2><span class="num" aria-hidden="true">03</span>טיפים לחיסכון</h2>
          <ul class="tips">
            {d.tips.map((t) => <li>{t}</li>)}
            <li>השוו את אותו מלון בשלושה אתרים לפחות לפני ההזמנה.</li>
          </ul>
        </section>

        <div class="cta">
          <div>
            <p>כל המלונות ב{d.he} עם המחיר בכל אתר הזמנות, בלחיצה אחת.</p>
            <p>כל המלונות ב{d.he} עם המחיר בכל אתר הזמנות, לתאריכים ולאורחים של החיפוש האחרון שלכם.</p>
          </div>
          <div class="cta-go">
            <GoCompare he={d.he} en={d.en} slug={d.slug} label={`לכל המלונות ב${d.he}`} />
          </div>
        </div>
      </article>

      <QuickLinks he={d.he} en={d.en} source={d.slug} lat={geo[d.slug]?.lat} lng={geo[d.slug]?.lng} />
    </div>
  </section>

  {hotels.length > 0 && (
    <section class="section cat-sec">
      <div class="wrap">
        <h2 class="h2">מלונות פופולריים ב{d.he}</h2>
        {bestLists.length > 0 && (
          <p class="best-links">
            {bestLists.map((l) => <a href={href(listPath(d.slug, l.kind))}>{listTitle(l.kind, d.he)} ←</a>)}
          </p>
        )}
        <div class="cat">
          {hotels.map((h) => (
            <a class="ch" href={href(`/hotel/${d.slug}/${h.id}/`)}>
              {h.photo && <img src={h.photo} alt={h.name} loading="lazy" decoding="async" />}
              <div>
                <h3>{h.name}</h3>
                <p>
                  {h.stars > 0 && <span class="st">{'★'.repeat(Math.floor(h.stars))}</span>}
                  {h.score > 0 && <span class="sc">{h.score.toFixed(1)}</span>}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section faq-sec">
    <div class="wrap faq-wrap">
      <div>
        <p class="label">שאלות נפוצות</p>
        <h2 class="h2">מלונות ב{d.he}: שאלות ותשובות</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row-head">
        <h2 class="h2">עוד יעדים שאוהבים</h2>
        <a href={href('/destinations/')} class="btn btn-soft">כל היעדים <span class="arrow">←</span></a>
      </div>
      <div class="rel">{related.map((r) => <DestinationCard d={r} />)}</div>
    </div>
  </section>
</Base>

<style>
  .dock {
    position: relative;
    z-index: 5;
    margin-top: calc(-1 * clamp(56px, 6vw, 80px));
  }
  .live {
    padding-top: 56px;
  }
  .live[hidden] {
    display: none;
  }
  .row-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 32px;
    margin-bottom: 26px;
  }
  .row-head .h2 {
    margin: 0;
  }
  .sub {
    margin: 6px 0 0;
    color: var(--ink-2);
  }
  .demo {
    padding: 10px 14px;
    border-radius: 12px;
    background: #fff4d6;
    font-weight: 600;
    font-size: 14px;
  }
  .demo[hidden] {
    display: none;
  }
  .live-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .body {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 56px;
    align-items: start;
  }
  .intro {
    font-size: clamp(19px, 1.8vw, 23px);
    line-height: 1.55;
    margin-bottom: 48px;
  }
  .guide-link {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: -24px 0 40px;
    padding: 16px 18px;
    border-radius: var(--r-lg);
    background: var(--warm);
    font-weight: 600;
    color: var(--ink);
  }
  .guide-link:hover {
    background: var(--line);
  }
  .gl-tag {
    flex: none;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 13px;
  }
  .gl-t {
    flex: 1;
  }
  .best-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 10px 0 0;
  }
  .best-links a {
    font-weight: 700;
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cat-sec {
    background: var(--soft);
  }
  .cat {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
    margin-top: 24px;
  }
  .ch {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px;
    border-radius: var(--r);
    background: #fff;
    border: 1px solid var(--line);
  }
  .ch:hover {
    border-color: var(--ink);
  }
  .ch img {
    width: 64px;
    height: 64px;
    flex: none;
    border-radius: 12px;
    object-fit: cover;
  }
  .ch h3 {
    font-size: 15px;
    margin: 0 0 2px;
  }
  .ch p {
    margin: 0;
    display: flex;
    gap: 8px;
    font-size: 13px;
  }
  .st {
    color: var(--star);
  }
  .sc {
    padding: 0 6px;
    border-radius: 6px;
    background: var(--good);
    color: #fff;
    font-weight: 700;
  }
  .faq-sec {
    background: var(--warm);
  }
  .faq-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: start;
  }
  .rel {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  @media (max-width: 1060px) {
    .live-grid,
    .rel {
      grid-template-columns: repeat(2, 1fr);
    }
    .body,
    .faq-wrap {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  @media (max-width: 520px) {
    .live-grid,
    .rel {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { hotelCard, skeleton } from '../../lib/hotelcard';
  import { canonicalSearch } from '../../lib/searchkey';


  const sec = document.getElementById('live');
  // The live section exists only when the deployment shows prices.
  if (sec) {
  const { slug, he, en } = sec.dataset as { slug: string; he: string; en: string };
  const iso = (d: Date) => d.toISOString().slice(0, 10);
  const now = new Date();
  const thu = new Date(now);
  thu.setDate(now.getDate() + (((4 - now.getDay() + 7) % 7) || 7));
  const sat = new Date(thu);
  sat.setDate(thu.getDate() + 2);
  const checkin = iso(thu);
  const checkout = iso(sat);
  const fmt = (d: Date) => new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long' }).format(d);

  const grid = document.getElementById('live-grid')!;
  grid.innerHTML = skeleton(4, 'tile');
  fetch(`/api/search?${canonicalSearch({ slug, in: checkin, out: checkout, a: '2', c: '0', sort: 'PriceAsc', score: '7' })}`)
    .then((r) => r.json())
    .then((data) => {
      if ((data.mode !== 'live' && data.mode !== 'demo') || !data.hotels?.length) return;
      document.getElementById('live-demo')!.hidden = data.mode !== 'demo';
      document.getElementById('live-when')!.textContent = `${fmt(thu)} – ${fmt(sat)} · 2 מבוגרים · ציון 7+`;
      const q = { q: en, checkin, checkout, adults: 2, children: 0, rooms: 1, source: slug, city: en.split(',')[0] };
      grid.innerHTML = data.hotels.slice(0, 8).map((h: never) => hotelCard(h, q, 'tile')).join('');
      (document.getElementById('live-all') as HTMLAnchorElement).href =
        `/search/?${new URLSearchParams({ d: he, q: en, slug, in: checkin, out: checkout, a: '2', c: '0', r: '1' })}`;
      sec.hidden = false;
    })
    .catch(() => {});
  }
</script>
