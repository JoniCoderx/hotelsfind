---
// Multi-site comparison (beta). Lives beside /search/ until two real providers are connected.
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import { href } from '../lib/url';
import { priceMode } from '../lib/mode';

// Real comparison needs a connected provider and the verified hotel map; until then the page stays closed
// (development can still use sample data).
const open = priceMode() === 'live' || import.meta.env.DEV;
---
<Base title="השוואת מחירים | מלונזול" description="השוואת מחירי מלונות בין אתרי הזמנות, לפי המחיר הכולל לשהייה." noindex>
  {!open && (
    <div class="wrap cmp-page closed">
      <h1>השוואת מחירים בין אתרים: בקרוב</h1>
      <p>
        עוד לא חיברנו ספקי מחירים, ולכן אין כאן השוואה. בינתיים אפשר לפתוח את אותו חיפוש בכמה אתרי הזמנות ולראות את המחירים
        שם.
      </p>
      <a class="btn btn-fire" href={href('/#search')}>לחיפוש בכמה אתרים <span class="arrow">←</span></a>
    </div>
  )}
  {open && (<>
  <section class="top">
    <div class="wrap"><SearchForm action="/compare/" /></div>
  </section>

  <div class="wrap cmp-page">
    <h1 id="c-title">השוואת מחירים</h1>
    <p class="c-sum" id="c-sum">בחרו יעד, תאריכים ואורחים.</p>
    <label class="c-filter"><input type="checkbox" id="c-free" /> רק עם ביטול חינם</label>
    <p class="c-status" id="c-status" hidden></p>
    <p class="c-msg" id="c-msg" hidden></p>
    <p class="c-stale" id="c-stale" hidden>
      המחירים נבדקו לפני יותר מרבע שעה ואולי השתנו, ולכן הסרנו את סימון "הזול". <button type="button" class="btn btn-line" id="c-refresh">בדיקה מחדש</button>
    </p>
    <div class="c-list" id="c-list" aria-live="polite"></div>
    <p class="fine">
      מחירים לכל השהייה, בשקלים, כולל מיסים ותשלומי חובה כשהאתר מפרט אותם. הצעה שלא ידוע מה היא כוללת מוצגת בנפרד ולא מסומנת
      כזולה. המחירים נבדקים בזמן החיפוש ועשויים להשתנות עד ההזמנה. חלק מהקישורים הם קישורי שותפים, ואם תזמינו דרכם ייתכן שנקבל
      עמלה. מלונזול לא גובה מכם תשלום על השימוש או על ההפניה.
    </p>
  </div>
  </>)}
</Base>

<style>
  .closed {
    display: grid;
    justify-items: start;
    gap: 6px;
  }
  .top {
    background: var(--brand-band);
    padding-block: 18px 22px;
  }
  .cmp-page {
    max-width: 900px;
    padding-block: 28px 80px;
  }
  h1 {
    font-size: clamp(24px, 3vw, 34px);
    margin-bottom: 4px;
  }
  .c-sum {
    color: var(--ink-2);
  }
  .c-status {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .c-status :global(.ps) {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--soft);
  }
  .c-status :global(.ps.ok) {
    background: var(--good-soft);
    color: var(--good);
  }
  .c-msg {
    padding: 12px 16px;
    border-radius: var(--r);
    background: #fff4d6;
    font-weight: 600;
  }
  .c-filter {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    margin-block: 6px;
    font-size: 15px;
  }
  .c-stale {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: var(--r);
    background: var(--warm);
    font-weight: 600;
  }
  .c-stale .btn {
    height: 38px;
  }
  .c-list :global(.mo-note) {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  .c-list :global(.mo-via),
  .c-list :global(.mo-more) {
    font-size: 12.5px;
    color: var(--muted);
  }
  .c-status[hidden],
  .c-stale[hidden],
  .c-msg[hidden] {
    display: none;
  }
  .c-list {
    display: grid;
    gap: 16px;
  }
  .c-list :global(.mo) {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: #fff;
    padding: 20px 22px;
    box-shadow: var(--shadow);
  }
  .c-list :global(.mo-head) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: start;
  }
  .c-list :global(.mo-head h2) {
    margin: 0;
    font-size: 20px;
    line-height: 1.25;
  }
  .c-list :global(.mo-match) {
    flex: none;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-2);
    background: var(--soft);
    padding: 4px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .c-list :global(.mo-match.ok) {
    color: var(--good);
    background: var(--good-soft);
  }
  .c-list :global(.mo-notes) {
    list-style: none;
    margin: 12px 0 0;
    padding: 10px 12px;
    display: grid;
    gap: 4px;
    border-radius: 12px;
    background: #fff8e6;
    font-size: 14px;
    color: var(--sun-ink);
    line-height: 1.45;
  }
  .c-list :global(.mo-notes li) {
    display: flex;
    gap: 8px;
  }
  .c-list :global(.mo-notes li::before) {
    content: '!';
    flex: none;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
    font-size: 12px;
    font-weight: 800;
  }
  .c-list :global(.mo-rows) {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .c-list :global(.mo-row) {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 8px 18px;
    align-items: center;
    padding: 14px 16px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .c-list :global(.mo-row:hover) {
    border-color: #cfd8e6;
    box-shadow: var(--shadow-sm);
  }
  .c-list :global(.mo-row.best) {
    border: 2px solid var(--good);
    background: linear-gradient(180deg, var(--good-soft), #fff 70%);
    padding: 13px 15px;
  }
  .c-list :global(.mo-who) {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .c-list :global(.mo-who > b) {
    font-size: 17px;
  }
  .c-list :global(.mo-via) {
    font-size: 12.5px;
    color: var(--muted);
  }
  .c-list :global(.mo-best) {
    justify-self: start;
    font-size: 12.5px;
    font-weight: 800;
    color: #fff;
    background: var(--good);
    padding: 3px 10px;
    border-radius: 8px;
    line-height: 1.35;
  }
  .c-list :global(.mo-room) {
    font-size: 14px;
    color: var(--ink-2);
  }
  .c-list :global(.mo-more) {
    font-size: 12.5px;
    color: var(--muted);
  }
  .c-list :global(.mo-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }
  .c-list :global(.mo-tag) {
    font-size: 12.5px;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--soft);
    color: var(--ink-2);
  }
  .c-list :global(.mo-tag.good) {
    color: var(--good);
    background: var(--good-soft);
    font-weight: 700;
  }
  .c-list :global(.mo-tag.muted) {
    color: var(--muted);
  }
  .c-list :global(.mo-price) {
    display: grid;
    text-align: end;
    line-height: 1.3;
  }
  .c-list :global(.mo-price b) {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .c-list :global(.mo-row.best .mo-price b) {
    color: var(--good);
  }
  .c-list :global(.mo-price b.partial) {
    font-size: 20px;
    color: var(--ink-2);
  }
  .c-list :global(.mo-price small) {
    font-size: 12.5px;
    color: var(--ink-2);
    max-width: 24ch;
  }
  .c-list :global(.mo-go) {
    height: 46px;
    border-radius: 12px;
    font-weight: 700;
  }
  .fine {
    margin-top: 28px;
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .c-list :global(.mo) {
      padding: 14px;
    }
    .c-list :global(.mo-row) {
      grid-template-columns: 1fr;
    }
    .c-list :global(.mo-price) {
      text-align: start;
    }
    .c-list :global(.mo-price small) {
      max-width: none;
    }
    .c-list :global(.mo-head) {
      flex-direction: column;
      gap: 8px;
    }
    .c-list :global(.mo-go) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { adultsHe, kidsHe } from '../lib/he';
  import { compareCard, connectorLine } from '../lib/meta/card';
  import { formatRooms } from '../lib/meta/rooms';
  import type { CompareResult } from '../lib/meta/compare';

  const $ = (id: string) => document.getElementById(id)!;
  const p = new URLSearchParams(location.search);
  const slug = p.get('slug') || '';
  const checkin = p.get('in') || '';
  const checkout = p.get('out') || '';
  const adults = Number(p.get('a') || 2);
  const rooms = Number(p.get('r') || 1);
  const ages = p.getAll('ca').map(Number);
  const free = (document.getElementById('c-free') ?? document.createElement('input')) as HTMLInputElement;
  free.checked = p.get('free') === '1';
  // Phone or tablet as the browser reports it, not the window width (a narrow desktop window is still desktop).
  const nav = navigator as Navigator & { userAgentData?: { mobile?: boolean } };
  const device = (nav.userAgentData?.mobile ?? /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)) ? 'mobile' : 'desktop';
  let staleTimer: ReturnType<typeof setTimeout> | undefined;
  // Prices go stale while the page stays open; after this long we ask for a fresh search.
  const STALE_MS = 15 * 60_000;

  const say = (t: string) => {
    $('c-msg').textContent = t;
    $('c-msg').hidden = false;
  };

  async function run() {
    if (!slug || !checkin || !checkout) return;
    if (rooms !== 1) return say('בשלב הזה ההשוואה עובדת לחדר אחד בלבד. לכמה חדרים, חפשו כל חדר בנפרד.');
    $('c-msg').hidden = true;
    $('c-stale').hidden = true;
    clearTimeout(staleTimer);
    $('c-title').textContent = `השוואת מחירים: ${p.get('d') || slug}`;
    $('c-list').innerHTML = '<p>בודקים מחירים אצל האתרים המחוברים…</p>';
    const qs = new URLSearchParams({
      slug,
      in: checkin,
      out: checkout,
      rooms: formatRooms([{ adults, childAges: ages }]),
      dev: device,
      src: 'compare',
    });
    if (free.checked) qs.set('free', '1');
    try {
      const res = await fetch(`/api/compare?${qs}`);
      const data = (await res.json()) as CompareResult & { nights: number; off?: boolean; error?: string };
      if (data.error) return say('החיפוש לא תקין. בדקו יעד, תאריכים ואורחים.');
      if (data.off) return say('השוואת המחירים כבויה כרגע.');
      $('c-status').innerHTML = connectorLine(data.connectors, data.checkedAt);
      $('c-status').hidden = false;
      const compared = data.hotels.filter((h) => h.sitesCompared >= 2).length;
      $('c-sum').textContent = `${adultsHe(adults)}${ages.length ? `, ${kidsHe(ages.length)}` : ''} · ${data.nights} לילות · ${data.hotels.length} מלונות, ל-${compared} מהם מחירים כוללים משני אתרים או יותר`;
      if (!compared) say('לאף מלון בחיפוש הזה אין עדיין מחירים כוללים משני אתרים, כך שזו לא השוואה.');
      $('c-list').innerHTML = data.hotels.length
        ? data.hotels.map((h) => compareCard(h, data.nights, data.checkedAt)).join('')
        : '<p>לא התקבלו הצעות לחיפוש הזה מהאתרים שנבדקו.</p>';
      // After this the "cheapest" claim no longer holds: drop it and offer a fresh check.
      staleTimer = setTimeout(() => {
        document.querySelectorAll('.mo-best').forEach((b) => b.remove());
        document.querySelectorAll('.mo-row.best').forEach((r) => r.classList.remove('best'));
        document.querySelectorAll('.mo-go.btn-fire').forEach((a) => a.classList.replace('btn-fire', 'btn-line'));
        $('c-stale').hidden = false;
      }, STALE_MS);
    } catch {
      $('c-list').innerHTML = '';
      say('לא הצלחנו לקבל מחירים כרגע. נסו שוב בעוד רגע.');
    }
  }
  if (document.getElementById('c-list')) {
    $('c-refresh').addEventListener('click', run);
    free.addEventListener('change', () => {
      const u = new URL(location.href);
      if (free.checked) u.searchParams.set('free', '1');
      else u.searchParams.delete('free');
      history.replaceState(null, '', u);
      run();
    });
    run();
  }
</script>
