---
import Base from '../../../layouts/Base.astro';
import { destinations } from '../../../data/destinations';
import { catalog, type CatalogHotel } from '../../../lib/catalog';
import { partners } from '../../../lib/partners';
import { href } from '../../../lib/url';
import Img from '../../../components/Img.astro';
import { destPhotos, hotel as hotelPhotos } from '../../../data/photos';
import { geo } from '../../../data/geo';
import { guidesFor } from '../../../data/guides';

export function getStaticPaths() {
  return Object.entries(catalog).flatMap(([slug, list]) => {
    const d = destinations.find((x) => x.slug === slug);
    return d ? list.map((h) => ({ params: { slug, id: String(h.id) }, props: { h, slug } })) : [];
  });
}

const { h, slug } = Astro.props as { h: CatalogHotel; slug: string };
const d = destinations.find((x) => x.slug === slug)!;
// Distance in km between two points (good enough at city scale).
const km = (a: { lat: number; lng: number }, b: { lat: number; lng: number }) =>
  Math.hypot((a.lat - b.lat) * 111, (a.lng - b.lng) * 111 * Math.cos((a.lat * Math.PI) / 180));
const here = h.lat != null && h.lng != null ? { lat: h.lat, lng: h.lng } : null;
// The six nearest hotels in the catalog (the first six when this one has no coordinates).
const others = (catalog[slug] ?? [])
  .filter((x) => x.id !== h.id)
  .map((x) => ({ x, d: here && x.lat != null && x.lng != null ? km(here, { lat: x.lat, lng: x.lng }) : null }))
  .sort((a, b) => (a.d ?? 1e9) - (b.d ?? 1e9))
  .slice(0, 6);
// Distance from the city centre, only for cities (an island or a shore has no single centre).
const SPREAD = new Set(['crete', 'cyprus', 'rhodes', 'dead-sea']);
const centre = geo[slug];
const fromCentre = here && centre && !SPREAD.has(slug) ? km(here, centre) : null;
const kmHe = (n: number) => (n < 1 ? `${Math.round(n * 1000 / 50) * 50} מטר` : `${n.toFixed(1)} ק״מ`);
const destGuides = guidesFor(slug).slice(0, 3);
const cityPhoto = destPhotos[slug] ?? hotelPhotos.sunset;
const city = d.en.split(',')[0];
// Search results cut titles at about 60 characters: the full form when it fits, else the name (shortened if needed).
const pageTitle = (() => {
  const full = `${h.name}, ${d.he}: מחיר לתאריכים שלכם | מלונזול`;
  if (full.length <= 60) return full;
  const short = `${h.name}, ${d.he} | מלונזול`;
  if (short.length <= 60) return short;
  return `${h.name.slice(0, 48).replace(/[\s,&-]+\S*$/, '')}… | מלונזול`;
})();
const coords = h.lat != null && h.lng != null ? { lat: h.lat, lng: h.lng } : {};
const quick = partners.map((p) => ({ p, url: p.build({ q: `${h.nameEn}, ${city}`, adults: 2, children: 0, rooms: 1, source: 'hotel', ...coords }) }));
// A short description in Hebrew from the hotel's data; Agoda's own text (English, and cut at about 600 characters)
// stays below it, folded, ending at its last full sentence.
// Our own description from facts (stars, address, distance). The page uses no Agoda photos, texts or guest scores:
// its affiliate agreement does not allow Agoda content on a comparison site without written approval.
const about = [
  h.stars > 0 ? `מלון ${Math.floor(h.stars)} כוכבים ב${d.he}.` : `מקום לינה ב${d.he}.`,
  fromCentre != null ? `נמצא כ-${kmHe(fromCentre)} ממרכז ${d.he}.` : '',
  others[0]?.d != null ? `המלון הקרוב ביותר ברשימה שלנו: ${others[0].x.name}, במרחק ${kmHe(others[0].d)}.` : '',
].filter(Boolean).join(' ');
const abs = (path: string) => new URL(href(path), Astro.site).toString();
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Hotel',
    name: h.nameEn,
    alternateName: h.name !== h.nameEn ? h.name : undefined,
    address: { '@type': 'PostalAddress', streetAddress: h.address, addressLocality: h.city, addressCountry: d.country },
    geo: h.lat && h.lng ? { '@type': 'GeoCoordinates', latitude: h.lat, longitude: h.lng } : undefined,
    starRating: h.stars ? { '@type': 'Rating', ratingValue: h.stars } : undefined,
    url: abs(`/hotel/${slug}/${h.id}/`),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'מלונזול', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: `מלונות ב${d.he}`, item: abs(`/destinations/${slug}/`) },
      { '@type': 'ListItem', position: 3, name: h.name, item: abs(`/hotel/${slug}/${h.id}/`) },
    ],
  },
];
---
<Base
  title={pageTitle}
  description={`${h.name} ב${d.he}${h.stars ? `, מלון ${h.stars} כוכבים` : ''}. בדקו מחיר מ-Agoda לתאריכים שלכם, ואת המלון גם ב-Booking ועוד.`}
  jsonLd={ld}
  noindex={process.env.INDEX_HOTEL_PAGES === '0'}
>
  <section class="wrap hp">
    <nav class="crumbs" aria-label="פירורי לחם">
      <a href={href('/')}>ראשי</a><span>›</span><a href={href(`/destinations/${slug}/`)}>מלונות ב{d.he}</a><span>›</span><span aria-current="page">{h.name}</span>
    </nav>
    <div class="grid">
      <div>
        <figure class="ph-wrap">
          <Img photo={{ ...cityPhoto, alt: d.he }} class="ph" sizes="(max-width: 900px) 100vw, 60vw" max={1200} />
          <figcaption>{d.he}. תמונה של העיר, לא של המלון.</figcaption>
        </figure>
        <h1>{h.name}</h1>
        <p class="meta">
          {h.stars > 0 && <span class="st">{'★'.repeat(Math.floor(h.stars))}</span>}
          {h.address && <span>{h.address}</span>}
        </p>
        <p class="ov"><b><bdi>{h.name}</bdi></b>: {about}</p>
        <p class="ov">{d.intro}</p>
        <p class="ov"><b>מתי הכי משתלם:</b> {d.bestTime}</p>
        {h.lat && h.lng && (
          <a class="btn btn-soft" href={`https://www.google.com/maps/search/?api=1&query=${h.lat},${h.lng}`} target="_blank" rel="noopener">
            במפה
          </a>
        )}
      </div>

      <section class="box" id="rate" aria-labelledby="rate-h" data-id={h.id} data-name={h.nameEn} data-city={city} data-lat={h.lat ?? undefined} data-lng={h.lng ?? undefined}>
        <h2 id="rate-h">בדקו מחיר לתאריכים שלכם</h2>
        <form id="rate-form">
          <label>צ׳ק-אין<input type="date" name="in" required /></label>
          <label>צ׳ק-אאוט<input type="date" name="out" required /></label>
          <label>מבוגרים<input type="number" name="a" min="1" max="16" value="2" /></label>
          <label>ילדים<input type="number" name="c" min="0" max="10" value="0" /></label>
          <div class="kid-ages" id="kid-ages"></div>
          <button class="btn btn-fire" type="submit">בדיקת מחיר</button>
        </form>
        <div id="rate-out" class="out" aria-live="polite"></div>
        <p class="cmp-t">חיפוש המלון הזה גם ב:</p>
        <div class="cmp">
          {quick.map(({ p, url }) => <a class="ltr" href={url} data-site={p.id} target="_blank" rel="sponsored noopener">{p.name}</a>)}
        </div>
      </section>
    </div>
  </section>

  {others.length > 0 && (
    <section class="wrap more">
      <h2>מלונות קרובים ב{d.he}</h2>
      <ul class="near">
        {others.map(({ x, d: dist }) => (
          <li>
            <a href={href(`/hotel/${slug}/${x.id}/`)}><bdi>{x.name}</bdi></a>
            {dist != null && <span>{kmHe(dist)}</span>}
          </li>
        ))}
      </ul>
      <p class="more-links">
        <a href={href(`/destinations/${slug}/`)}>כל המלונות ב{d.he}</a>
        {destGuides.map((g) => <> · <a href={href(`/guides/${g.slug}/`)}>{g.title}</a></>)}
      </p>
    </section>
  )}
</Base>

<style>
  .hp {
    padding-block: 20px 60px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 40px;
    align-items: start;
  }
  .ph {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 24px;
    margin-bottom: 22px;
    background: var(--soft);
  }
  h1 {
    font-size: clamp(28px, 3.4vw, 42px);
    font-weight: 700;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
    color: var(--ink-2);
  }
  .st {
    color: var(--star);
  }
  .sc {
    padding: 2px 8px;
    border-radius: 8px;
    background: var(--good);
    color: #fff;
    font-weight: 700;
  }
  .ph-wrap {
    margin: 0 0 14px;
  }
  .ph-wrap :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--r-lg);
  }
  .ph-wrap figcaption {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 13px;
  }
  .near {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 8px 20px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }
  .near li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .near a {
    overflow: hidden;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .near span {
    flex: none;
    color: var(--ink-2);
  }
  .more-links a {
    font-weight: 600;
  }
  .ov {
    color: var(--ink-2);
    max-width: 70ch;
  }
  .ov-en {
    max-width: 70ch;
    margin: 0 0 16px;
    color: var(--ink-2);
  }
  .ov-en summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--brand);
  }
  .box {
    position: sticky;
    top: 90px;
    padding: 24px;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .box h2 {
    font-size: 20px;
  }
  form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  form label {
    display: grid;
    gap: 4px;
    font-size: 13px;
    font-weight: 700;
  }
  form input {
    font: inherit;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--soft);
  }
  form .btn {
    grid-column: 1 / -1;
  }
  .kid-ages {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .kid-ages:empty {
    display: none;
  }
  .kid-ages :global(select) {
    font: inherit;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: #fff;
  }
  .out:not(:empty) {
    margin-top: 16px;
    padding: 16px;
    border-radius: 16px;
    background: var(--warm);
  }
  .out :global(b) {
    font-size: 28px;
    font-weight: 700;
  }
  .out :global(.btn) {
    width: 100%;
    margin-top: 12px;
  }
  .out :global(.btn b) {
    font-size: inherit;
    margin-inline-start: 8px;
  }
  .out :global(.btn-line) {
    margin-top: 8px;
  }
  .cmp-t {
    margin: 18px 0 8px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .cmp {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cmp a {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-weight: 700;
    font-size: 14px;
  }
  .cmp a:hover {
    border-color: var(--ink);
  }
  .more {
    padding-bottom: 60px;
  }
  .cat {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
  }
  .ch {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px;
    border-radius: 16px;
    border: 1px solid var(--line);
    font-weight: 700;
  }
  .ch img {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .box {
      position: static;
    }
  }
  :global(#rate-out .reach) {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  import { adultsHe, kidsHe } from '../../../lib/he';
  import { goText, money, reachTag, reachText } from '../../../lib/hotelcard';
  import { agodaHotel, partners } from '../../../lib/partners';
  import { nameMatch, SAME_NAME } from '../../../lib/names';
  import type { Site } from '../../../lib/hotelpage';

  const box = document.getElementById('rate')!;
  const form = document.getElementById('rate-form') as HTMLFormElement;
  const out = document.getElementById('rate-out')!;
  const iso = (d: Date) => d.toISOString().slice(0, 10);
  const start = new Date(Date.now() + 14 * 86_400_000);
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  field('in').value = iso(start);
  field('out').value = iso(new Date(start.getTime() + 2 * 86_400_000));

  // Keep the traveller's party from the search (?in=&out=&a=&c=&ca=), and ask each child's age.
  const url = new URLSearchParams(location.search);
  const dateRe = /^\d{4}-\d{2}-\d{2}$/;
  for (const n of ['in', 'out']) if (dateRe.test(url.get(n) || '')) field(n).value = url.get(n)!;
  for (const n of ['a', 'c']) if (url.get(n)) field(n).value = url.get(n)!;
  const ages = document.getElementById('kid-ages')!;
  const startAges = url.getAll('ca');
  const renderAges = () => {
    const keep = [...ages.querySelectorAll('select')].map((x) => x.value);
    const n = Math.min(10, Math.max(0, Number(field('c').value) || 0));
    ages.innerHTML = Array.from({ length: n }, (_, i) => {
      const v = keep[i] ?? startAges[i] ?? '';
      const opts = Array.from({ length: 18 }, (_, a) => `<option value="${a}"${String(a) === v ? ' selected' : ''}>${a === 0 ? 'פחות משנה' : a}</option>`).join('');
      return `<label>גיל ילד ${i + 1}<select name="ca" required><option value="">גיל</option>${opts}</select></label>`;
    }).join('');
  };
  field('c').addEventListener('input', renderAges);
  renderAges();

  const noPrice = (agoda: string, booking: string, why = 'המחיר לתאריכים שבחרתם מופיע באתר ההזמנות.') =>
    `<div>${why}</div>
    <a class="btn btn-fire" href="${agoda}" data-site="agoda" target="_blank" rel="sponsored noopener">לחיפוש המלון ב-Agoda ←</a>
    <a class="btn btn-ink" href="${booking}" data-site="booking" target="_blank" rel="sponsored noopener">לחיפוש ב-Booking ←</a>
    <p class="reach">${reachText('Booking', false, 'booking')}</p>`;

  const siteName = (id: Site) => partners.find((p) => p.id === id)!.name;
  const km = (a: { lat: number; lng: number }, b: { lat: number; lng: number }) => {
    const r = Math.PI / 180;
    return Math.hypot((b.lng - a.lng) * r * Math.cos(((a.lat + b.lat) / 2) * r), (b.lat - a.lat) * r) * 6371;
  };
  /**
   * This hotel's last-seen price on each booking site for the dates, from the same source as the search: the
   * hotel is found in the destination's list by the same name rules as the booking links (within 400 m, or the
   * exact same name). Empty when it isn't there or no site has a price.
   */
  async function sitePrices(checkin: string, checkout: string, adults: number) {
    const slug = location.pathname.split('/')[2];
    const at = box.dataset.lat && box.dataset.lng ? { lat: Number(box.dataset.lat), lng: Number(box.dataset.lng) } : undefined;
    const page = (offset: number) =>
      fetch(`/api/hotels?${new URLSearchParams({ slug, offset: String(offset), in: checkin, out: checkout, a: String(adults), r: '1' })}`)
        .then((r) => r.json())
        .catch(() => ({}));
    const first = await page(0);
    const rest = await Promise.all([30, 60, 90, 120, 150].filter((o) => o < (first.total ?? 0)).map(page));
    let hit: { key: string; score: number } | undefined;
    for (const h of [first, ...rest].flatMap((p) => p.hotels ?? [])) {
      const score = nameMatch(box.dataset.name!, h.name, box.dataset.city);
      const near = at && h.lat != null && h.lng != null && km(at, h) <= 0.4;
      if (((near && score >= SAME_NAME) || score === 1) && (!hit || score > hit.score)) hit = { key: h.key, score };
    }
    if (!hit) return [];
    const text = await fetch(`/api/prices?${new URLSearchParams({ keys: hit.key, in: checkin, out: checkout, a: String(adults), r: '1' })}`).then((r) => r.text());
    for (const line of text.split('\n')) {
      try {
        const d = JSON.parse(line);
        if (d.key === hit.key) return (d.offers ?? []) as { site: Site; price: number }[];
      } catch {}
    }
    return [];
  }

  // The "also on" links carry the traveller's dates and party once they are known.
  function datedQuick(st: { checkin: string; checkout: string; adults: number; children: number; childAges: number[] }) {
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.cmp a[data-site]')) {
      const site = a.dataset.site!;
      a.href =
        site === 'agoda'
          ? agodaHotel(box.dataset.id!, st)
          : partners.find((p) => p.id === site)!.build({ q: `${box.dataset.name}, ${box.dataset.city}`, ...st, rooms: 1, source: 'hotel', lat: box.dataset.lat ? Number(box.dataset.lat) : undefined, lng: box.dataset.lng ? Number(box.dataset.lng) : undefined });
    }
  }
  if (dateRe.test(url.get('in') || '') && dateRe.test(url.get('out') || '') && url.get('out')! > url.get('in')! && !Number(field('c').value)) {
    datedQuick({ checkin: url.get('in')!, checkout: url.get('out')!, adults: Number(field('a').value) || 2, children: 0, childAges: [] });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const checkin = String(f.get('in'));
    const checkout = String(f.get('out'));
    const adults = Number(f.get('a')) || 2;
    const childAges = f.getAll('ca').map(Number);
    const children = childAges.length;
    if (checkout <= checkin) {
      out.textContent = 'תאריך היציאה צריך להיות אחרי תאריך ההגעה.';
      return;
    }
    out.textContent = 'בודקים מחיר…';
    const onAgoda = agodaHotel(box.dataset.id!, { checkin, checkout, adults, children, childAges });
    const fallback = partners
      .find((p) => p.id === 'booking')!
      .build({
        q: `${box.dataset.name}, ${box.dataset.city}`,
        checkin,
        checkout,
        adults,
        children,
        childAges,
        rooms: 1,
        source: 'hotel',
        lat: box.dataset.lat ? Number(box.dataset.lat) : undefined,
        lng: box.dataset.lng ? Number(box.dataset.lng) : undefined,
      });
    datedQuick({ checkin, checkout, adults, children, childAges });
    try {
      const q = new URLSearchParams({ ids: box.dataset.id!, in: checkin, out: checkout, a: String(adults), c: String(children) });
      if (children) q.set('ages', childAges.join(','));
      const res = await fetch(`/api/rates?${q}`);
      const data = await res.json();
      const h = data.hotels?.[0];
      if (data.mode === 'live' && h) {
        const party = `${adultsHe(adults)}${children ? `, ${kidsHe(children)} (${children === 1 ? 'גיל' : 'גילים'} ${childAges.join(', ')})` : ''}`;
        out.innerHTML = `<div><small>מחיר מ-Agoda</small> <b>${money(h.rate, h.currency)}</b> ללילה, לחדר אחד</div>
          <div>ל${party}. לפני מיסים ודמי שירות. המחיר הסופי מופיע ב-Agoda לפני התשלום.</div>
          <a class="btn btn-fire" href="${h.url}" target="_blank" rel="sponsored noopener">להזמנה ב-Agoda ←</a>`;
      } else {
        // Prices we have are for adults only: with children none is shown, and the links carry the whole party.
        if (children) {
          out.innerHTML = noPrice(onAgoda, fallback, `אין לנו מחיר שכולל ${kidsHe(children)}: המחירים שאנחנו משווים הם למבוגרים בלבד. הקישורים פותחים את המלון עם התאריכים והילדים, והמחיר המדויק מופיע שם.`);
          return;
        }
        // The last-seen price on each site, cheapest first. Agoda's hotel link and the other sites open searches.
        const prices = (await sitePrices(checkin, checkout, adults)).sort((a, b) => a.price - b.price);
        if (!prices.length) {
          out.innerHTML = noPrice(onAgoda, fallback);
          return;
        }
        const link = (site: Site) =>
          site === 'agoda'
            ? onAgoda
            : partners.find((p) => p.id === site)!.build({ q: `${box.dataset.name}, ${box.dataset.city}`, checkin, checkout, adults, children, childAges, rooms: 1, source: 'hotel', lat: box.dataset.lat ? Number(box.dataset.lat) : undefined, lng: box.dataset.lng ? Number(box.dataset.lng) : undefined });
        // Cheapest first; at exactly the same price, Agoda first (its link targets the hotel by its catalog ID).
        const ordered = [...prices].sort((a, b) => a.price - b.price || Number(b.site === 'agoda') - Number(a.site === 'agoda'));
        const [best, ...others] = ordered;
        const tied = prices.filter((o) => o.price === best.price);
        const nights = Math.round((Date.parse(checkout) - Date.parse(checkin)) / 86_400_000);
        const where = tied.length > 1 ? `אותו מחיר ב-${tied.map((o) => `<bdi>${siteName(o.site)}</bdi>`).join(' וב-')}` : `${prices.length > 1 ? 'הכי זול ב-' : 'ב-'}<bdi>${siteName(best.site)}</bdi>`;
        out.innerHTML = `<div><small>${where}</small> <b>${money(best.price)}</b> ללילה${nights > 1 ? ` · ${money(best.price * nights)} ל-${nights} לילות` : ''}</div>
          <div>ל${adultsHe(adults)} בחדר אחד. המחיר האחרון שנמצא, לא תמיד כולל מיסים ועמלות, וסוג החדר ותנאי הביטול יכולים להיות שונים בין האתרים. המחיר הסופי מופיע באתר לפני התשלום.</div>
          <a class="btn btn-fire" href="${link(best.site)}" data-site="${best.site}" target="_blank" rel="sponsored noopener">${goText(siteName(best.site), best.site === 'agoda', best.site)} ←</a>
          ${((t) => (t ? `<p class="reach">${t}</p>` : ''))(reachText(siteName(best.site), best.site === 'agoda', best.site))}
          ${others.map((o) => `<a class="btn btn-line" href="${link(o.site)}" data-site="${o.site}" target="_blank" rel="sponsored noopener"><bdi>${siteName(o.site)}</bdi> <b>${money(o.price)}</b> <small>${reachTag(o.site === 'agoda', o.site)}</small></a>`).join('')}`;
      }
    } catch {
      out.innerHTML = noPrice(onAgoda, fallback);
    }
  });
</script>
