</style>

<script>
  import { hotelCard, skeleton } from '../lib/hotelcard';
  import { canonicalSearch } from '../lib/searchkey';
  import type { Hotel } from '../lib/agoda';

  // ---------- floating search button (phones) once the hero search is out of view ----------
  const fab = document.getElementById('fab');
  const box = document.getElementById('search');
  if (fab && box) {
    new IntersectionObserver(([e]) => fab.classList.toggle('on', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(box);
    fab.addEventListener('click', (e) => {
      e.preventDefault();
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => box.querySelector<HTMLInputElement>('#sf-q')?.focus({ preventScroll: true }), 450);
    });
  }

  // ---------- radar demo loop ----------
  const demo = document.getElementById('radar-demo');
  if (demo) {
    const rows = [...demo.querySelectorAll<HTMLLIElement>('.rows li')];
    const dots = [...demo.querySelectorAll<HTMLElement>('.dot')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const best = rows.reduce((a, b) => (Number(b.dataset.p) < Number(a.dataset.p) ? b : a));
    const finish = () => {
      rows.forEach((r) => r.classList.add('done', r === best ? 'win' : 'lose'));
      dots.forEach((d, i) => d.classList.add('on', ...(rows[i] === best ? ['win'] : [])));
    };
    const reset = () => {
      rows.forEach((r) => r.classList.remove('scan', 'done', 'win', 'lose'));
      dots.forEach((d) => d.classList.remove('on', 'win'));
    };
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const run = async () => {
      for (;;) {
        reset();
        await wait(500);
        for (let i = 0; i < rows.length; i++) {
          rows[i].classList.add('scan');
          await wait(520);
          rows[i].classList.remove('scan');
          rows[i].classList.add('done');
          dots[i].classList.add('on');
          await wait(160);
        }
        await wait(300);
        finish();
        await wait(3400);
      }
    };
    if (still) finish();
    else {
      // Start only when the card scrolls into view.
      const io = new IntersectionObserver((e) => {
        if (e.some((x) => x.isIntersecting)) {
          io.disconnect();
          run();
        }
      });
      io.observe(demo);
    }
  }

  // ---------- live weekend deals ----------
  const iso = (d: Date) => d.toISOString().slice(0, 10);
  const now = new Date();
  const thu = new Date(now);
  thu.setDate(now.getDate() + (((4 - now.getDay() + 7) % 7) || 7));
  const sat = new Date(thu);
  sat.setDate(thu.getDate() + 2);
  const checkin = iso(thu);
  const checkout = iso(sat);
  const fmt = (d: Date) => new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long' }).format(d);

  const section = document.getElementById('deals');
  const grid = document.getElementById('deal-grid')!;
  const all = document.getElementById('deals-all') as HTMLAnchorElement;
  const tabs = [...(section?.querySelectorAll<HTMLButtonElement>('[role=tab]') ?? [])];
  const cache = new Map<string, { mode: string; hotels: Hotel[] }>();

  async function fetchDeals(slug: string) {
    if (!cache.has(slug)) {
      const qs = canonicalSearch({ slug, in: checkin, out: checkout, a: '2', c: '0', sort: 'PriceAsc', score: '7' });
      const res = await fetch(`/api/search?${qs}`);
      cache.set(slug, await res.json());
    }
    return cache.get(slug)!;
  }

  async function show(tab: HTMLButtonElement) {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    const slug = tab.dataset.slug!;
    const he = tab.dataset.he!;
    grid.innerHTML = skeleton(4, 'tile');
    const data = await fetchDeals(slug).catch(() => null);
    if (!data || (data.mode !== 'live' && data.mode !== 'demo') || !data.hotels.length) {
      grid.innerHTML = `<p>אין כרגע דילים להצגה ב${he}. <a href="/destinations/${slug}/">לכל המלונות ב${he}</a></p>`;
      return;
    }
    document.getElementById('deals-demo')!.hidden = data.mode !== 'demo';
    const q = { q: he, checkin, checkout, adults: 2, children: 0, rooms: 1, source: 'deals', city: he };
    grid.innerHTML = data.hotels.slice(0, 4).map((h) => hotelCard(h, q, 'tile')).join('');
    all.href = `/search/?${new URLSearchParams({ d: he, slug, in: checkin, out: checkout, a: '2', c: '0', r: '1' })}`;
  }

  // Only reveal the section when live prices are actually available.
  if (section) fetchDeals(tabs[0].dataset.slug!)
    .then((d) => {
      if (d.mode !== 'live' && d.mode !== 'demo') return;
      document.getElementById('deals-when')!.textContent = `${fmt(thu)} – ${fmt(sat)} · 2 מבוגרים · ציון 7+ · מהזול ליקר`;
      section.hidden = false;
      tabs.forEach((t) => t.addEventListener('click', () => show(t)));
      show(tabs[0]);
    })
    .catch(() => {});
</script>
