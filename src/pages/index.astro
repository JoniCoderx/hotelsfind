</style>

<script>
  import { hotelCard, money, skeleton } from '../lib/hotelcard';
  import { directLink, type Site } from '../lib/hotelpage';
  import { partners } from '../lib/partners';
  import { canonicalSearch } from '../lib/searchkey';
  import type { Hotel } from '../lib/agoda';

  // ---------- floating search button (phones) once the hero search is out of view ----------
  const fab = document.getElementById('fab');
  const box = document.getElementById('search');
  if (fab && box) {
    new IntersectionObserver(([e]) => fab.classList.toggle('on', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(box);
    fab.addEventListener('click', (e) => {
      e.preventDefault();
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => box.querySelector<HTMLInputElement>('#sf-q')?.focus({ preventScroll: true }), 450);
    });
  }

  const siteNameOf = (s: Site) => partners.find((p) => p.id === s)?.name ?? s;

  // ---------- a real hotel, its price on each site ----------
  const ld = document.getElementById('live-demo');
  if (ld) {
    const el = (id: string) => document.getElementById(id)!;
    const esc = (t: string) => String(t).replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    const iso = (d: Date) => d.toISOString().slice(0, 10);
    // The same weekend as the deals below (their answers are shared through the cache).
    const soon = new Date(Date.now() + 10 * 86_400_000);
    const thu = new Date(soon.getTime() + ((4 - soon.getDay() + 7) % 7) * 86_400_000);
    const sat = new Date(thu.getTime() + 2 * 86_400_000);
    const stay = { checkin: iso(thu), checkout: iso(sat), adults: 2, children: 0, rooms: 1 };
    const places = [
      { slug: 'eilat', he: 'אילת' },
      { slug: 'tel-aviv', he: 'תל אביב' },
      { slug: 'dead-sea', he: 'ים המלח' },
    ];
    const place = places[new Date().getDate() % places.length];
    const fmt = new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'short' });
    type Price = { site: Site; price: number };
    type H = { key: string; name: string; image: string; rating: number; hotel: boolean; lat?: number; lng?: number; prices?: Price[] };
    let shown: { prices: Price[]; id: string } | null = null;

    const paint = () => {
      if (!shown) return;
      const { prices, id } = shown;
      const top = prices[prices.length - 1].price;
      el('ld-rows').innerHTML = prices
        .map((o, i) => `<li class="${i === 0 ? 'win' : ''}"><span class="name" dir="ltr">${siteNameOf(o.site)}</span><span class="bar"><i style="width:${Math.max(18, Math.round((o.price / top) * 100))}%"></i></span><span class="price">${money(o.price)}</span></li>`)
        .join('');
      const save = top - prices[0].price;
      el('ld-save').innerHTML = save >= 10 ? `אותו חדר, הפרש של <b>${money(save)}</b> ללילה` : 'המחיר דומה בכל האתרים הפעם';
      const go = el('ld-go') as HTMLAnchorElement;
      if (id) {
        go.href = directLink(prices[0].site, id, stay, 'home_demo');
        go.innerHTML = `לדיל ב-<bdi>${siteNameOf(prices[0].site)}</bdi> <span class="arrow" aria-hidden="true">←</span>`;
        go.target = '_blank';
        go.rel = 'sponsored noopener';
      }
      go.hidden = false;
    };
    window.addEventListener('mz:currency', paint);

    const fail = () => {
      el('ld-name').textContent = `מלונות ב${place.he}`;
      el('ld-rows').innerHTML = '';
      el('ld-save').textContent = 'לא הצלחנו להביא דוגמה כרגע. בחיפוש תראו את המחירים לכל מלון.';
      const go = el('ld-go') as HTMLAnchorElement;
      go.href = searchUrl();
      go.innerHTML = `לכל המלונות ב${place.he} <span class="arrow" aria-hidden="true">←</span>`;
      go.hidden = false;
    };
    const searchUrl = () => {
      const u = new URL(ld.dataset.search!, location.href);
      for (const [k, v] of Object.entries({ d: place.he, slug: place.slug, in: stay.checkin, out: stay.checkout, a: '2', c: '0', r: '1' })) u.searchParams.set(k, v);
      return u.toString();
    };

    async function pickHotel(): Promise<H | null> {
      const qs = new URLSearchParams({ slug: place.slug, in: stay.checkin, out: stay.checkout, a: '2', c: '0', r: '1' });
      const list = await fetch(`/api/hotels?${qs}`).then((r) => r.json());
      const hotels: H[] = (list.hotels || []).filter((h: H) => h.hotel && h.rating >= 4 && h.image).slice(0, 10);
      if (list.source !== 'google') {
        const res = await fetch(`/api/prices?${new URLSearchParams({ keys: hotels.map((h) => h.key).join(','), in: stay.checkin, out: stay.checkout, a: '2', r: '1' })}`);
        for (const line of (await res.text()).split('\n')) {
          try {
            const d = JSON.parse(line);
            const h = hotels.find((x) => x.key === d.key);
            if (h) h.prices = d.offers ?? [];
          } catch {}
        }
      }
      // The hotel priced on the most sites, then the one where checking another site pays most.
      const spread = (h: H) => (h.prices!.length ? h.prices![h.prices!.length - 1].price - h.prices![0].price : 0);
      const ok = hotels.filter((h) => (h.prices?.length ?? 0) >= 2);
      ok.sort((a, b) => b.prices!.length - a.prices!.length || spread(b) - spread(a));
      return ok[0] ?? null;
    }

    async function run() {
      el('ld-when').textContent = `${place.he} · ${fmt.format(thu)} – ${fmt.format(sat)} · 2 לילות · 2 מבוגרים`;
      const h = await pickHotel().catch(() => null);
      if (!h) return fail();
      const prices = [...h.prices!].sort((a, b) => a.price - b.price).slice(0, 5);
      el('ld-name').innerHTML = `<bdi>${esc(h.name)}</bdi>`;
      el('ld-img').innerHTML = `<img src="${esc(h.image)}" alt="" loading="lazy" decoding="async" />`;
      shown = { prices, id: '' };
      paint();
      // The deal button opens the hotel's own page on the cheapest site, once we know its ID there.
      const qs = new URLSearchParams({ v: '3', key: h.key, name: h.name, slug: place.slug });
      if (h.lat != null && h.lng != null) {
        qs.set('lat', String(h.lat));
        qs.set('lng', String(h.lng));
      }
      const d = await fetch(`/api/ids?${qs}`).then((r) => r.json()).catch(() => ({}));
      const id = d.ids?.[prices[0].site];
      if (!id) {
        const go = el('ld-go') as HTMLAnchorElement;
        go.href = searchUrl();
        go.innerHTML = `להשוואה המלאה ב${place.he} <span class="arrow" aria-hidden="true">←</span>`;
        return;
      }
      shown.id = id;
      paint();
    }

    const io = new IntersectionObserver(
      (e) => {
        if (e.some((x) => x.isIntersecting)) {
          io.disconnect();
          run();
        }
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(ld);
  }

  // ---------- live weekend deals ----------
  const iso = (d: Date) => d.toISOString().slice(0, 10);
  const now = new Date();
  const thu = new Date(now);
  thu.setDate(now.getDate() + (((4 - now.getDay() + 7) % 7) || 7));
  const sat = new Date(thu);
  sat.setDate(thu.getDate() + 2);
  const checkin = iso(thu);
  const checkout = iso(sat);
  const fmt = (d: Date) => new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long' }).format(d);

  const section = document.getElementById('deals');
  const grid = document.getElementById('deal-grid')!;
  const all = document.getElementById('deals-all') as HTMLAnchorElement;
  const tabs = [...(section?.querySelectorAll<HTMLButtonElement>('[role=tab]') ?? [])];
  const cache = new Map<string, { mode: string; hotels: Hotel[] }>();

  async function fetchDeals(slug: string) {
    if (!cache.has(slug)) {
      const qs = canonicalSearch({ slug, in: checkin, out: checkout, a: '2', c: '0', sort: 'PriceAsc', score: '7' });
      const res = await fetch(`/api/search?${qs}`);
      cache.set(slug, await res.json());
    }
    return cache.get(slug)!;
  }

  async function show(tab: HTMLButtonElement) {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    const slug = tab.dataset.slug!;
    const he = tab.dataset.he!;
    grid.innerHTML = skeleton(4, 'tile');
    const data = await fetchDeals(slug).catch(() => null);
    if (!data || (data.mode !== 'live' && data.mode !== 'demo') || !data.hotels.length) {
      grid.innerHTML = `<p>אין כרגע דילים להצגה ב${he}. <a href="/destinations/${slug}/">לכל המלונות ב${he}</a></p>`;
      return;
    }
    document.getElementById('deals-demo')!.hidden = data.mode !== 'demo';
    const q = { q: he, checkin, checkout, adults: 2, children: 0, rooms: 1, source: 'deals', city: he };
    grid.innerHTML = data.hotels.slice(0, 4).map((h) => hotelCard(h, q, 'tile')).join('');
    all.href = `/search/?${new URLSearchParams({ d: he, slug, in: checkin, out: checkout, a: '2', c: '0', r: '1' })}`;
  }

  // Only reveal the section when live prices are actually available.
  if (section) fetchDeals(tabs[0].dataset.slug!)
    .then((d) => {
      if (d.mode !== 'live' && d.mode !== 'demo') return;
      document.getElementById('deals-when')!.textContent = `${fmt(thu)} – ${fmt(sat)} · 2 מבוגרים · ציון 7+ · מהזול ליקר`;
      section.hidden = false;
      tabs.forEach((t) => t.addEventListener('click', () => show(t)));
      show(tabs[0]);
    })
    .catch(() => {});
</script>
