---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import DestinationCard from '../components/DestinationCard.astro';
import Faq from '../components/Faq.astro';
import Img from '../components/Img.astro';
import { israel, abroad } from '../data/destinations';
import { hotel } from '../data/photos';
import { partners } from '../lib/partners';
import { site } from '../data/site';
import { href } from '../lib/url';

const faq = [
  {
    q: 'מה זה לילה זול?',
    a: 'לילה זול הוא מנוע השוואת מחירים למלונות בעברית. במקום לפתוח חמישה אתרים ולהקליד שוב ושוב, מחפשים פעם אחת ואנחנו מעבירים את אותו חיפוש בדיוק ל-Booking, Agoda, Expedia, Hotels.com ו-Trip.com.',
  },
  {
    q: 'כמה זה עולה?',
    a: 'כלום. השימוש חינמי לחלוטין ואנחנו לא מוסיפים שקל למחיר. אנחנו מקבלים עמלת שותפים מאתרי ההזמנות על הזמנות שמתבצעות דרכנו, והיא לא משפיעה על המחיר שלכם.',
  },
  {
    q: 'למה אותו מלון מופיע במחירים שונים באתרים שונים?',
    a: 'כל אתר הזמנות מנהל חוזים, מבצעים, הנחות חברים ושערי מטבע משלו. לכן אותו חדר באותו לילה יכול להופיע בהפרשים משמעותיים. השוואה לוקחת כמה שניות ויכולה לחסוך מאות שקלים.',
  },
  {
    q: 'אתם מבטיחים את המחיר הכי נמוך?',
    a: 'לא. אנחנו לא מוכרים חדרים ולא קובעים מחירים. אנחנו מחברים אתכם לאתרים הגדולים כדי שתראו את כל האפשרויות. המחיר הסופי ותנאי ההזמנה נקבעים על ידי אתר ההזמנות.',
  },
  {
    q: 'עם מי אני מזמין בפועל?',
    a: 'ההזמנה, התשלום ושירות הלקוחות הם ישירות מול אתר ההזמנות שבחרתם, למשל Booking.com או Agoda. כך אתם נהנים מההגנה ומהשירות של החברות הגדולות בעולם.',
  },
  {
    q: 'המחירים כוללים מע"מ ומיסים?',
    a: 'זה תלוי ביעד ובאתר. בחו"ל יש לעיתים מס עירוני שמשולם במלון. לפני התשלום בדקו את "המחיר הסופי" באתר השותף.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

// Illustration only: what a comparison looks like. Not real prices.
const receipt = [
  { name: 'Expedia', p: 1384 },
  { name: 'Hotels.com', p: 1342 },
  { name: 'Booking.com', p: 1236 },
  { name: 'Trip.com', p: 1198 },
  { name: 'Agoda', p: 1104 },
];
const max = Math.max(...receipt.map((r) => r.p));
const min = Math.min(...receipt.map((r) => r.p));
const ils = (n: number) => `₪${n.toLocaleString('en-US')}`;
---
<Base title={`לילה זול | השוואת מחירי מלונות: Booking, Agoda ועוד בחיפוש אחד`} description={site.description} jsonLd={[faqLd]} overlayHeader>
  <!-- HERO -->
  <section class="hero">
    <Img photo={hotel.hero} eager class="hero-img" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <p class="over">משווים את <span class="ltr">Booking · Agoda · Expedia · Hotels.com · Trip.com</span> בחיפוש אחד</p>
      <h1 class="display d-xxl">אותו חדר.<br />לילה יותר <span class="accent">זול.</span></h1>
    </div>
  </section>

  <div class="wrap search-dock" id="search">
    <SearchForm />
    <ul class="facts">
      <li><b>₪0</b> עמלה. אף פעם.</li>
      <li><b>5</b> אתרי ההזמנות הגדולים</li>
      <li><b>מיליוני</b> מלונות ודירות</li>
      <li>מזמינים <b>ישירות</b> אצל השותף</li>
    </ul>
  </div>

  <!-- HOW -->
  <section class="section" id="how">
    <div class="wrap how">
      <div class="how-head">
        <p class="kicker">איך זה עובד</p>
        <h2 class="display d-xl">שלושה צעדים.<br />עשר שניות.</h2>
      </div>
      <ol class="steps">
        <li class="reveal">
          <span class="display n">1</span>
          <h3>מחפשים פעם אחת</h3>
          <p>יעד, תאריכים ומספר אורחים. בעברית, מכל מכשיר.</p>
        </li>
        <li class="reveal">
          <span class="display n">2</span>
          <h3>משווים את כולם</h3>
          <p>אנחנו פותחים את אותו חיפוש בדיוק בחמשת אתרי ההזמנות הגדולים, עם כל הפרטים מוכנים.</p>
        </li>
        <li class="reveal">
          <span class="display n">3</span>
          <h3>מזמינים בזול</h3>
          <p>בוחרים את המחיר הכי טוב ומזמינים ישירות אצל השותף. בלי תיווך ובלי תוספות.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- WHY: photo + receipt -->
  <section class="why">
    <div class="why-ph reveal">
      <Img photo={hotel.terrace} sizes="(max-width: 900px) 100vw, 50vw" />
    </div>
    <div class="why-txt">
      <p class="kicker">למה להשוות</p>
      <h2 class="display d-xl">אותו חדר.<br /><span class="accent">חמישה מחירים.</span></h2>
      <p class="lead">
        לכל אתר הזמנות יש חוזים, מבצעים, הנחות מועדון ושערי מטבע משלו. אותו לילה באותו מלון יכול להיות זול משמעותית
        באתר אחד מאשר באתר אחר. רוב האנשים בודקים רק אתר אחד, ומשלמים על זה.
      </p>
      <figure class="receipt reveal" aria-label="המחשה: אותו חדר מופיע במחירים שונים באתרים שונים">
        <figcaption>
          <b>חדר זוגי · 2 לילות</b>
          <span>דוגמה להמחשה בלבד</span>
        </figcaption>
        <ul>
          {receipt.map((r) => (
            <li class:list={{ best: r.p === min }}>
              <span class="ltr">{r.name}</span>
              <span class="dots" aria-hidden="true"></span>
              <span class="ltr price">{ils(r.p)}</span>
            </li>
          ))}
        </ul>
        <div class="save">
          <span>ההפרש בין הזול ליקר</span>
          <b class="ltr">{ils(max - min)}</b>
        </div>
      </figure>
    </div>
  </section>

  <!-- ISRAEL -->
  <section class="section" id="destinations">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="kicker">חופשה בארץ</p>
          <h2 class="display d-xl">ישראל</h2>
        </div>
        <a href={href('/destinations/')} class="btn btn-line">כל היעדים <span class="arrow">←</span></a>
      </div>
      <div class="dgrid">
        {israel.slice(0, 6).map((d, i) => <DestinationCard d={d} n={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="band">
    <Img photo={hotel.rooftop} class="band-img" />
    <div class="band-shade" aria-hidden="true"></div>
    <div class="wrap band-in">
      <p class="display d-lg">
        אנחנו לא מוכרים חדרים.<br />אנחנו מראים לכם <span class="moon">איפה הם הכי זולים.</span>
      </p>
    </div>
  </section>

  <!-- ABROAD -->
  <section class="section">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="kicker">טסים לחו"ל</p>
          <h2 class="display d-xl">היעדים של הישראלים</h2>
        </div>
      </div>
      <div class="dgrid">
        {abroad.map((d, i) => <DestinationCard d={d} n={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- PARTNERS -->
  <section class="section partners-sec" id="partners">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="kicker">אתרי ההזמנות</p>
          <h2 class="display d-xl">חמישה ענקים.<br />חיפוש אחד.</h2>
        </div>
        <p class="lead">לכל אתר יש נקודות חוזק. הנה מה ששווה לדעת על כל אחד מהם לפני שמזמינים.</p>
      </div>
      <ol class="plist">
        {partners.map((p, i) => (
          <li class="reveal">
            <span class="pn ltr">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="ltr">{p.name}</h3>
            <p>{p.pitch}</p>
            <p class="tip"><b>טיפ:</b> {p.tip}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="wrap faq-wrap">
      <div>
        <p class="kicker">שאלות נפוצות</p>
        <h2 class="display d-xl faq-h">שאלתם.<br />ענינו.</h2>
        <p class="lead">עוד משהו? <a class="mail ltr" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <!-- SEO copy -->
  <section class="section seo">
    <div class="wrap prose">
      <h2>השוואת מחירי מלונות בישראל ובעולם</h2>
      <p>
        לילה זול הוא אתר השוואת מחירי מלונות בעברית, שנבנה עבור מטיילים ישראלים. במקום לבדוק כל אתר בנפרד, אתם מחפשים פעם אחת
        ורואים את האפשרויות באתרי ההזמנות המובילים: Booking.com, Agoda, Expedia, Hotels.com ו-Trip.com. בין אם אתם מחפשים
        <a href={href('/destinations/eilat/')}>מלון באילת</a> לסופ"ש, <a href={href('/destinations/dead-sea/')}>מלון ספא בים המלח</a>,
        <a href={href('/destinations/tel-aviv/')}>מלון בוטיק בתל אביב</a> או חופשה ב<a href={href('/destinations/athens/')}>אתונה</a>,
        <a href={href('/destinations/dubai/')}>דובאי</a> ו<a href={href('/destinations/paris/')}>פריז</a>, ההשוואה עוזרת לכם למצוא את
        המחיר המשתלם ביותר לאותו חדר.
      </p>
      <h3>איך חוסכים במלונות?</h3>
      <ul>
        <li>השוו לפחות שלושה אתרים לפני כל הזמנה. ההפרשים יכולים להיות גדולים.</li>
        <li>הזמינו עם ביטול חינם, ובדקו שוב את המחיר שבוע לפני הנסיעה.</li>
        <li>הצטרפו למועדוני החברים (Genius, One Key, Agoda VIP). זה חינמי ופותח הנחות.</li>
        <li>אמצע שבוע זול כמעט תמיד מסוף שבוע, גם בארץ וגם בחו"ל.</li>
        <li>בדקו את המחיר הסופי כולל מיסים ודמי שירות לפני התשלום.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: min(100svh, 980px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
    padding-bottom: 150px;
  }
  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: settle 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes settle {
    from {
      transform: scale(1.08);
    }
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(15, 26, 42, 0.78) 0%, rgba(15, 26, 42, 0.25) 45%, rgba(15, 26, 42, 0.05) 70%),
      linear-gradient(180deg, rgba(15, 26, 42, 0.45) 0%, transparent 22%);
  }
  .hero-in {
    position: relative;
    padding-top: 140px;
  }
  .over {
    font-weight: 600;
    font-size: 16px;
    opacity: 0.92;
    margin-bottom: 18px;
  }
  .hero h1 {
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.2);
  }

  .search-dock {
    position: relative;
    z-index: 5;
    margin-top: -92px;
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 40px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .facts b {
    color: var(--ink);
    font-weight: 900;
  }

  /* HOW */
  .how {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: end;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .steps li {
    border-top: 1.5px solid var(--ink);
    padding-top: 18px;
  }
  .n {
    display: block;
    font-size: 120px;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .steps h3 {
    font-size: 21px;
  }
  .steps p {
    color: var(--ink-2);
    margin: 0;
  }

  /* WHY */
  .why {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--paper-2);
  }
  .why-ph {
    min-height: 640px;
    position: relative;
  }
  .why-ph :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .why-txt {
    padding: clamp(56px, 7vw, 110px) clamp(24px, 6vw, 96px);
  }
  .receipt {
    margin: 36px 0 0;
    max-width: 440px;
    background: #fff;
    padding: 26px 28px 22px;
    box-shadow: 0 30px 60px -35px rgba(15, 26, 42, 0.5);
    border-radius: 2px;
    position: relative;
  }
  .receipt::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -10px;
    height: 10px;
    background: linear-gradient(-45deg, transparent 6px, #fff 0) 0 0 / 14px 10px repeat-x,
      linear-gradient(45deg, transparent 6px, #fff 0) 0 0 / 14px 10px repeat-x;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 14px;
    margin-bottom: 8px;
    border-bottom: 1.5px dashed var(--line-strong);
    font-size: 15px;
  }
  figcaption span {
    font-size: 12px;
    color: var(--muted);
  }
  .receipt ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .receipt li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 9px 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .dots {
    flex: 1;
    border-bottom: 2px dotted var(--line-strong);
    transform: translateY(-4px);
  }
  .price {
    color: var(--ink-2);
  }
  .receipt li:not(.best) .price {
    text-decoration: line-through;
    text-decoration-color: rgba(255, 91, 46, 0.6);
  }
  .receipt li.best {
    margin: 4px -12px;
    padding-inline: 12px;
    background: var(--accent);
    color: #fff;
    font-weight: 900;
  }
  .receipt li.best .price {
    color: #fff;
  }
  .receipt li.best .dots {
    border-color: rgba(255, 255, 255, 0.6);
  }
  .save {
    display: flex;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 14px;
    border-top: 1.5px dashed var(--line-strong);
    font-size: 15px;
  }
  .save b {
    font-size: 22px;
    font-weight: 900;
  }

  /* DESTINATIONS */
  .row-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px 48px;
    margin-bottom: 56px;
  }
  .row-head .lead {
    margin: 0;
    max-width: 44ch;
  }
  .dgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 56px 28px;
  }

  /* MANIFESTO BAND */
  .band {
    position: relative;
    min-height: 620px;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
  }
  .band :global(.band-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(270deg, rgba(15, 26, 42, 0.82) 0%, rgba(15, 26, 42, 0.45) 55%, rgba(15, 26, 42, 0.1) 100%);
  }
  .band-in {
    position: relative;
  }
  .band p {
    max-width: 17ch;
  }
  .moon {
    color: var(--moon);
  }

  /* PARTNERS */
  .partners-sec {
    background: var(--card);
    border-block: 1px solid var(--line);
  }
  .plist {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--ink);
  }
  .plist li {
    display: grid;
    grid-template-columns: 70px 1.1fr 1.4fr 1.6fr;
    gap: 24px;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--line-strong);
  }
  .pn {
    color: var(--accent);
    font-weight: 900;
  }
  .plist h3 {
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin: 0;
    text-align: right;
  }
  .plist p {
    margin: 0;
    color: var(--ink-2);
  }
  .tip {
    font-size: 15px;
  }
  .tip b {
    color: var(--accent);
  }

  /* FAQ */
  .faq-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 72px;
    align-items: start;
  }
  .faq-h {
    margin-bottom: 28px;
  }
  .mail {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
  .seo {
    padding-top: 0;
  }

  @media (max-width: 1100px) {
    .how,
    .faq-wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .dgrid {
      grid-template-columns: repeat(2, 1fr);
    }
    .plist li {
      grid-template-columns: 50px 1fr;
    }
    .plist li p {
      grid-column: 2;
    }
  }
  @media (max-width: 900px) {
    .why {
      grid-template-columns: 1fr;
    }
    .why-ph {
      min-height: 420px;
    }
  }
  @media (max-width: 700px) {
    .hero {
      padding-bottom: 120px;
    }
    .search-dock {
      margin-top: -70px;
    }
    .steps {
      grid-template-columns: 1fr;
    }
    .n {
      font-size: 90px;
    }
    .dgrid {
      grid-template-columns: 1fr;
    }
    .band {
      min-height: 480px;
    }
  }
</style>
