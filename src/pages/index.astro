---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import Stories from '../components/Stories.astro';
import DestinationCard from '../components/DestinationCard.astro';
import Faq from '../components/Faq.astro';
import Img from '../components/Img.astro';
import { hotel } from '../data/photos';
import { israel, abroad } from '../data/destinations';
import { partners } from '../lib/partners';
import { guides, guidePhoto } from '../data/guides';
import { destPhotos } from '../data/photos';
import { site } from '../data/site';
import { href } from '../lib/url';
import { priceMode } from '../lib/mode';

const live = priceMode() === 'live';

const faq = [
  {
    q: 'מה זה מלונזול?',
    a: live
      ? 'מלונזול הוא אתר חיפוש מלונות בעברית. מחפשים פעם אחת ורואים מחירים מ-Agoda לתאריכים שלכם, ובלחיצה פותחים את אותו יעד ותאריכים גם ב-Booking, Expedia, Hotels.com ו-Trip.com כדי לבדוק את המחיר שם.'
      : 'מלונזול הוא אתר חיפוש מלונות בעברית. מזינים יעד, תאריכים ואורחים פעם אחת, ובלחיצה פותחים את אותו חיפוש ב-Booking, Agoda, Expedia, Hotels.com ו-Trip.com. את המחירים רואים באתרים עצמם.',
  },
  {
    q: 'כמה זה עולה?',
    a: 'כלום. מלונזול לא גובה תשלום על השימוש או על ההפניה. ייתכן שאתר ההזמנות ישלם לנו עמלת שותפים על הזמנה שהגיעה דרכנו. המחיר נקבע באתר ההזמנות.',
  },
  {
    q: 'למה אותו מלון במחירים שונים באתרים שונים?',
    a: 'לכל אתר הזמנות יש חוזים, מבצעים, הנחות חברים ושערי מטבע משלו. לכן אותו חדר באותו לילה יכול להופיע במחירים שונים. בדיקה בעוד אתר לוקחת דקה.',
  },
  {
    q: live ? 'המחירים אצלכם אמיתיים?' : 'אתם מציגים מחירים?',
    a: live ? 'המחירים שמוצגים אצלנו מגיעים מ-Agoda בזמן החיפוש, לפי התאריכים ומספר האורחים שבחרתם. את המחירים של Booking ושאר האתרים אנחנו לא מציגים: הם מופיעים באתר עצמו אחרי הלחיצה. כל מחיר יכול להשתנות עד רגע ההזמנה, והמחיר הקובע הוא זה שבאתר ההזמנות לפני התשלום.'
      : 'כן. אחרי החיפוש מוצגים מלונות עם המחיר ללילה בכל אתר הזמנות, למשל Booking, Agoda ו-Trip.com, לפי התאריכים ומספר האורחים שבחרתם, וההצעה הזולה מסומנת. המחירים יכולים להשתנות עד רגע ההזמנה, והמחיר הקובע הוא זה שמופיע באתר ההזמנות לפני התשלום.',
  },
  {
    q: 'עם מי אני מזמין בפועל?',
    a: 'ההזמנה, התשלום ושירות הלקוחות הם ישירות מול אתר ההזמנות, למשל Agoda או Booking.com.',
  },
  {
    q: 'המחירים כוללים מיסים?',
    a: 'המחירים שאנחנו מציגים הם ללילה ולפני מיסים ודמי שירות, כמו שאתרי ההזמנות מפרסמים אותם. בחו"ל יש לעיתים מס עירוני שמשולם במלון. לפני התשלום בדקו את המחיר הסופי באתר.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const dealTabs = [
  { slug: 'eilat', he: 'אילת' },
  { slug: 'dead-sea', he: 'ים המלח' },
  { slug: 'tel-aviv', he: 'תל אביב' },
  { slug: 'athens', he: 'אתונה' },
  { slug: 'dubai', he: 'דובאי' },
];
---
<Base overlay title={live ? "מלונזול | מחירי מלונות מ-Agoda ובדיקה מהירה ב-Booking ועוד" : "מלונזול | השוואת מחירי מלונות מ-Booking, Agoda ועוד"} description={site.description} jsonLd={[faqLd]}>
  <!-- HERO -->
  <section class="hero">
    <Img photo={{ ...hotel.hero, alt: '' }} class="hero-bg" eager sizes="100vw" max={2000} />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <div class="hero-txt rise">
        <h1 class="h1">מחפשים מלון<i class="ldot" style="--c:#ff6a5f" aria-hidden="true"></i><br /><span class="sun">בודקים מחירים</span><i class="ldot" style="--c:#ffb400" aria-hidden="true"></i><br />בוחרים איפה להזמין<i class="ldot" style="--c:#5ff0d8" aria-hidden="true"></i></h1>
        <p class="lead">{live ? "מחירים מ-Agoda לתאריכים שלכם, ובלחיצה אחת אותו יעד ותאריכים גם ב-Booking, Expedia ועוד." : "מזינים יעד ותאריכים פעם אחת ורואים מחירים מכמה אתרי הזמנות, או פותחים את אותו חיפוש ב-Booking, Agoda, Expedia ועוד."}</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="pc">
          <p class="pc-h"><b>מלון חוף, אילת</b><span>2 לילות · דוגמה</span></p>
          {live && <p class="pc-price"><small>מחיר מ-Agoda</small><b class="ltr">₪552</b> <span>ללילה, לפני מיסים</span></p>}
          <ul>
            <li><span>בדיקת מחיר ב-<bdi>Booking.com</bdi></span><i aria-hidden="true">←</i></li>
            <li><span>בדיקת מחיר ב-<bdi>Expedia</bdi></span><i aria-hidden="true">←</i></li>
            <li><span>בדיקת מחיר ב-<bdi>Trip.com</bdi></span><i aria-hidden="true">←</i></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
  <div class="wrap search" id="search"><SearchForm /></div>
  <div class="wrap">
    <ul class="trust">
      <li>השימוש ללא תשלום</li>
      <li>{live ? "מחירים חיים מ-Agoda" : "מחירים מכמה אתרי הזמנות"}</li>
      <li>מזמינים ישירות באתר המקורי</li>
    </ul>
  </div>
  {!live && (
    <div class="wrap">
      <ol class="next" aria-label="מה קורה אחרי החיפוש">
        <li>מזינים יעד, תאריכים ואורחים פעם אחת</li>
        <li>פותחים את אותו חיפוש ב-5 אתרי הזמנות</li>
        <li>רואים שם מחירים ומזמינים באתר שבחרתם</li>
      </ol>
    </div>
  )}
  <div class="wrap stories-wrap"><Stories /></div>

  <a href="#search" class="fab" id="fab" aria-hidden="true" tabindex="-1">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.6" fill="none"/><path d="m20 20-3.6-3.6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
    חיפוש מלון
  </a>

  <!-- HOW: live radar demo -->
  <section class="section how" id="how">
    <div class="wrap how-in">
      <div class="how-txt">
        <p class="label">איך זה עובד</p>
        <h2 class="h2">חיפוש אחד.<br />חמישה אתרים בלחיצה.</h2>
        <ol class="steps">
          <li><b>בוחרים יעד ותאריכים</b><span>בעברית, מכל מכשיר.</span></li>
          {live && <li><b>רואים מחירים מ-Agoda</b><span>מלונות, ציונים ומחיר ללילה לתאריכים שלכם.</span></li>}
          <li><b>בודקים גם ב-Booking ובשאר האתרים</b><span>אותו יעד ותאריכים נפתחים שם בלחיצה, בלי להקליד מחדש.</span></li>
          <li><b>מזמינים איפה שמשתלם לכם</b><span>ישירות באתר ההזמנות.</span></li>
        </ol>
      </div>
      <div class="demo-card" id="radar-demo" aria-label="המחשה: אותו חדר יכול לעלות אחרת בכל אתר">
        <div class="scope" aria-hidden="true">
          <span class="sweep"></span>
          {[0, 1, 2, 3, 4].map((i) => <i class="dot" data-i={i}></i>)}
        </div>
        <ul class="rows">
          {[
            { n: 'אתר א׳', p: 1384 },
            { n: 'אתר ב׳', p: 1236 },
            { n: 'אתר ג׳', p: 1342 },
            { n: 'אתר ד׳', p: 1104 },
            { n: 'אתר ה׳', p: 1198 },
          ].map((r, i) => (
            <li data-i={i} data-p={r.p}>
              <span class="name">{r.n}</span>
              <span class="state">ממתין</span>
              <span class="ltr price">₪{r.p.toLocaleString('en-US')}</span>
            </li>
          ))}
        </ul>
        <p class="demo-note">המחשה בלבד, לא בדיקת מחירים אמיתית: כך אותו חדר זוגי ל-2 לילות יכול להיות מתומחר באתרים שונים. לכן שווה לבדוק יותר מאתר אחד.</p>
      </div>
    </div>
  </section>

  <!-- WHY COMPARE -->
  <section class="section why">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="label">למה להשוות?</p>
          <h2 class="h2">אותו חדר עולה אחרת בכל אתר</h2>
        </div>
        <a href={href('/how-it-works/')} class="link">להסבר המלא <span class="arrow">←</span></a>
      </div>
      <div class="why-grid rail" tabindex="0" aria-label="למה להשוות">
        <article class="reveal">
          <h3>כל אתר מקבל עסקה אחרת</h3>
          <p>המלון חותם עם כל אתר הזמנות על חוזה ועמלה שונים. חלק מהאתרים מוותרים על רווח כדי להוריד מחיר.</p>
        </article>
        <article class="reveal">
          <h3>מבצעים שמתחלפים כל הזמן</h3>
          <p>דילים של רגע אחרון, מחירי אפליקציה ומבצעי סופ"ש. כל אתר מפעיל אותם בזמן אחר.</p>
        </article>
        <article class="reveal">
          <h3>מטבע, מיסים ועמלות</h3>
          <p>אתר אחד מציג בדולרים לפני מיסים, אחר בשקלים כולל הכל. הזול בהתחלה לא תמיד זול בסוף.</p>
        </article>
        <article class="reveal">
          <h3>ואצלנו זה בלי תשלום</h3>
          <p>אנחנו לא גובים כלום ולא מוסיפים סכום למחיר. ייתכן שאתר ההזמנות ישלם לנו עמלה.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- LIVE DEALS -->
  {live && (
  <section class="section deals" id="deals" hidden>
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="label">נמצא עכשיו</p>
          <h2 class="h2">דילים לסופ"ש הקרוב</h2>
          <p class="sub" id="deals-when"></p>
        </div>
        <div class="tabs" role="tablist" aria-label="יעד">
          {dealTabs.map((t, i) => (
            <button type="button" role="tab" data-slug={t.slug} data-he={t.he} aria-selected={i === 0 ? 'true' : 'false'}>
              {t.he}
            </button>
          ))}
        </div>
      </div>
      <p class="demo" id="deals-demo" hidden>נתוני דוגמה: מפתח Agoda עוד לא מחובר.</p>
      <div class="deal-grid rail" id="deal-grid"></div>
      <a class="btn btn-line more" id="deals-all" href="/search/">לכל המלונות <span class="arrow">←</span></a>
    </div>
  </section>
  )}

  <!-- GUIDES -->
  <section class="section guides-home">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="label">לפני שמזמינים</p>
          <h2 class="h2">מדריכים: איפה לישון ומה לבדוק</h2>
        </div>
        <a href={href('/guides/')} class="link">כל המדריכים <span class="arrow">←</span></a>
      </div>
      <div class="gh rail">
        {guides.slice(0, 4).map((g) => (
          <a class="ghc" href={href(`/guides/${g.slug}/`)}>
            <div class="ph"><Img photo={guidePhoto(g)} sizes="(max-width: 600px) 70vw, 300px" max={800} /></div>
            <h3>{g.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ISRAEL -->
  <section class="section">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="label">חופשה בארץ</p>
          <h2 class="h2">מלונות בישראל</h2>
        </div>
        <a href={href('/destinations/')} class="link">כל היעדים <span class="arrow">←</span></a>
      </div>
      <div class="grid3 rail">
        {israel.slice(0, 6).map((d) => <DestinationCard d={d} sizes="(max-width: 600px) 60vw, 380px" />)}
      </div>
    </div>
  </section>

  <!-- ABROAD -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="label">טסים לחו"ל</p>
          <h2 class="h2">היעדים שכולם אוהבים</h2>
        </div>
      </div>
      <div class="grid4 rail">
        {abroad.slice(0, 8).map((d) => <DestinationCard d={d} sizes="(max-width: 600px) 60vw, 380px" />)}
      </div>
    </div>
  </section>

  <!-- PARTNERS -->
  <section class="partners">
    <div class="wrap partners-in">
      <p>קישורים מהירים ל-5 אתרי הזמנות</p>
      <ul>
        {partners.map((p) => <li class="ltr">{p.name}</li>)}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="wrap faq-wrap">
      <div>
        <p class="label">שאלות נפוצות</p>
        <h2 class="h2">שאלתם, ענינו.</h2>
        <p class="lead">עוד משהו? כתבו לנו: <span class="ltr mail">{site.email}</span></p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <!-- SEO copy -->
  <section class="section seo">
    <div class="wrap prose">
      <h2>{live ? "השוואת מחירי מלונות בישראל ובעולם" : "השוואת מחירי מלונות בישראל ובעולם"}</h2>
      <p>
        מלונזול הוא אתר חיפוש מלונות בעברית, שנבנה עבור מטיילים ישראלים. {live
          ? 'מחפשים פעם אחת, רואים מחירים מ-Agoda לתאריכים שלכם, ובלחיצה בודקים את אותו יעד ותאריכים גם ב-Booking.com, Expedia, Hotels.com ו-Trip.com.'
          : 'מזינים יעד ותאריכים פעם אחת, רואים מחירים חיים מכמה אתרי הזמנות, ובלחיצה פותחים את אותו חיפוש ב-Booking.com, Agoda, Expedia, Hotels.com ו-Trip.com.'} בין אם אתם מחפשים
        <a href={href('/destinations/eilat/')}>מלון באילת</a> לסופ"ש, <a href={href('/destinations/dead-sea/')}>מלון ספא בים המלח</a>,
        <a href={href('/destinations/tel-aviv/')}>מלון בוטיק בתל אביב</a> או חופשה ב<a href={href('/destinations/athens/')}>אתונה</a>,
        <a href={href('/destinations/dubai/')}>דובאי</a> ו<a href={href('/destinations/paris/')}>פריז</a>, תוכלו לבדוק כאן כמה אתרים בלי להקליד את החיפוש מחדש.
      </p>
      <h3>איך חוסכים במלונות?</h3>
      <ul>
        <li>השוו לפחות שלושה אתרים לפני כל הזמנה. ההפרשים יכולים להיות גדולים.</li>
        <li>הזמינו עם ביטול חינם, ובדקו שוב את המחיר שבוע לפני הנסיעה.</li>
        <li>הצטרפו למועדוני החברים (Genius, One Key, Agoda VIP). זה חינמי ופותח הנחות.</li>
        <li>אמצע שבוע לרוב זול יותר מסוף שבוע, גם בארץ וגם בחו"ל.</li>
        <li>בדקו את המחיר הסופי כולל מיסים ודמי שירות לפני התשלום.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .gh {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .ghc {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--line);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .ghc:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .ghc .ph {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .ghc .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ghc h3 {
    margin: 0;
    padding: 14px 16px 16px;
    font-size: 17px;
    line-height: 1.35;
  }
  @media (max-width: 900px) {
    .gh {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(44px, 8vw, 112px) clamp(84px, 9vw, 128px);
    background: var(--brand);
    color: #fff;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    animation: hero-zoom 18s ease-out both;
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.08);
    }
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(270deg, rgba(6, 30, 120, 0.88) 0%, rgba(8, 44, 170, 0.62) 55%, rgba(8, 44, 170, 0.25) 100%),
      linear-gradient(0deg, rgba(6, 24, 90, 0.55) 0%, transparent 45%);
  }
  .hero-in {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 40px;
  }
  .hero h1 {
    margin: 0 0 14px;
    font-size: clamp(38px, 5.8vw, 70px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 24px rgba(4, 16, 70, 0.35);
  }
  .sun {
    color: var(--sun);
  }
  .hero .lead {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(17px, 1.6vw, 20px);
    color: rgba(255, 255, 255, 0.92);
  }
  .hero-art {
    perspective: 900px;
  }
  .pc {
    width: 290px;
    padding: 18px;
    border-radius: 22px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 30px 60px -24px rgba(4, 20, 80, 0.6);
    transform: rotate(-4deg);
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    50% {
      transform: rotate(-3deg) translateY(-8px);
    }
  }
  .pc-h {
    margin: 0 0 10px;
    line-height: 1.3;
  }
  .pc-h b {
    display: block;
    font-size: 17px;
  }
  .pc-h span {
    font-size: 13px;
    color: var(--muted);
  }
  .pc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
