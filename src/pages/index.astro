---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import Stories from '../components/Stories.astro';
import DestinationCard from '../components/DestinationCard.astro';
import Faq from '../components/Faq.astro';
import Img from '../components/Img.astro';
import { israel, abroad } from '../data/destinations';
import { hotel } from '../data/photos';
import { partners } from '../lib/partners';
import { site } from '../data/site';
import { href } from '../lib/url';

const faq = [
  {
    q: 'מה זה StayRadar?',
    a: 'StayRadar הוא מנוע השוואת מחירי מלונות בעברית. מחפשים פעם אחת ורואים מחירים בזמן אמת, ואת אותו חיפוש בדיוק אפשר לפתוח בלחיצה ב-Booking, Agoda, Expedia, Hotels.com ו-Trip.com.',
  },
  {
    q: 'כמה זה עולה?',
    a: 'כלום. השימוש חינמי ואנחנו לא מוסיפים שקל למחיר. אתרי ההזמנות משלמים לנו עמלת שותפים על הזמנות שמגיעות מאיתנו, והיא לא משפיעה על המחיר שלכם.',
  },
  {
    q: 'למה אותו מלון במחירים שונים באתרים שונים?',
    a: 'לכל אתר הזמנות יש חוזים, מבצעים, הנחות חברים ושערי מטבע משלו. לכן אותו חדר באותו לילה יכול להופיע בהפרשים משמעותיים. השוואה של כמה שניות יכולה לחסוך מאות שקלים.',
  },
  {
    q: 'המחירים אצלכם אמיתיים?',
    a: 'כן. המחירים מגיעים ישירות מאתר ההזמנות בזמן החיפוש, לפי התאריכים ומספר האורחים שבחרתם. הם יכולים להשתנות עד רגע ההזמנה, והמחיר הסופי הוא זה שמופיע באתר השותף.',
  },
  {
    q: 'עם מי אני מזמין בפועל?',
    a: 'ההזמנה, התשלום ושירות הלקוחות הם ישירות מול אתר ההזמנות, למשל Agoda או Booking.com. כך אתם נהנים מההגנה והשירות של החברות הגדולות בעולם.',
  },
  {
    q: 'המחירים כוללים מיסים?',
    a: 'המחירים שאנחנו מציגים הם ללילה ולפני מיסים ודמי שירות, כמו שאתרי ההזמנות מפרסמים אותם. בחו"ל יש לעיתים מס עירוני שמשולם במלון. לפני התשלום בדקו את המחיר הסופי באתר.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const dealTabs = [
  { slug: 'eilat', he: 'אילת' },
  { slug: 'dead-sea', he: 'ים המלח' },
  { slug: 'tel-aviv', he: 'תל אביב' },
  { slug: 'athens', he: 'אתונה' },
  { slug: 'dubai', he: 'דובאי' },
];
---
<Base title="StayRadar | הרדאר של מחירי המלונות: השוואת מחירים בזמן אמת" description={site.description} jsonLd={[faqLd]}>
  <!-- HERO -->
  <section class="hero" id="search">
    <div class="float f1" aria-hidden="true">
      <Img photo={hotel.infinity} sizes="260px" max={800} />
      <span class="sticker s-a">🔥 דיל חם</span>
    </div>
    <div class="float f2" aria-hidden="true">
      <Img photo={hotel.room} sizes="220px" max={800} />
      <span class="sticker s-b">☕ ארוחת בוקר</span>
    </div>
    <div class="float f3" aria-hidden="true">
      <Img photo={hotel.pool} sizes="200px" max={800} />
      <span class="sticker s-c">✓ ביטול חינם</span>
    </div>

    <div class="hero-radar" aria-hidden="true"><span></span></div>
    <div class="wrap hero-in">
      <p class="pill">משווים <b>Agoda · Booking · Expedia · Hotels.com · Trip.com</b> בזמן אמת</p>
      <h1 class="h1">כל מחירי המלונות.<br /><span class="fire">על רדאר אחד.</span></h1>
      <p class="lead">סורקים בשבילכם את כל אתרי ההזמנות, תופסים את המחיר הכי נמוך ומזמינים בלחיצה. בלי עמלות, בלי הפתעות.</p>
      <div class="search"><SearchForm /></div>
      <ul class="trust">
        <li><b>₪0</b> עמלה</li>
        <li><b>5</b> אתרי הזמנות</li>
        <li><b>מחירים</b> בזמן אמת</li>
        <li><b>הזמנה</b> מאובטחת אצל השותף</li>
      </ul>
    </div>
  </section>

  <div class="wrap stories-wrap">
    <Stories />
  </div>

  <!-- LIVE DEALS -->
  <section class="section deals" id="deals" hidden>
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="label">📡 נתפס על הרדאר עכשיו</p>
          <h2 class="h2">דילים חמים לסופ"ש הקרוב</h2>
          <p class="sub" id="deals-when"></p>
        </div>
        <div class="tabs" role="tablist" aria-label="יעד">
          {dealTabs.map((t, i) => (
            <button type="button" role="tab" data-slug={t.slug} data-he={t.he} aria-selected={i === 0 ? 'true' : 'false'}>
              {t.he}
            </button>
          ))}
        </div>
      </div>
      <p class="demo" id="deals-demo" hidden>⚠️ נתוני דוגמה: מפתח Agoda עוד לא מחובר.</p>
      <div class="deal-grid" id="deal-grid"></div>
      <a class="btn btn-ink more" id="deals-all" href="/search/">לכל המלונות <span class="arrow">←</span></a>
    </div>
  </section>

  <!-- HOW -->
  <section class="section how-sec" id="how">
    <div class="wrap">
      <p class="label">איך זה עובד</p>
      <h2 class="h2">שלושה צעדים. עשר שניות.</h2>
      <div class="how">
        <article class="step reveal" style="--c:#ffe9df">
          <span class="ico">📡</span>
          <h3>מחפשים פעם אחת</h3>
          <p>יעד, תאריכים ומספר אורחים. בעברית, מכל מכשיר.</p>
        </article>
        <article class="step reveal" style="--c:#fff3d1">
          <span class="ico">⚡</span>
          <h3>רואים מחירים חיים</h3>
          <p>מלונות אמיתיים עם מחירים לתאריכים שלכם, וקיצור דרך לאותו חיפוש בכל אתרי ההזמנות.</p>
        </article>
        <article class="step reveal" style="--c:#e3f5ec">
          <span class="ico">✅</span>
          <h3>מזמינים בזול</h3>
          <p>בוחרים את הדיל ומזמינים ישירות אצל השותף. בלי תיווך ובלי תוספות.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ISRAEL -->
  <section class="section">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="label">חופשה בארץ</p>
          <h2 class="h2">מלונות בישראל</h2>
        </div>
        <a href={href('/destinations/')} class="btn btn-soft">כל היעדים <span class="arrow">←</span></a>
      </div>
      <div class="bento">
        {israel.slice(0, 5).map((d, i) => <DestinationCard d={d} big={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- ABROAD -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="label">טסים לחו"ל</p>
          <h2 class="h2">היעדים שכולם אוהבים</h2>
        </div>
      </div>
      <div class="grid4">
        {abroad.slice(0, 8).map((d) => <DestinationCard d={d} />)}
      </div>
    </div>
  </section>

  <!-- PARTNERS -->
  <section class="section partners-sec">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="label">אתרי ההזמנות</p>
          <h2 class="h2">חמישה ענקים. חיפוש אחד.</h2>
        </div>
        <p class="lead">לכל אתר יש נקודות חוזק. הנה מה ששווה לדעת לפני שמזמינים.</p>
      </div>
      <div class="pgrid">
        {partners.map((p) => (
          <article class="pc reveal" style={`--a:${p.accent}`}>
            <h3 class="ltr">{p.name}</h3>
            <p>{p.pitch}</p>
            <p class="tip">💡 {p.tip}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="wrap faq-wrap">
      <div>
        <p class="label">שאלות נפוצות</p>
        <h2 class="h2">שאלתם, ענינו.</h2>
        <p class="lead">עוד משהו? <a class="mail ltr" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <!-- SEO copy -->
  <section class="section seo">
    <div class="wrap prose">
      <h2>השוואת מחירי מלונות בישראל ובעולם</h2>
      <p>
        StayRadar הוא אתר השוואת מחירי מלונות בעברית, שנבנה עבור מטיילים ישראלים. במקום לבדוק כל אתר בנפרד, מחפשים פעם אחת ורואים
        מחירים בזמן אמת מאתרי ההזמנות המובילים: Agoda, Booking.com, Expedia, Hotels.com ו-Trip.com. בין אם אתם מחפשים
        <a href={href('/destinations/eilat/')}>מלון באילת</a> לסופ"ש, <a href={href('/destinations/dead-sea/')}>מלון ספא בים המלח</a>,
        <a href={href('/destinations/tel-aviv/')}>מלון בוטיק בתל אביב</a> או חופשה ב<a href={href('/destinations/athens/')}>אתונה</a>,
        <a href={href('/destinations/dubai/')}>דובאי</a> ו<a href={href('/destinations/paris/')}>פריז</a>, תמצאו כאן את המחיר המשתלם ביותר.
      </p>
      <h3>איך חוסכים במלונות?</h3>
      <ul>
        <li>השוו לפחות שלושה אתרים לפני כל הזמנה. ההפרשים יכולים להיות גדולים.</li>
        <li>הזמינו עם ביטול חינם, ובדקו שוב את המחיר שבוע לפני הנסיעה.</li>
        <li>הצטרפו למועדוני החברים (Genius, One Key, Agoda VIP). זה חינמי ופותח הנחות.</li>
        <li>אמצע שבוע זול כמעט תמיד מסוף שבוע, גם בארץ וגם בחו"ל.</li>
        <li>בדקו את המחיר הסופי כולל מיסים ודמי שירות לפני התשלום.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 50% 0%, #fff 0%, transparent 70%),
      var(--warm);
    padding-block: clamp(48px, 7vw, 96px) 64px;
    text-align: center;
  }
  .hero-radar {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(1100px, 140vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
    background: repeating-radial-gradient(circle, transparent 0 89px, rgba(10, 92, 255, 0.09) 90px 91px);
    mask-image: radial-gradient(circle, #000 35%, transparent 70%);
    -webkit-mask-image: radial-gradient(circle, #000 35%, transparent 70%);
  }
  .hero-radar span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, rgba(10, 124, 255, 0.1), rgba(0, 201, 167, 0.03) 18%, transparent 26%);
    animation: hero-sweep 7s linear infinite;
  }
  @keyframes hero-sweep {
    to {
      transform: rotate(360deg);
    }
  }
  .hero-in {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 22px;
  }
  .pill {
    margin: 0;
    padding: 8px 16px;
    border-radius: 999px;
    background: #fff;
    box-shadow: var(--shadow-sm);
    font-size: 14px;
    color: var(--ink-2);
  }
  .pill b {
    color: var(--ink);
    direction: ltr;
    unicode-bidi: isolate;
  }
  .hero h1 {
    margin: 0;
  }
  .hero .lead {
    margin: 0 auto;
  }
  .search {
    width: 100%;
    max-width: 1000px;
    margin-top: 8px;
  }
  .trust {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 28px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .trust b {
    color: var(--ink);
    font-weight: 800;
  }
  .float {
    position: absolute;
    z-index: 1;
    border-radius: 22px;
    overflow: visible;
    box-shadow: var(--shadow);
    animation: bob 7s ease-in-out infinite alternate;
  }
  .float :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 22px;
    border: 5px solid #fff;
  }
  .f1 {
    width: 230px;
    height: 290px;
    top: 70px;
    inset-inline-start: -40px;
    transform: rotate(6deg);
  }
  .f2 {
    width: 200px;
    height: 240px;
    top: 90px;
    inset-inline-end: -30px;
    transform: rotate(-7deg);
    animation-delay: -2s;
  }
  .f3 {
    width: 170px;
    height: 200px;
    bottom: 40px;
    inset-inline-end: 70px;
    transform: rotate(5deg);
    animation-delay: -4s;
  }
  @keyframes bob {
    to {
      translate: 0 -12px;
    }
  }
  .sticker {
    position: absolute;
    padding: 7px 12px;
    border-radius: 999px;
    background: #fff;
    box-shadow: var(--shadow);
    font-size: 14px;
    font-weight: 800;
    white-space: nowrap;
  }
  .s-a {
    bottom: -14px;
    inset-inline-end: -20px;
    background: var(--fire-grad);
    color: #fff;
  }
  .s-b {
    bottom: 20px;
    inset-inline-start: -30px;
  }
  .s-c {
    top: -14px;
    inset-inline-start: -16px;
    color: var(--good);
  }
  @media (max-width: 1700px) {
    .f3 {
      display: none;
    }
  }
  @media (max-width: 1100px) {
    .float {
      display: none;
    }
  }

  .stories-wrap {
    margin-top: 28px;
  }

  .row-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 20px 40px;
    margin-bottom: 32px;
  }
  .row-head .lead {
    margin: 0;
    max-width: 44ch;
  }
  .row-head .h2 {
    margin: 0;
  }
  .sub {
    margin: 6px 0 0;
    color: var(--ink-2);
  }

  .deals[hidden] {
    display: none;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tabs button {
    padding: 9px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .demo {
    padding: 10px 14px;
    border-radius: 12px;
    background: #fff4d6;
    font-weight: 600;
    font-size: 14px;
  }
  .demo[hidden] {
    display: none;
  }
  .deal-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .more {
    display: flex;
    width: max-content;
    margin: 28px auto 0;
  }

  .how-sec {
    background: var(--soft);
  }
  .how {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 32px;
  }
  .step {
    padding: 30px;
    border-radius: var(--r-lg);
    background: var(--c);
  }
  .ico {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background: #fff;
    font-size: 30px;
    margin-bottom: 22px;
    box-shadow: var(--shadow-sm);
  }
  .step h3 {
    font-size: 22px;
  }
  .step p {
    margin: 0;
    color: var(--ink-2);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, minmax(220px, 1fr));
    gap: 16px;
  }
  .bento :global(.dc) {
    aspect-ratio: auto;
  }
  .bento :global(.big) {
    grid-column: span 2;
    grid-row: span 2;
  }
  .grid4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .partners-sec {
    background: var(--soft);
  }
  .pgrid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }
  .pc {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: var(--r-lg);
    background: #fff;
    border-top: 5px solid var(--a);
  }
  .pc h3 {
    font-size: 21px;
    text-align: right;
  }
  .pc p {
    font-size: 15px;
    color: var(--ink-2);
  }
  .tip {
    margin: auto 0 0;
    padding: 12px;
    border-radius: 12px;
    background: var(--soft);
    font-size: 14px !important;
  }

  .faq-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: start;
  }
  .mail {
    color: var(--fire-dark);
    font-weight: 700;
  }
  .seo {
    padding-top: 0;
  }

  @media (max-width: 1100px) {
    .deal-grid,
    .grid4 {
      grid-template-columns: repeat(2, 1fr);
    }
    .pgrid {
      grid-template-columns: repeat(3, 1fr);
    }
    .faq-wrap {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 760px) {
    .how {
      grid-template-columns: 1fr;
    }
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
    }
    .bento :global(.dc) {
      aspect-ratio: 4 / 5;
    }
    .bento :global(.big) {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 16 / 11;
    }
    .pgrid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .deal-grid,
    .grid4 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { hotelCard, skeleton } from '../lib/hotelcard';
  import type { Hotel } from '../lib/agoda';

  // Next Thursday → Saturday: the classic Israeli weekend getaway.
  const iso = (d: Date) => d.toISOString().slice(0, 10);
  const now = new Date();
  const thu = new Date(now);
  thu.setDate(now.getDate() + (((4 - now.getDay() + 7) % 7) || 7));
  const sat = new Date(thu);
  sat.setDate(thu.getDate() + 2);
  const checkin = iso(thu);
  const checkout = iso(sat);
  const fmt = (d: Date) => new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long' }).format(d);

  const section = document.getElementById('deals')!;
  const grid = document.getElementById('deal-grid')!;
  const all = document.getElementById('deals-all') as HTMLAnchorElement;
  const tabs = [...section.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const cache = new Map<string, { mode: string; hotels: Hotel[] }>();

  async function fetchDeals(slug: string) {
    if (!cache.has(slug)) {
      const qs = new URLSearchParams({ slug, in: checkin, out: checkout, a: '2', c: '0', sort: 'PriceAsc', score: '7' });
      const res = await fetch(`/api/search?${qs}`);
      cache.set(slug, await res.json());
    }
    return cache.get(slug)!;
  }

  async function show(tab: HTMLButtonElement) {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    const slug = tab.dataset.slug!;
    const he = tab.dataset.he!;
    grid.innerHTML = skeleton(4, 'tile');
    const data = await fetchDeals(slug).catch(() => null);
    if (!data || (data.mode !== 'live' && data.mode !== 'demo') || !data.hotels.length) {
      grid.innerHTML = `<p>אין כרגע דילים להצגה ב${he}. <a href="/destinations/${slug}/">לכל המלונות ב${he}</a></p>`;
      return;
    }
    document.getElementById('deals-demo')!.hidden = data.mode !== 'demo';
    const q = { q: he, checkin, checkout, adults: 2, children: 0, rooms: 1, source: 'deals', city: he };
    grid.innerHTML = data.hotels.slice(0, 4).map((h) => hotelCard(h, q, 2, 'tile')).join('');
    all.href = `/search/?${new URLSearchParams({ d: he, slug, in: checkin, out: checkout, a: '2', c: '0', r: '1' })}`;
  }

  // Only reveal the section when live prices are actually available.
  fetchDeals(tabs[0].dataset.slug!)
    .then((d) => {
      if (d.mode !== 'live' && d.mode !== 'demo') return;
      document.getElementById('deals-when')!.textContent = `${fmt(thu)} – ${fmt(sat)} · 2 מבוגרים · ציון 7+ · מהזול ליקר`;
      section.hidden = false;
      tabs.forEach((t) => t.addEventListener('click', () => show(t)));
      show(tabs[0]);
    })
    .catch(() => {});
</script>
