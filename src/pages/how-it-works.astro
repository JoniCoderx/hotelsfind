---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import PageHero from '../components/PageHero.astro';
import { hotel } from '../data/photos';
import { href } from '../lib/url';
import { priceMode } from '../lib/mode';

const live = priceMode() === 'live';

const reasons = [
  {
    t: 'כל אתר מקבל מהמלון עסקה אחרת',
    d: 'המלון מוכר את אותו חדר דרך הרבה אתרים, ועם כל אחד מהם יש לו חוזה ועמלה משלו. יש אתרים שמוותרים על חלק מהעמלה כדי להוריד את המחיר, ויש כאלה שלא.',
  },
  {
    t: 'מבצעים והנחות פתע',
    d: 'דילים של רגע אחרון, מחירים שמוצגים רק באפליקציה, מבצעי סוף שבוע. כל אתר מפעיל אותם בזמנים אחרים, ולכן הזול של אתמול הוא לא בהכרח הזול של היום.',
  },
  {
    t: 'מועדוני חברים',
    d: 'Booking Genius, One Key של Hotels.com ו-Agoda VIP נותנים מחירי חברים שזולים לפעמים ב-10% ויותר. ההנחה תלויה באתר שבו יש לכם חשבון.',
  },
  {
    t: 'מטבע, מיסים ודמי שירות',
    d: 'אתר אחד מציג מחיר בדולרים לפני מיסים, ואחר בשקלים כולל הכל. בכרטיס אשראי ישראלי גם עמלת המרה מוסיפה. המחיר שנראה זול בהתחלה הוא לא תמיד הזול בסוף.',
  },
  {
    t: 'מלאי חדרים',
    d: 'כל אתר מקבל מכסה משלו. סוג חדר שאזל באתר אחד יכול להיות זמין ובמחיר טוב יותר באתר אחר.',
  },
];

const faq = [
  {
    q: 'האם השוואת מחירים באמת חוסכת כסף?',
    a: 'לעיתים קרובות. אותו חדר לאותם תאריכים יכול להופיע במחירים שונים באתרים שונים, במיוחד בחו"ל ובעונות עמוסות. אין הבטחה שתמיד יהיה הפרש, אבל בדיקה של עוד אתר או שניים לוקחת דקה.',
  },
  {
    q: 'למה שאזמין דרך מלונזול ולא ישר באתר?',
    a: `אתם כן מזמינים ישר באתר. מלונזול ${live ? 'מציג מחירים מ-Agoda ופותח בלחיצה את אותו יעד ותאריכים באתרים האחרים' : 'מציג מחירים מכמה אתרי הזמנות ופותח בלחיצה את אותו יעד ותאריכים באתרים עצמם'}, כדי שלא תצטרכו להקליד הכל מחדש. ההזמנה, התשלום והשירות הם של אתר ההזמנות.`,
  },
  {
    q: 'איך אתם מרוויחים אם זה בחינם?',
    a: 'כשמזמינים דרך קישור שלנו, אתר ההזמנות עשוי לשלם לנו עמלת שותפים. מלונזול לא גובה מכם תשלום על השימוש או על ההפניה. המחיר שאתם משלמים נקבע באתר ההזמנות.',
  },
  {
    q: live ? 'המחירים אצלכם סופיים?' : 'אתם מציגים מחירים?',
    a: live
      ? 'לא. המחירים שאנחנו מציגים מגיעים מ-Agoda בזמן החיפוש, ללילה ולפני מיסים ודמי שירות. הם יכולים להשתנות עד רגע ההזמנה. המחיר הקובע הוא המחיר הסופי שמופיע באתר ההזמנות לפני התשלום.'
      : 'כן. אחרי החיפוש מוצגים מלונות עם המחיר האחרון שנמצא ללילה בכל אתר הזמנות, למשל Booking, Agoda ו-Trip.com, לתאריכים שבחרתם, וההצעה הזולה מסומנת. זו לא בדיקת זמינות: חדרים נגמרים ומחירים מתעדכנים, והמחיר הקובע הוא זה שמופיע באתר ההזמנות לפני התשלום.',
  },
  {
    q: 'האם אתם סוכנות נסיעות?',
    a: 'לא. אנחנו לא מוכרים חדרים, לא גובים תשלום ולא שומרים פרטי אשראי. אנחנו אתר חיפוש שמפנה לאתרי ההזמנות.',
  },
];

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
import LiveDemo from '../components/LiveDemo.astro';
---
<Base
  overlay
  title="איך משווים מחירי מלונות? | מלונזול"
  description={`למה אותו חדר עולה מחיר אחר בכל אתר הזמנות, מה מלונזול עושה: ${live ? 'מחירים מ-Agoda וקישור מהיר לאותו חיפוש ב-Booking, Expedia ועוד' : 'מחירים מכמה אתרי הזמנות וקישור מהיר לאותו חיפוש ב-Booking, Agoda, Expedia ועוד'}, ולמה זה לא עולה לכם שקל.`}
  jsonLd={ld}
>
  <PageHero
    photo={hotel.room}
    crumbs={[{ label: 'ראשי', to: '/' }, { label: 'איך זה עובד' }]}
    eyebrow="המדריך המלא · 2 דקות קריאה"
    title="איך משווים"
    accent="מחירי מלונות?"
    lead="למה אותו חדר עולה מחיר אחר בכל אתר, מה מלונזול עושה ומה לא, ולמה זה לא עולה לכם שקל."
  />

  <!-- 1. The problem -->
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="label">הבעיה</p>
        <h2 class="h2">אותו חדר. חמישה מחירים.</h2>
        <p>
          מלון באילת לא מוכר את החדרים שלו רק באתר שלו. הוא מוכר אותם במקביל דרך Booking, Agoda, Expedia, Hotels.com, Trip.com
          ועוד. כל אחד מהאתרים האלה קובע את המחיר שלו.
        </p>
        <p>
          התוצאה: <b>אותו חדר, באותו מלון, לאותם תאריכים, מופיע במחירים שונים בכל אתר.</b> רוב האנשים בודקים אתר אחד, מזמינים,
          ולא יודעים שבאתר אחר אותו לילה היה זול יותר.
        </p>
      </div>
      <LiveDemo />
    </div>
  </section>

  <!-- 2. Why prices differ -->
  <section class="section soft">
    <div class="wrap">
      <p class="label">ההסבר</p>
      <h2 class="h2">למה בכלל יש הבדלים במחיר?</h2>
      <div class="reasons">
        {reasons.map((r, i) => (
          <article class="reveal">
            <span class="n">{i + 1}</span>
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. How MalonZol works -->
  <section class="section">
    <div class="wrap narrow">
      <p class="label">הפתרון</p>
      <h2 class="h2">ככה מלונזול עובד</h2>
      <ol class="flow">
        <li>
          <h3>אתם מחפשים פעם אחת</h3>
          <p>יעד, תאריכים ומספר אורחים. בעברית, מכל מכשיר, בלי הרשמה.</p>
        </li>
        {live ? (
          <>
            <li>
              <h3>אנחנו מביאים מחירים מ-Agoda</h3>
              <p>
                לתאריכים ולאורחים שבחרתם אנחנו מושכים מחירים חיים מ-Agoda. את שאר האתרים אנחנו לא בודקים בשבילכם: אנחנו
                מכינים קישור שפותח שם את אותו יעד ותאריכים, כדי שלא תקלידו הכל מחדש.
              </p>
            </li>
            <li>
              <h3>אתם בודקים ומשווים</h3>
              <p>מלונות מ-Agoda עם מחיר ללילה, ציוני אורחים והנחות. ממיינים, מסננים, ובלחיצה בודקים את המחיר גם ב-Booking ובשאר האתרים.</p>
            </li>
          </>
        ) : (
          <li>
            <h3>אתם משווים מחירים</h3>
            <p>
              אחרי החיפוש מוצגים מלונות עם המחיר ללילה בכל אתר הזמנות, וההצעה הזולה מסומנת. רוצים לבדוק באתר מסוים? קישור
              אחד פותח את אותו יעד ותאריכים ב-Booking, Agoda, Expedia ובשאר האתרים, כדי שלא תקלידו הכל מחדש.
            </p>
          </li>
        )}
        <li>
          <h3>מזמינים ישירות באתר שבחרתם</h3>
          <p>
            לחיצה מעבירה אתכם לאתר ההזמנות עם היעד והתאריכים. ודאו שם את החדר, מספר האורחים והמחיר הסופי. התשלום, האישור ושירות הלקוחות הם של האתר, כך שאתם
            מוגנים כמו בכל הזמנה רגילה.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 4. Free -->
  <section class="section soft">
    <div class="wrap split">
      <div>
        <p class="label">כמה זה עולה?</p>
        <h2 class="h2">אפס שקלים.</h2>
        <p>
          כשאתם מזמינים דרך קישור של מלונזול, ייתכן שאתר ההזמנות ישלם לנו עמלת שותפים. זה מודל מקובל באתרי תוכן והשוואה.
        </p>
        <p><b>אנחנו לא מוסיפים סכום משלנו.</b> המחיר נקבע באתר ההזמנות.</p>
        <a class="link" href={href('/disclosure/')}>לגילוי הנאות המלא <span class="arrow">←</span></a>
      </div>
      <div class="not">
        <h3>מה אנחנו לא</h3>
        <ul>
          <li>לא סוכנות נסיעות</li>
          <li>לא מוכרים חדרים ולא גובים תשלום</li>
          <li>לא שומרים פרטי אשראי</li>
          <li>לא מוסיפים עמלה למחיר</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. Tips -->
  <section class="section">
    <div class="wrap narrow">
      <p class="label">טיפים של מקצוענים</p>
      <h2 class="h2">איך להוציא מההשוואה את המקסימום</h2>
      <ul class="tips">
        <li><b>השוו את המחיר הסופי.</b> לפני התשלום בדקו את המחיר כולל מיסים ודמי שירות. רק הוא קובע.</li>
        <li><b>השוו תפוחים לתפוחים.</b> ודאו שבשני האתרים מדובר באותו סוג חדר, עם אותה ארוחת בוקר ואותם תנאי ביטול.</li>
        <li><b>הזמינו עם ביטול חינם, ובדקו שוב.</b> אם המחיר ירד שבוע לפני הנסיעה, מבטלים ומזמינים מחדש.</li>
        <li><b>התחברו למועדוני החברים.</b> החשבון בחינם, ומחירי חברים יכולים לחסוך עוד כמה אחוזים.</li>
        <li><b>גמישות משתלמת.</b> אמצע שבוע לרוב זול יותר מסוף שבוע, גם בארץ וגם בחו"ל.</li>
      </ul>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap faq-wrap">
      <div>
        <p class="label">שאלות נפוצות</p>
        <h2 class="h2">עוד שאלות על ההשוואה</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <section class="section">
    <div class="wrap cta">
      <h2 class="h2">{live ? "מוכנים לראות כמה אפשר לחסוך?" : "מוכנים לבדוק את המלון שלכם בכמה אתרים?"}</h2>
      <a class="btn btn-fire" href={href('/#search')}>{live ? 'להשוואת מחירים' : 'לחיפוש בכמה אתרים'} <span class="arrow">←</span></a>
    </div>
  </section>
</Base>

<style>
  .narrow > * {
    max-width: 780px;
  }
  .soft {
    background: var(--soft);
  }
  .split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .split p {
    color: var(--ink-2);
  }
  .split b {
    color: var(--ink);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
  }
  figcaption span {
    font-size: 13px;
    color: var(--muted);
  }
  .gap {
    margin: 14px 0 0;
    font-size: 15px;
    color: var(--ink-2);
  }
  .reasons {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-top: 28px;
  }
  .reasons article {
    padding: 24px;
    border-radius: 20px;
    background: #fff;
    border: 1px solid var(--line);
  }
  .reasons .n {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--warm);
    color: var(--fire);
    font-weight: 700;
    margin-bottom: 14px;
  }
  .reasons h3 {
    font-size: 19px;
  }
  .reasons p {
    margin: 0;
    color: var(--ink-2);
    font-size: 16px;
  }
  .flow {
    list-style: none;
    counter-reset: f;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .flow li {
    counter-increment: f;
    position: relative;
    padding: 0 0 26px 0;
    padding-inline-start: 56px;
  }
  .flow li::before {
    content: counter(f);
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--fire);
    color: #fff;
    font-weight: 700;
  }
  .flow li:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-inline-start: 18px;
    top: 42px;
    bottom: 4px;
    width: 2px;
    background: var(--line);
  }
  .flow h3 {
    font-size: 20px;
    margin-bottom: 4px;
  }
  .flow p {
    margin: 0;
    color: var(--ink-2);
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 600;
    color: var(--fire);
  }
  .not {
    padding: 26px;
    border-radius: 24px;
    background: #fff;
    border: 1px solid var(--line);
  }
  .not h3 {
    font-size: 20px;
  }
  .not ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .not li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
  }
  .not li::before {
    content: '';
    width: 20px;
    height: 20px;
    flex: none;
    border-radius: 50%;
    background: #fdecef
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path d='M7 7l6 6M13 7l-6 6' stroke='%23e0445f' stroke-width='1.8' stroke-linecap='round'/></svg>")
      center / 20px no-repeat;
  }
  .tips {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .tips li {
    position: relative;
    padding-inline-start: 30px;
    color: var(--ink-2);
  }
  .tips li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 5px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--good-soft)
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='M4.5 8.3l2.3 2.3 4.7-4.9' fill='none' stroke='%230f9d6b' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>")
      center / 16px no-repeat;
  }
  .tips b {
    color: var(--ink);
  }
  .faq-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: start;
  }
  .cta {
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }
  @media (max-width: 1100px) {
    .reasons {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }
  @media (max-width: 900px) {
    .split,
    .faq-wrap {
      grid-template-columns: 1fr;
    }
  }
</style>
